// Distribuições de probabilidade, testes estatísticos e funções erro (motor custom.excel.calc)
// Rotinas numéricas: log-gama (Lanczos), gama e beta incompletas (série/fração continuada de Lentz),
// inversa da normal (AS241 refinada por Newton) e inversão genérica pelo método de Brent
#include "tlpp-core.th"
#include "totvs.ch"

Namespace custom.excel.calc

#define XPI			3.14159265358979323846
#define XEPS		0.000000000000001

/*/{Protheus.doc} FuncDist
Registro das distribuições de probabilidade e testes estatísticos
@type class
@author Saulo Gomes Martins
@since 25/10/2026
/*/
Class FuncDist
	Public Method New()			As Object
	Public Method Registrar()
EndClass

Method New() As Object Class FuncDist
Return self

Method Registrar(oM As Object) Class FuncDist
	//Normal
	oM:Registrar("NORM.DIST"			,{|o,a| fNormDist(o,a,.F.) }			,4,4,"E")
	oM:Registrar("NORMDIST"				,{|o,a| fNormDist(o,a,.F.) }			,4,4,"E")
	oM:Registrar("NORM.S.DIST"			,{|o,a| fNormDist(o,a,.T.) }			,2,2,"E")
	oM:Registrar("NORMSDIST"			,{|o,a| fNormSDist1(o,a) }				,1,1,"E")
	oM:Registrar("NORM.INV"				,{|o,a| fNormInv(o,a,.F.) }				,3,3,"E")
	oM:Registrar("NORMINV"				,{|o,a| fNormInv(o,a,.F.) }				,3,3,"E")
	oM:Registrar("NORM.S.INV"			,{|o,a| fNormInv(o,a,.T.) }				,1,1,"E")
	oM:Registrar("NORMSINV"				,{|o,a| fNormInv(o,a,.T.) }				,1,1,"E")
	oM:Registrar("PHI"					,{|o,a| N1(o,a,{|x| Exp(-x*x/2)/Sqrt(2*XPI) }) }	,1,1,"E")
	oM:Registrar("GAUSS"				,{|o,a| N1(o,a,{|x| NormCdf(x)-0.5 }) }	,1,1,"E")
	oM:Registrar("STANDARDIZE"			,{|o,a| fStandardize(o,a) }				,3,3,"E")
	oM:Registrar("CONFIDENCE.NORM"		,{|o,a| fConfidence(o,a,.F.) }			,3,3,"E")
	oM:Registrar("CONFIDENCE"			,{|o,a| fConfidence(o,a,.F.) }			,3,3,"E")
	oM:Registrar("CONFIDENCE.T"			,{|o,a| fConfidence(o,a,.T.) }			,3,3,"E")
	oM:Registrar("LOGNORM.DIST"			,{|o,a| fLogNormDist(o,a) }				,4,4,"E")
	oM:Registrar("LOGNORMDIST"			,{|o,a| fLogNormDist(o,a) }				,3,3,"E")
	oM:Registrar("LOGNORM.INV"			,{|o,a| fLogNormInv(o,a) }				,3,3,"E")
