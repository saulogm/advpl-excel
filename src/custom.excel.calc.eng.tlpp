//Prefixos {símbolo,fator}
Static Function Prefixos(lBinario As Logical)
	If lBinario
		Return {{"yi",2^80},{"zi",2^70},{"ei",2^60},{"pi",2^50},{"ti",2^40},{"gi",2^30},{"mi",2^20},{"ki",2^10}}
	EndIf
Return {{"Y",10^24},{"Z",10^21},{"E",10^18},{"P",10^15},{"T",10^12},{"G",10^9},{"M",10^6},{"k",1000},{"h",100},{"da",10},{"e",10},{"d",0.1},{"c",0.01},{"m",0.001},{"u",0.000001},{"n",0.000000001},{"p",0.000000000001},{"f",0.000000000000001},{"a",10^(-18)},{"z",10^(-21)},{"y",10^(-24)}}

/*/{Protheus.doc} AchaUnidade
Localiza a unidade (com prefixo opcional): {categoria,fator,cBase} ou nil
/*/
Static Function AchaUnidade(cUni As Character)
	Local aUni := Unidades() As Array
	Local nPos As Numeric
	Local aPre As Array
	Local nCont As Numeric
	Local cResto As Character
	Local aRet As Variant
	nPos	:= aScan(aUni,{|x| x[1]==cUni })
	If nPos>0
		aRet	:= {aUni[nPos][2],aUni[nPos][3],aUni[nPos][1]}
		FwFreeArray(aUni)
		Return aRet
	EndIf
	aPre	:= Prefixos(.T.)	//Prefixos binários (ki, Mi...) para bit e byte
	For nCont:=1 to Len(aPre)
		If Left(cUni,2)==Left(aPre[nCont][1],1)+"i" .AND. Lower(Left(cUni,1))==Left(aPre[nCont][1],1)
			cResto	:= SubStr(cUni,3)
			nPos	:= aScan(aUni,{|x| x[1]==cResto .AND. "B" $ x[4] })
			If nPos>0
				aRet	:= {aUni[nPos][2],aUni[nPos][3]*aPre[nCont][2],aUni[nPos][1]}
				FwFreeArray(aUni)
				Return aRet
			EndIf
		EndIf
	Next
	aPre	:= Prefixos(.F.)
	For nCont:=1 to Len(aPre)
		If Left(cUni,Len(aPre[nCont][1]))==aPre[nCont][1]
			cResto	:= SubStr(cUni,Len(aPre[nCont][1])+1)
			nPos	:= aScan(aUni,{|x| x[1]==cResto .AND. "P" $ x[4] })
			If nPos>0
				//Unidades de área/volume com prefixo: o prefixo também é elevado (km2 = 1000^2 m2)
				aRet	:= {aUni[nPos][2],aUni[nPos][3]*(aPre[nCont][2]^Potencia(cResto)),aUni[nPos][1]}
				FwFreeArray(aUni)
				Return aRet
			EndIf
		EndIf
	Next
	FwFreeArray(aUni)
Return nil

//Expoente da unidade (m2 / m^2 = 2, m3 = 3)
Static Function Potencia(cUni As Character)
	If Right(cUni,1)=="2"
		Return 2
	ElseIf Right(cUni,1)=="3"
		Return 3
	EndIf
Return 1

//Temperatura para Kelvin e de Kelvin
Static Function ParaKelvin(cUni As Character, nVal As Numeric)
	Do Case
		Case cUni $ "C|cel"
			Return nVal+273.15
		Case cUni $ "F|fah"
			Return (nVal-32)*5/9+273.15
		Case cUni=="Rank"
			Return nVal*5/9
		Case cUni=="Reau"
			Return nVal*1.25+273.15
	EndCase
Return nVal

Static Function DeKelvin(cUni As Character, nVal As Numeric)
	Do Case
		Case cUni $ "C|cel"
			Return nVal-273.15
		Case cUni $ "F|fah"
			Return (nVal-273.15)*9/5+32
		Case cUni=="Rank"
			Return nVal*9/5
		Case cUni=="Reau"
			Return (nVal-273.15)*0.8
	EndCase
Return nVal

Static Function fConvert(oM As Object, aArgs As Array)
	Local nVal := oM:Num(aArgs[1]) As Variant
	Local cDe := oM:Txt(aArgs[2]) As Variant
	Local cPara := oM:Txt(aArgs[3]) As Variant
	Local aDe As Variant
	Local aPara As Variant
	If PrimErro(oM,{nVal,cDe,cPara})!=nil
		Return PrimErro(oM,{nVal,cDe,cPara})
	EndIf
	aDe		:= AchaUnidade(cDe)
	aPara	:= AchaUnidade(cPara)
	If aDe==nil .OR. aPara==nil .OR. aDe[1]!=aPara[1]
		Return oM:Err("#N/A")
	EndIf
	If aDe[1]=="temperatura"
		Return DeKelvin(aPara[3],ParaKelvin(aDe[3],nVal))
	EndIf
Return nVal*aDe[2]/aPara[2]

/* =====================================================================================
   Números complexos (texto "a+bi" ou "a+bj")
   ===================================================================================== */

/*/{Protheus.doc} CxLe
Lê o número complexo: {nReal,nImag,cSufixo} ou Erro
/*/
Static Function CxLe(oM As Object, xVal As Variant)
	Local cTxt As Variant
	Local cSuf := "i" As Character
	Local nPos As Numeric
	Local nCont As Numeric
	Local cCar As Character
	Local cReal As Character
	Local cImag As Character
	Local nR As Variant
	Local nI As Variant
	xVal	:= oM:Esc(xVal)
	If ValType(xVal)=="N"
		Return {xVal,0,"i"}
	EndIf
	If ValType(xVal)=="L" .OR. oM:EhErro(xVal)
		Return If(oM:EhErro(xVal),xVal,oM:Err("#VALUE!"))
	EndIf
	cTxt	:= AllTrim(oM:Txt(xVal))
	If Empty(cTxt)
		Return {0,0,"i"}
	EndIf
	If Right(cTxt,1)=="i" .OR. Right(cTxt,1)=="j"
		cSuf	:= Right(cTxt,1)
		cTxt	:= Left(cTxt,Len(cTxt)-1)
		//Separa a parte real: último + ou - que não é expoente nem o primeiro caractere
		nPos	:= 0
		For nCont:=Len(cTxt) to 2 Step -1
			cCar	:= SubStr(cTxt,nCont,1)
			If (cCar=="+" .OR. cCar=="-") .AND. Upper(SubStr(cTxt,nCont-1,1))!="E"
				nPos	:= nCont
				Exit
			EndIf
		Next
		cReal	:= If(nPos>0,Left(cTxt,nPos-1),"0")
		cImag	:= If(nPos>0,SubStr(cTxt,nPos),cTxt)
		If cImag=="" .OR. cImag=="+"
			cImag	:= "1"
		ElseIf cImag=="-"
			cImag	:= "-1"
		EndIf
		nR	:= oM:TxtNum(cReal)
		nI	:= oM:TxtNum(cImag)
	Else
		nR	:= oM:TxtNum(cTxt)
		nI	:= 0
	EndIf
	If nR==nil .OR. nI==nil
		Return oM:Err("#NUM!")
	EndIf
Return {nR,nI,cSuf}

//Formata o complexo como o Excel ("3+4i", "i", "-2i", "5")
Static Function CxTxt(oM As Object, nR As Numeric, nI As Numeric, cSuf As Character)
	Local cRet := "" As Character
	nR	:= Round(nR,14)
	nI	:= Round(nI,14)
	If nI==0
		Return oM:NumTxt(nR)
	EndIf
	If nR!=0
		cRet	:= oM:NumTxt(nR)
	EndIf
	If nI==1
		cRet	+= If(nR!=0,"+","")+cSuf
	ElseIf nI==-1
		cRet	+= "-"+cSuf
	Else
		cRet	+= If(nI>0 .AND. nR!=0,"+","")+oM:NumTxt(nI)+cSuf
	EndIf
Return cRet

Static Function fComplex(oM As Object, aArgs As Array)
	Local nR := oM:Num(aArgs[1]) As Variant
	Local nI := oM:Num(aArgs[2]) As Variant
	Local cSuf := If(Len(aArgs)>=3 .AND. ValType(aArgs[3])!="U",oM:Txt(aArgs[3]),"i") As Variant
	If PrimErro(oM,{nR,nI,cSuf})!=nil
		Return PrimErro(oM,{nR,nI,cSuf})
	EndIf
	If Empty(cSuf)
		cSuf	:= "i"
	EndIf
	If !(cSuf=="i" .OR. cSuf=="j")
		Return oM:Err("#VALUE!")
	EndIf
Return CxTxt(oM,nR,nI,cSuf)

//Operações de um argumento
Static Function Cx1(oM As Object, aArgs As Array, cOp As Character)
	Local aZ := CxLe(oM,aArgs[1]) As Variant
	Local nR As Numeric
	Local nI As Numeric
	Local nMod As Numeric
	Local nArg As Numeric
	Local aW As Array
	If oM:EhErro(aZ)
		Return aZ
	EndIf
	nR		:= aZ[1]
	nI		:= aZ[2]
	nMod	:= Sqrt(nR*nR+nI*nI)
	nArg	:= Atan2(nI,nR)
	Do Case
		Case cOp=="REAL"
			Return nR
		Case cOp=="IMAG"
			Return nI
		Case cOp=="ABS"
			Return nMod
		Case cOp=="ARG"
			If nR==0 .AND. nI==0
				Return oM:Err("#DIV/0!")
			EndIf
			Return nArg
		Case cOp=="CONJ"
			Return CxTxt(oM,nR,-nI,aZ[3])
		Case cOp=="EXP"
			Return CxTxt(oM,Exp(nR)*Cos(nI),Exp(nR)*Sin(nI),aZ[3])
		Case cOp=="LN" .OR. cOp=="LOG10" .OR. cOp=="LOG2"
			If nMod==0
				Return oM:Err("#NUM!")
			EndIf
			aW	:= {Log(nMod),nArg}
			If cOp=="LOG10"
				aW	:= {aW[1]/Log(10),aW[2]/Log(10)}
			ElseIf cOp=="LOG2"
				aW	:= {aW[1]/Log(2),aW[2]/Log(2)}
			EndIf
			Return CxTxt(oM,aW[1],aW[2],aZ[3])
		Case cOp=="SQRT"
			Return CxTxt(oM,Sqrt(nMod)*Cos(nArg/2),Sqrt(nMod)*Sin(nArg/2),aZ[3])
		Case cOp=="SIN"
			Return CxTxt(oM,Sin(nR)*CosH(nI),Cos(nR)*SinH(nI),aZ[3])
		Case cOp=="COS"
			Return CxTxt(oM,Cos(nR)*CosH(nI),-Sin(nR)*SinH(nI),aZ[3])
		Case cOp=="SINH"
			Return CxTxt(oM,SinH(nR)*Cos(nI),CosH(nR)*Sin(nI),aZ[3])
		Case cOp=="COSH"
			Return CxTxt(oM,CosH(nR)*Cos(nI),SinH(nR)*Sin(nI),aZ[3])
	EndCase
	//Funções derivadas por divisão: tan=sin/cos, cot=cos/sin, sec=1/cos, csc=1/sin, sech=1/cosh, csch=1/sinh
	Do Case
		Case cOp=="TAN"
			aW	:= CxDiv({Sin(nR)*CosH(nI),Cos(nR)*SinH(nI)},{Cos(nR)*CosH(nI),-Sin(nR)*SinH(nI)})
		Case cOp=="COT"
			aW	:= CxDiv({Cos(nR)*CosH(nI),-Sin(nR)*SinH(nI)},{Sin(nR)*CosH(nI),Cos(nR)*SinH(nI)})
		Case cOp=="SEC"
			aW	:= CxDiv({1,0},{Cos(nR)*CosH(nI),-Sin(nR)*SinH(nI)})
		Case cOp=="CSC"
			aW	:= CxDiv({1,0},{Sin(nR)*CosH(nI),Cos(nR)*SinH(nI)})
		Case cOp=="SECH"
			aW	:= CxDiv({1,0},{CosH(nR)*Cos(nI),SinH(nR)*Sin(nI)})
		Otherwise	//CSCH
			aW	:= CxDiv({1,0},{SinH(nR)*Cos(nI),CosH(nR)*Sin(nI)})
	EndCase
	If aW==nil
		Return oM:Err("#NUM!")
	EndIf
Return CxTxt(oM,aW[1],aW[2],aZ[3])

Static Function SinH(nX As Numeric)
Return (Exp(nX)-Exp(-nX))/2

Static Function CosH(nX As Numeric)
Return (Exp(nX)+Exp(-nX))/2

Static Function Atan2(nY As Numeric, nX As Numeric)
	If nX>0
		Return ATan(nY/nX)
	ElseIf nX<0
		Return ATan(nY/nX)+If(nY>=0,XPI,-XPI)
	EndIf
	If nY>0
		Return XPI/2
	ElseIf nY<0
		Return -XPI/2
	EndIf
Return 0

Static Function CxDiv(aA As Array, aB As Array)
	Local nDen := aB[1]*aB[1]+aB[2]*aB[2] As Numeric
	If nDen==0
		Return nil
	EndIf
Return {(aA[1]*aB[1]+aA[2]*aB[2])/nDen,(aA[2]*aB[1]-aA[1]*aB[2])/nDen}

Static Function fImPower(oM As Object, aArgs As Array)
	Local aZ := CxLe(oM,aArgs[1]) As Variant
	Local nP := oM:Num(aArgs[2]) As Variant
	Local nMod As Numeric
	Local nArg As Numeric
	If oM:EhErro(aZ)
		Return aZ
	EndIf
	If oM:EhErro(nP)
		Return nP
	EndIf
	nMod	:= Sqrt(aZ[1]*aZ[1]+aZ[2]*aZ[2])
	If nMod==0
		Return If(nP>0,"0",oM:Err("#NUM!"))
	EndIf
	nArg	:= Atan2(aZ[2],aZ[1])
Return CxTxt(oM,(nMod^nP)*Cos(nP*nArg),(nMod^nP)*Sin(nP*nArg),aZ[3])

Static Function fImDivSub(oM As Object, aArgs As Array, lDiv As Logical)
	Local aA := CxLe(oM,aArgs[1]) As Variant
	Local aB := CxLe(oM,aArgs[2]) As Variant
	Local aW As Variant
	If oM:EhErro(aA)
		Return aA
	EndIf
	If oM:EhErro(aB)
		Return aB
	EndIf
	If aA[2]!=0 .AND. aB[2]!=0 .AND. aA[3]!=aB[3]
		Return oM:Err("#VALUE!")
	EndIf
	If lDiv
		aW	:= CxDiv({aA[1],aA[2]},{aB[1],aB[2]})
		If aW==nil
			Return oM:Err("#NUM!")
		EndIf
		Return CxTxt(oM,aW[1],aW[2],If(aA[2]!=0,aA[3],aB[3]))
	EndIf
Return CxTxt(oM,aA[1]-aB[1],aA[2]-aB[2],If(aA[2]!=0,aA[3],aB[3]))

Static Function fImSumProd(oM As Object, aArgs As Array, lSoma As Logical)
	Local aVals := oM:Lista(aArgs) As Array
	Local nR := If(lSoma,0,1) As Numeric
	Local nI := 0 As Numeric
	Local cSuf := "" As Character
	Local nCont As Numeric
	Local aZ As Variant
	Local nTmp As Numeric
	For nCont:=1 to Len(aVals)
		aZ	:= CxLe(oM,aVals[nCont])
		If oM:EhErro(aZ)
			Return aZ
		EndIf
		If aZ[2]!=0
			If !Empty(cSuf) .AND. cSuf!=aZ[3]
				Return oM:Err("#VALUE!")
			EndIf
			cSuf	:= aZ[3]
		EndIf
		If lSoma
			nR	+= aZ[1]
			nI	+= aZ[2]
		Else
			nTmp	:= nR*aZ[1]-nI*aZ[2]
			nI		:= nR*aZ[2]+nI*aZ[1]
			nR		:= nTmp
		EndIf
	Next
	FwFreeArray(aVals)
Return CxTxt(oM,nR,nI,If(Empty(cSuf),"i",cSuf))

/*/{Protheus.doc} MenorIg
a <= b com precisão total: os operadores de comparação do AdvPL consideram iguais números com diferença
menor que ~1e-8; a diferença escalada (a-b)*1e8 recupera a precisão até ~1e-15
/*/
Static Function MenorIg(nA As Numeric, nB As Numeric)
Return (nA-nB)*100000000<=0

//Número igual a zero com precisão total
Static Function Zero(nA As Numeric)
Return nA*100000000==0
