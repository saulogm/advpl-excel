// Funções de engenharia do Excel (motor custom.excel.calc): bases numéricas, bits, números complexos,
// Bessel, CONVERT, DELTA e GESTEP
#include "tlpp-core.th"
#include "totvs.ch"

Namespace custom.excel.calc

#define XPI			3.14159265358979323846

/*/{Protheus.doc} FuncEng
Registro das funções de engenharia
@type class
@author Saulo Gomes Martins
@since 25/10/2026
/*/
Class FuncEng
	Public Method New()			As Object
	Public Method Registrar()
EndClass

Method New() As Object Class FuncEng
Return self

Method Registrar(oM As Object) Class FuncEng
	//Bases numéricas
	oM:Registrar("BIN2DEC"		,{|o,a| fBase2Dec(o,a,2) }			,1,1,"E")
	oM:Registrar("OCT2DEC"		,{|o,a| fBase2Dec(o,a,8) }			,1,1,"E")
	oM:Registrar("HEX2DEC"		,{|o,a| fBase2Dec(o,a,16) }			,1,1,"E")
	oM:Registrar("DEC2BIN"		,{|o,a| fDec2Base(o,a,2) }			,1,2,"E")
	oM:Registrar("DEC2OCT"		,{|o,a| fDec2Base(o,a,8) }			,1,2,"E")
	oM:Registrar("DEC2HEX"		,{|o,a| fDec2Base(o,a,16) }			,1,2,"E")
	oM:Registrar("BIN2OCT"		,{|o,a| fBase2Base(o,a,2,8) }		,1,2,"E")
	oM:Registrar("BIN2HEX"		,{|o,a| fBase2Base(o,a,2,16) }		,1,2,"E")
	oM:Registrar("OCT2BIN"		,{|o,a| fBase2Base(o,a,8,2) }		,1,2,"E")
	oM:Registrar("OCT2HEX"		,{|o,a| fBase2Base(o,a,8,16) }		,1,2,"E")
	oM:Registrar("HEX2BIN"		,{|o,a| fBase2Base(o,a,16,2) }		,1,2,"E")
	oM:Registrar("HEX2OCT"		,{|o,a| fBase2Base(o,a,16,8) }		,1,2,"E")
	//Bits
	oM:Registrar("BITAND"		,{|o,a| fBit(o,a,1) }				,2,2,"E")
	oM:Registrar("BITOR"		,{|o,a| fBit(o,a,2) }				,2,2,"E")
	oM:Registrar("BITXOR"		,{|o,a| fBit(o,a,3) }				,2,2,"E")
	oM:Registrar("BITLSHIFT"	,{|o,a| fBitShift(o,a,.T.) }		,2,2,"E")
	oM:Registrar("BITRSHIFT"	,{|o,a| fBitShift(o,a,.F.) }		,2,2,"E")
	//Comparação
	oM:Registrar("DELTA"		,{|o,a| fDelta(o,a,.T.) }			,1,2,"E")
	oM:Registrar("GESTEP"		,{|o,a| fDelta(o,a,.F.) }			,1,2,"E")
	//Bessel
	oM:Registrar("BESSELJ"		,{|o,a| fBessel(o,a,"J") }			,2,2,"E")
	oM:Registrar("BESSELY"		,{|o,a| fBessel(o,a,"Y") }			,2,2,"E")
	oM:Registrar("BESSELI"		,{|o,a| fBessel(o,a,"I") }			,2,2,"E")
	oM:Registrar("BESSELK"		,{|o,a| fBessel(o,a,"K") }			,2,2,"E")
	//Conversão de unidades
	oM:Registrar("CONVERT"		,{|o,a| fConvert(o,a) }				,3,3,"E")
	//Números complexos
	oM:Registrar("COMPLEX"		,{|o,a| fComplex(o,a) }				,2,3,"E")
	oM:Registrar("IMREAL"		,{|o,a| Cx1(o,a,"REAL") }			,1,1,"E")
	oM:Registrar("IMAGINARY"	,{|o,a| Cx1(o,a,"IMAG") }			,1,1,"E")
	oM:Registrar("IMABS"		,{|o,a| Cx1(o,a,"ABS") }			,1,1,"E")
	oM:Registrar("IMARGUMENT"	,{|o,a| Cx1(o,a,"ARG") }			,1,1,"E")
	oM:Registrar("IMCONJUGATE"	,{|o,a| Cx1(o,a,"CONJ") }			,1,1,"E")
	oM:Registrar("IMEXP"		,{|o,a| Cx1(o,a,"EXP") }			,1,1,"E")
	oM:Registrar("IMLN"			,{|o,a| Cx1(o,a,"LN") }				,1,1,"E")
	oM:Registrar("IMLOG10"		,{|o,a| Cx1(o,a,"LOG10") }			,1,1,"E")
	oM:Registrar("IMLOG2"		,{|o,a| Cx1(o,a,"LOG2") }			,1,1,"E")
	oM:Registrar("IMSQRT"		,{|o,a| Cx1(o,a,"SQRT") }			,1,1,"E")
	oM:Registrar("IMSIN"		,{|o,a| Cx1(o,a,"SIN") }			,1,1,"E")
	oM:Registrar("IMCOS"		,{|o,a| Cx1(o,a,"COS") }			,1,1,"E")
	oM:Registrar("IMTAN"		,{|o,a| Cx1(o,a,"TAN") }			,1,1,"E")
	oM:Registrar("IMCOT"		,{|o,a| Cx1(o,a,"COT") }			,1,1,"E")
	oM:Registrar("IMSEC"		,{|o,a| Cx1(o,a,"SEC") }			,1,1,"E")
	oM:Registrar("IMCSC"		,{|o,a| Cx1(o,a,"CSC") }			,1,1,"E")
	oM:Registrar("IMSINH"		,{|o,a| Cx1(o,a,"SINH") }			,1,1,"E")
	oM:Registrar("IMCOSH"		,{|o,a| Cx1(o,a,"COSH") }			,1,1,"E")
	oM:Registrar("IMSECH"		,{|o,a| Cx1(o,a,"SECH") }			,1,1,"E")
	oM:Registrar("IMCSCH"		,{|o,a| Cx1(o,a,"CSCH") }			,1,1,"E")
	oM:Registrar("IMPOWER"		,{|o,a| fImPower(o,a) }				,2,2,"E")
	oM:Registrar("IMDIV"		,{|o,a| fImDivSub(o,a,.T.) }		,2,2,"E")
	oM:Registrar("IMSUB"		,{|o,a| fImDivSub(o,a,.F.) }		,2,2,"E")
	oM:Registrar("IMSUM"		,{|o,a| fImSumProd(o,a,.T.) }		,1,255)
	oM:Registrar("IMPRODUCT"	,{|o,a| fImSumProd(o,a,.F.) }		,1,255)
Return

//Primeiro erro da lista (nil se nenhum)
Static Function PrimErro(oM As Object, aVals As Array)
	Local nCont As Numeric
	For nCont:=1 to Len(aVals)
		If oM:EhErro(aVals[nCont])
			Return aVals[nCont]
		EndIf
	Next
Return nil

/* =====================================================================================
   Bases numéricas (complemento de dois com 10 dígitos na base de origem)
   ===================================================================================== */

//Texto do número na base (sem sinal), dígitos maiúsculos
Static Function NumBase(nNum As Numeric, nBase As Numeric)
	Local cRet := "" As Character
	Local nDig As Numeric
	If nNum==0
		Return "0"
	EndIf
	While nNum>0
		nDig	:= nNum-nBase*Int(nNum/nBase)
		cRet	:= SubStr("0123456789ABCDEF",nDig+1,1)+cRet
		nNum	:= Int(nNum/nBase)
	EndDo
Return cRet

//Valor do texto na base: número ou Erro (10 dígitos, negativo em complemento de dois)
Static Function TxtBase(oM As Object, xVal As Variant, nBase As Numeric)
	Local cTxt As Variant
	Local nRet := 0 As Numeric
	Local nCont As Numeric
	Local nDig As Numeric
	If ValType(xVal)=="N"
		cTxt	:= oM:NumTxt(xVal)
	Else
		cTxt	:= oM:Txt(xVal)
	EndIf
	If oM:EhErro(cTxt)
		Return cTxt
	EndIf
	cTxt	:= Upper(AllTrim(cTxt))
	If Len(cTxt)>10
		Return oM:Err("#NUM!")
	EndIf
	For nCont:=1 to Len(cTxt)
		nDig	:= At(SubStr(cTxt,nCont,1),"0123456789ABCDEF")-1
		If nDig<0 .OR. nDig>=nBase
			Return oM:Err("#NUM!")
		EndIf
		nRet	:= nRet*nBase+nDig
	Next
	If Len(cTxt)==10 .AND. nRet>=(nBase^10)/2	//Negativo em complemento de dois
		nRet	:= nRet-(nBase^10)
	EndIf
Return nRet

Static Function fBase2Dec(oM As Object, aArgs As Array, nBase As Numeric)
Return TxtBase(oM,aArgs[1],nBase)

//Número para a base com casas e limites do Excel
Static Function DecBase(oM As Object, nNum As Numeric, nBase As Numeric, xCasas As Variant)
	Local nLim := (nBase^10)/2 As Numeric
	Local cRet As Character
	Local nCasas As Variant
	nNum	:= Int(nNum)
	If nNum<-nLim .OR. nNum>=nLim
		Return oM:Err("#NUM!")
	EndIf
	If nNum<0	//Complemento de dois em 10 dígitos (casas ignoradas)
		Return NumBase(nBase^10+nNum,nBase)
	EndIf
	cRet	:= NumBase(nNum,nBase)
	If ValType(xCasas)!="U"
		nCasas	:= oM:Num(xCasas)
		If oM:EhErro(nCasas)
			Return nCasas
		EndIf
		nCasas	:= Int(nCasas)
		If nCasas<1 .OR. nCasas>10 .OR. nCasas<Len(cRet)
			Return oM:Err("#NUM!")
		EndIf
		cRet	:= Replicate("0",nCasas-Len(cRet))+cRet
	EndIf
Return cRet

Static Function fDec2Base(oM As Object, aArgs As Array, nBase As Numeric)
	Local nNum := oM:Num(aArgs[1]) As Variant
	If oM:EhErro(nNum)
		Return nNum
	EndIf
Return DecBase(oM,nNum,nBase,If(Len(aArgs)>=2,aArgs[2],nil))

Static Function fBase2Base(oM As Object, aArgs As Array, nDe As Numeric, nPara As Numeric)
	Local nNum := TxtBase(oM,aArgs[1],nDe) As Variant
	If oM:EhErro(nNum)
		Return nNum
	EndIf
Return DecBase(oM,nNum,nPara,If(Len(aArgs)>=2,aArgs[2],nil))

/* =====================================================================================
   Operações de bits (inteiros de 0 a 2^48-1)
   ===================================================================================== */

Static Function BitArg(oM As Object, xVal As Variant)
	Local nNum := oM:Num(xVal) As Variant
	If oM:EhErro(nNum)
		Return nNum
	EndIf
	If nNum<0 .OR. nNum!=Int(nNum) .OR. nNum>=281474976710656
		Return oM:Err("#NUM!")
	EndIf
Return nNum

//nTipo 1=AND 2=OR 3=XOR
Static Function fBit(oM As Object, aArgs As Array, nTipo As Numeric)
	Local nA := BitArg(oM,aArgs[1]) As Variant
	Local nB := BitArg(oM,aArgs[2]) As Variant
	Local nRet := 0 As Numeric
	Local nPeso := 1 As Numeric
	Local nBa As Numeric
	Local nBb As Numeric
	Local nBit As Numeric
	If PrimErro(oM,{nA,nB})!=nil
		Return PrimErro(oM,{nA,nB})
	EndIf
	While nA>0 .OR. nB>0
		nBa	:= nA-2*Int(nA/2)
		nBb	:= nB-2*Int(nB/2)
		Do Case
			Case nTipo==1
				nBit	:= If(nBa==1 .AND. nBb==1,1,0)
			Case nTipo==2
				nBit	:= If(nBa==1 .OR. nBb==1,1,0)
			Otherwise
				nBit	:= If(nBa!=nBb,1,0)
		EndCase
		nRet	+= nBit*nPeso
		nPeso	*= 2
		nA		:= Int(nA/2)
		nB		:= Int(nB/2)
	EndDo
Return nRet

Static Function fBitShift(oM As Object, aArgs As Array, lEsq As Logical)
	Local nNum := BitArg(oM,aArgs[1]) As Variant
	Local nDesl := oM:Num(aArgs[2]) As Variant
	Local nRet As Numeric
	If PrimErro(oM,{nNum,nDesl})!=nil
		Return PrimErro(oM,{nNum,nDesl})
	EndIf
	nDesl	:= Int(nDesl)
	If Abs(nDesl)>53
		Return oM:Err("#NUM!")
	EndIf
	If !lEsq
		nDesl	:= -nDesl
	EndIf
	If nDesl>=0
		nRet	:= nNum*(2^nDesl)
	Else
		nRet	:= Int(nNum/(2^(-nDesl)))
	EndIf
	If nRet>=281474976710656
		Return oM:Err("#NUM!")
	EndIf
Return nRet

//DELTA(a,[b=0]) / GESTEP(número,[passo=0])
Static Function fDelta(oM As Object, aArgs As Array, lDelta As Logical)
	Local nA := oM:Num(aArgs[1]) As Variant
	Local nB := If(Len(aArgs)>=2 .AND. ValType(aArgs[2])!="U",oM:Num(aArgs[2]),0) As Variant
	If PrimErro(oM,{nA,nB})!=nil
		Return PrimErro(oM,{nA,nB})
	EndIf
	If ValType(aArgs[1])=="C" .AND. oM:TxtLoc(aArgs[1])==nil
		Return oM:Err("#VALUE!")
	EndIf
	If lDelta
		Return If(nA==nB,1,0)
	EndIf
Return If(nA>=nB,1,0)

/* =====================================================================================
   Bessel (séries para J e I; aproximações polinomiais de Numerical Recipes para Y e K)
   ===================================================================================== */

Static Function fBessel(oM As Object, aArgs As Array, cTipo As Character)
	Local nX := oM:Num(aArgs[1]) As Variant
	Local nN := oM:Num(aArgs[2]) As Variant
	If PrimErro(oM,{nX,nN})!=nil
		Return PrimErro(oM,{nX,nN})
	EndIf
	nN	:= Int(nN)
	If nN<0 .OR. ((cTipo=="Y" .OR. cTipo=="K") .AND. nX<=0)
		Return oM:Err("#NUM!")
	EndIf
	Do Case
		Case cTipo=="J"
			Return BesselJ(nX,nN)
		Case cTipo=="I"
			Return BesselI(nX,nN)
		Case cTipo=="Y"
			Return BesselY(nX,nN)
	EndCase
Return BesselK(nX,nN)

Static Function Fat(nN As Numeric)
	Local nRet := 1 As Numeric
	Local nCont As Numeric
	For nCont:=2 to nN
		nRet	*= nCont
	Next
Return nRet

//J_n(x): série de potências para |x| até 25; acima, aproximação assintótica com recorrência
Static Function BesselJ(nX As Numeric, nN As Numeric)
	Local nSoma := 0 As Numeric
	Local nTermo As Numeric
	Local nK As Numeric
	Local nJ0 As Numeric
	Local nJ1 As Numeric
	Local nJ As Numeric
	If Abs(nX)<=25
		nTermo	:= ((nX/2)^nN)/Fat(nN)
		nSoma	:= nTermo
		For nK:=1 to 300
			nTermo	:= -nTermo*(nX/2)*(nX/2)/(nK*(nK+nN))
			nSoma	+= nTermo
			If MenorIg(Abs(nTermo),Abs(nSoma)*0.0000000000000001)
				Exit
			EndIf
		Next
		Return nSoma
	EndIf
	nJ0	:= J0Asin(nX)
	If nN==0
		Return nJ0
	EndIf
	nJ1	:= J1Asin(nX)
	For nK:=1 to nN-1	//Recorrência para cima (estável para x grande)
		nJ	:= 2*nK/nX*nJ1-nJ0
		nJ0	:= nJ1
		nJ1	:= nJ
	Next
Return nJ1

//J0 e J1 assintóticos (Numerical Recipes, |x|>=8)
Static Function J0Asin(nX As Numeric)
	Local nAx := Abs(nX) As Numeric
	Local nZ := 8/nAx As Numeric
	Local nY := nZ*nZ As Numeric
	Local nXx := nAx-0.785398164 As Numeric
	Local nA1 := 1+nY*(-0.001098628627+nY*(0.00002734510407+nY*(-0.000002073370639+nY*0.0000002093887211))) As Numeric
	Local nA2 := -0.01562499995+nY*(0.0001430488765+nY*(-0.000006911147651+nY*(0.0000007621095161-nY*0.0000000934935152))) As Numeric
Return Sqrt(0.636619772/nAx)*(Cos(nXx)*nA1-nZ*Sin(nXx)*nA2)

Static Function J1Asin(nX As Numeric)
	Local nAx := Abs(nX) As Numeric
	Local nZ := 8/nAx As Numeric
	Local nY := nZ*nZ As Numeric
	Local nXx := nAx-2.356194491 As Numeric
	Local nA1 := 1+nY*(0.00183105+nY*(-0.00003516396496+nY*(0.000002457520174+nY*(-0.000000240337019)))) As Numeric
	Local nA2 := 0.04687499995+nY*(-0.0002002690873+nY*(0.000008449199096+nY*(-0.00000088228987+nY*0.000000105787412))) As Numeric
	Local nRet := Sqrt(0.636619772/nAx)*(Cos(nXx)*nA1-nZ*Sin(nXx)*nA2) As Numeric
Return If(nX<0,-nRet,nRet)

//I_n(x): série de potências
Static Function BesselI(nX As Numeric, nN As Numeric)
	Local nTermo := ((nX/2)^nN)/Fat(nN) As Numeric
	Local nSoma := nTermo As Numeric
	Local nK As Numeric
	For nK:=1 to 500
		nTermo	:= nTermo*(nX/2)*(nX/2)/(nK*(nK+nN))
		nSoma	+= nTermo
		If MenorIg(Abs(nTermo),Abs(nSoma)*0.0000000000000001)
			Exit
		EndIf
	Next
Return nSoma

//Y0, Y1 (Numerical Recipes) e recorrência
Static Function BesselY(nX As Numeric, nN As Numeric)
	Local nY0 := Y0(nX) As Numeric
	Local nY1 As Numeric
	Local nY As Numeric
	Local nK As Numeric
	If nN==0
		Return nY0
	EndIf
	nY1	:= Y1(nX)
	For nK:=1 to nN-1
		nY	:= 2*nK/nX*nY1-nY0
		nY0	:= nY1
		nY1	:= nY
	Next
Return nY1

Static Function Y0(nX As Numeric)
	Local nY As Numeric
	Local nA1 As Numeric
	Local nA2 As Numeric
	If nX<8
		nY	:= nX*nX
		nA1	:= -2957821389+nY*(7062834065+nY*(-512359803.6+nY*(10879881.29+nY*(-86327.92757+nY*228.4622733))))
		nA2	:= 40076544269+nY*(745249964.8+nY*(7189466.438+nY*(47447.2647+nY*(226.1030244+nY*1))))
		Return nA1/nA2+0.636619772*BesselJ(nX,0)*Log(nX)
	EndIf
Return Y0Asin(nX)

Static Function Y0Asin(nX As Numeric)
	Local nZ := 8/nX As Numeric
	Local nY := nZ*nZ As Numeric
	Local nXx := nX-0.785398164 As Numeric
	Local nA1 := 1+nY*(-0.001098628627+nY*(0.00002734510407+nY*(-0.000002073370639+nY*0.0000002093887211))) As Numeric
	Local nA2 := -0.01562499995+nY*(0.0001430488765+nY*(-0.000006911147651+nY*(0.0000007621095161-nY*0.0000000934935152))) As Numeric
Return Sqrt(0.636619772/nX)*(Sin(nXx)*nA1+nZ*Cos(nXx)*nA2)

Static Function Y1(nX As Numeric)
	Local nY As Numeric
	Local nA1 As Numeric
	Local nA2 As Numeric
	Local nZ As Numeric
	Local nXx As Numeric
	If nX<8
		nY	:= nX*nX
		nA1	:= nX*(-4900604943000+nY*(1275274390000+nY*(-51534381390+nY*(734926455.1+nY*(-4237922.726+nY*8511.937935)))))
		nA2	:= 24995805700000+nY*(424441966400+nY*(3733650367+nY*(22459040.02+nY*(102042.605+nY*(354.9632885+nY)))))
		Return nA1/nA2+0.636619772*(BesselJ(nX,1)*Log(nX)-1/nX)
	EndIf
	nZ	:= 8/nX
	nY	:= nZ*nZ
	nXx	:= nX-2.356194491
	nA1	:= 1+nY*(0.00183105+nY*(-0.00003516396496+nY*(0.000002457520174+nY*(-0.000000240337019))))
	nA2	:= 0.04687499995+nY*(-0.0002002690873+nY*(0.000008449199096+nY*(-0.00000088228987+nY*0.000000105787412)))
Return Sqrt(0.636619772/nX)*(Sin(nXx)*nA1+nZ*Cos(nXx)*nA2)

//K0, K1 (Numerical Recipes) e recorrência
Static Function BesselK(nX As Numeric, nN As Numeric)
	Local nK0 := K0(nX) As Numeric
	Local nK1 As Numeric
	Local nK As Numeric
	Local nCont As Numeric
	If nN==0
		Return nK0
	EndIf
	nK1	:= K1(nX)
	For nCont:=1 to nN-1
		nK	:= nK0+2*nCont/nX*nK1
		nK0	:= nK1
		nK1	:= nK
	Next
Return nK1

Static Function K0(nX As Numeric)
	Local nY As Numeric
	If nX<=2
		nY	:= nX*nX/4
		Return (-Log(nX/2)*BesselI(nX,0))+(-0.57721566+nY*(0.42278420+nY*(0.23069756+nY*(0.3488590/10+nY*(0.262698/100+nY*(0.10750/1000+nY*0.74/100000))))))
	EndIf
	nY	:= 2/nX
Return (Exp(-nX)/Sqrt(nX))*(1.25331414+nY*(-0.7832358/10+nY*(0.2189568/10+nY*(-0.1062446/10+nY*(0.587872/100+nY*(-0.251540/100+nY*0.53208/1000))))))

Static Function K1(nX As Numeric)
	Local nY As Numeric
	If nX<=2
		nY	:= nX*nX/4
		Return (Log(nX/2)*BesselI(nX,1))+(1/nX)*(1+nY*(0.15443144+nY*(-0.67278579+nY*(-0.18156897+nY*(-0.1919402/10+nY*(-0.110404/100+nY*(-0.4686/10000)))))))
	EndIf
	nY	:= 2/nX
Return (Exp(-nX)/Sqrt(nX))*(1.25331414+nY*(0.23498619+nY*(-0.3655620/10+nY*(0.1504268/10+nY*(-0.780353/100+nY*(0.325614/100+nY*(-0.68245/1000)))))))

/* =====================================================================================
   CONVERT
   ===================================================================================== */

/*/{Protheus.doc} Unidades
Tabela de unidades do CONVERT: {símbolo,categoria,fator para a unidade base,aceita prefixo (P=decimal B=binário)}
/*/
Static Function Unidades()
	Local aRet := {} As Array
	//Massa (base: grama)
	AADD(aRet,{"g","massa",1,"P"})
	AADD(aRet,{"sg","massa",14593.90293720636,""})
