// Gravação do conteúdo da classe custom.excel.Xlsx em HTML (Save2Html)
// Gera um único arquivo .html autocontido (CSS e JS embutidos) com os dados de cada planilha em <table>
#include "tlpp-core.th"
#include "totvs.ch"
#include "fileio.ch"
#include "parmtype.ch"

Namespace custom.excel

#define HTML_TAMBUF		65536	//Tamanho do buffer de escrita/leitura
#define HTML_CHARTJS	"https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"
#define HTML_FORMULAJS	"https://cdn.jsdelivr.net/npm/@formulajs/formulajs@4.6.1/lib/browser/formula.min.js"

//Posições do array de contexto da planilha (aCtx)
#define CT_PLAN		1	//Número da planilha
#define CT_NOME		2	//Nome da planilha (CP-1252)
#define CT_MAXCOL	3	//Última coluna
#define CT_MAXLIN	4	//Última linha obrigatória (mesclagens, tabelas, imagens e gráficos)
#define CT_MERGE	5	//Json "lin|col" -> {nLinhas,nColunas} da célula superior esquerda
#define CT_COB		6	//Json "lin|col" -> .T. para células cobertas por mesclagem
#define CT_IDS		7	//Json "lin|col" -> .T. para células que precisam de id (âncoras/destino de link)
#define CT_COM		8	//Json "lin|col" -> texto do comentário
#define CT_LNK		9	//Json "lin|col" -> {location,tooltip,display}
#define CT_INP		10	//Array por coluna com as configurações de input
#define CT_BLC		11	//Array por coluna com os blocos de código da coluna
#define CT_LENTO	12	//Existe bloco de célula/coluna ou input (montagem com Json)
#define CT_TAM		12

//Posições do array de leitura (aSt)
#define ST_MODO		1	//A=arquivo de linhas, M=xml em memória, B=banco
#define ST_HANDLE	2	//Handle do arquivo
#define ST_BUF		3	//Buffer de leitura
#define ST_POS		4	//Posição atual no buffer
#define ST_EOF		5	//Arquivo lido por completo
#define ST_ALIAS	6	//Alias da query (tipo B)
#define ST_LINHAS	7	//Linhas já carregadas e ordenadas (tipo M)
#define ST_ARQTMP	8	//Arquivo temporário para apagar ao final
#define ST_MAXCOL	9	//Maior coluna encontrada
#define ST_HTML		10	//Instância Html
#define ST_TAM		10

/*/{Protheus.doc} Html
Configuração e geração do HTML de um objeto custom.excel.Xlsx (método Save2Html).
Cada planilha vira uma <table> com estilos, mesclagens, larguras, painéis congelados, tabela formatada,
agrupamento de linhas e colunas, cor das abas, filtro/ordenação, formatação condicional, comentários, hyperlinks, imagens e gráficos (Chart.js).
Colunas podem ser exibidas como input e blocos de código permitem alterar o HTML por planilha, linha, coluna e célula.
@type class
@version 1.0
@author Saulo Gomes Martins
@since 22/10/2026
@see custom.excel.Xlsx
/*/
Class Html
	Public Data oExcel			As Object		//Instância de custom.excel.Xlsx
	Public Data cClassName		As Character
	Public Data cTitulo			As Character	//Título da página (<title>)
	Public Data aCss			As Array		//CSS adicional
	Public Data aScript			As Array		//JavaScript adicional
	Public Data aHead			As Array		//HTML adicional no <head>
	Public Data cAction			As Character	//URL do <form> (vazio = sem form)
	Public Data cMetodo			As Character	//Método do <form>
	Public Data cTxtBotao		As Character	//Texto do botão de envio
	Public Data cChartJs		As Character	//URL do Chart.js
	Public Data cFormulaJs		As Character	//URL do formula.js (funções do Excel no cálculo das fórmulas no navegador)
	Public Data lAbas			As Logical		//Exibir abas por planilha
	Public Data aPlanFiltro		As Array		//Planilhas a gerar (vazio = todas)
	Public Data xGrade			As Variant		//Linhas de grade (Nil = conforme a planilha)
	Public Data lLarguraAuto	As Logical		//Largura automática das colunas (table-layout:auto)
	Public Data aColInput		As Array		//{nPlanilha,xColuna,cTipo,nLinIni,nLinFim,cNome,lSomenteLeitura,aOpcoes}
	Public Data aColBloco		As Array		//{nPlanilha,xColuna,bBloco}
	Public Data bPlanilha		As Variant		//Bloco por planilha
	Public Data bLinha			As Variant		//Bloco por linha
	Public Data bCelula			As Variant		//Bloco por célula
	//Controle interno da geração
	Public Data oFile			As Object
	Public Data cBuffer			As Character
	Public Data aSty			As Array		//Cache por estilo {cTipoValor,aFormato}
	Public Data jFmt			As Variant		//Cache dos formatos por numFmtId (Json)
	Public Data jRot			As Variant		//Estilos com texto girado {"N": graus} (Json)
	Public Data lChart			As Logical		//Existe gráfico (carregar Chart.js)
	Public Data lFormula		As Logical		//Existe célula com fórmula (cálculo no navegador)
	Public Data jFmtF			As Variant		//Formatos numéricos dos estilos das células com fórmula {"estilo": "código"} (Json)

	Public Method New()				As Object
	Public Method ClassName()
	Public Method SetTitulo()		As Object
	Public Method AddCss()			As Object
	Public Method AddScript()		As Object
	Public Method AddHead()			As Object
	Public Method SetAction()		As Object
	Public Method SetChartJs()		As Object
	Public Method SetFormulaJs()	As Object
	Public Method SetAbas()			As Object
	Public Method SetPlanilhas()	As Object
	Public Method SetGrade()		As Object
	Public Method SetLarguraAuto()	As Object
	Public Method SetColInput()		As Object
	Public Method SetBlocoPlanilha()	As Object
	Public Method SetBlocoLinha()	As Object
	Public Method SetBlocoColuna()	As Object
	Public Method SetBlocoCelula()	As Object
	Public Method Gerar()
	//Interno
	Public Method Escreve()
	Public Method Descarrega()
	Public Method InfoEstilo()
	Public Method FmtValor()
	Public Method FmtFormula()
	Public Method Destroy()
EndClass

/*/{Protheus.doc} Html::New
Construtor. Normalmente criado por oExcel:NewHtml()
@type method
@version 1.0
@author Saulo Gomes Martins
@since 22/10/2026
@param oExcel, object, Instância de custom.excel.Xlsx
@return object, self
/*/
Method New(oExcel As Object) As Object Class Html
	::oExcel		:= oExcel
	::cClassName	:= "CUSTOM.EXCEL.HTML"
	::cTitulo		:= ""
	::aCss			:= {}
	::aScript		:= {}
	::aHead			:= {}
	::cAction		:= ""
	::cMetodo		:= "post"
	::cTxtBotao		:= "Enviar"
	::cChartJs		:= HTML_CHARTJS
	::cFormulaJs	:= HTML_FORMULAJS
	::lAbas			:= .T.
	::aPlanFiltro	:= {}
	::xGrade		:= nil
	::lLarguraAuto	:= .F.
	::aColInput		:= {}
	::aColBloco		:= {}
	::bPlanilha		:= nil
	::bLinha		:= nil
	::bCelula		:= nil
	::cBuffer		:= ""
	::aSty			:= {}
	::jFmt			:= nil
	::jRot			:= nil
	::lChart		:= .F.
	::lFormula		:= .F.
	::jFmtF			:= nil
Return self

