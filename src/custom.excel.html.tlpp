	cRet	+= "/* ---------- datas ---------- */"+Chr(10)
	cRet	+= "function d1(n,fn,fl){def(n,function(v){for(var i=0;i<v.length;i++){if(v[i]===undefined){continue;}v[i]=num1(v[i]);if(isE(v[i])){return v[i];}}return fn.apply(null,v);},'E'+(fl||''));}"+Chr(10)
	cRet	+= "d1('DATE',function(y,m,d){y=Math.floor(y);if(y<1900){y+=1900;}var s=serData(y,Math.floor(m)-1,Math.floor(d));return s<0?er(E_NUM):s;});"+Chr(10)
	cRet	+= "d1('TIME',function(h,m,s){var t=(Math.floor(h)*3600+Math.floor(m)*60+Math.floor(s))/86400;return t<0?er(E_NUM):t-Math.floor(t);});"+Chr(10)
