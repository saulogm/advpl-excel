	PARAMTYPE 0	VAR lAuto	AS LOGICAL	OPTIONAL DEFAULT .T.
	::lLarguraAuto	:= lAuto
Return self

/*/{Protheus.doc} Html::SetColInput
Exibe as células de uma coluna como input
@type method
@author Saulo Gomes Martins
@since 22/10/2026
@param xColuna, variant, Número da coluna, letra ("B") ou nome da coluna/campo de tabela formatada
@param cTipo, character, auto|text|number|date|datetime|checkbox|select|textarea (auto = pelo tipo do valor)
@param nLinIni, numeric, Linha inicial (padrão: 1, ou a 1ª linha de dados quando coluna de tabela formatada)
@param nLinFim, numeric, Linha final (padrão: até o fim, ou a última linha de dados da tabela)
@param nPlanilha, numeric, Planilha (padrão: planilha atual do Excel; 0 = todas)
@param cNome, character, Atributo name (padrão: referência da célula, ex: B3). O nome recebe o sufixo "_linha" quando informado
@param lSomenteLeitura, logical, Input somente leitura
@param aOpcoes, array, Opções do select: {"valor",...} ou {{"valor","texto"},...}
@return object, self
/*/
Method SetColInput(xColuna As Variant, cTipo As Character, nLinIni As Numeric, nLinFim As Numeric, nPlanilha As Numeric, cNome As Character, lSomenteLeitura As Logical, aOpcoes As Array) As Object Class Html
	PARAMTYPE 0	VAR xColuna			AS CHARACTER,NUMERIC
	PARAMTYPE 1	VAR cTipo			AS CHARACTER	OPTIONAL DEFAULT "auto"
	PARAMTYPE 2	VAR nLinIni			AS NUMERIC		OPTIONAL DEFAULT 0
	PARAMTYPE 3	VAR nLinFim			AS NUMERIC		OPTIONAL DEFAULT 0
	PARAMTYPE 4	VAR nPlanilha		AS NUMERIC		OPTIONAL DEFAULT ::oExcel:nPlanilhaAt
	PARAMTYPE 5	VAR cNome			AS CHARACTER	OPTIONAL DEFAULT ""
	PARAMTYPE 6	VAR lSomenteLeitura	AS LOGICAL		OPTIONAL DEFAULT .F.
	PARAMTYPE 7	VAR aOpcoes			AS ARRAY		OPTIONAL DEFAULT {}
	AADD(::aColInput,{nPlanilha,xColuna,lower(cTipo),nLinIni,nLinFim,cNome,lSomenteLeitura,aClone(aOpcoes)})
Return self

/*/{Protheus.doc} Html::SetBlocoPlanilha
Bloco executado antes de gerar cada planilha: Eval(bBloco,jPlan,nPlanilha,oExcel)
jPlan: titulo, antes, depois (HTML), class, attr (json), ignorar (lógico)
@type method
@author Saulo Gomes Martins
@since 22/10/2026
@param bBloco, codeblock, Bloco de código
@return object, self
/*/
Method SetBlocoPlanilha(bBloco As CodeBlock) As Object Class Html
	::bPlanilha	:= bBloco
Return self

/*/{Protheus.doc} Html::SetBlocoLinha
Bloco executado para cada linha: Eval(bBloco,jLin,nLinha,nPlanilha,oExcel)
jLin: attr (json), class, style, antes, depois (HTML antes/depois do <tr>), ignorar
@type method
@author Saulo Gomes Martins
@since 22/10/2026
@param bBloco, codeblock, Bloco de código
@return object, self
/*/
Method SetBlocoLinha(bBloco As CodeBlock) As Object Class Html
	::bLinha	:= bBloco
Return self

/*/{Protheus.doc} Html::SetBlocoColuna
Bloco executado para cada célula de uma coluna: Eval(bBloco,jCel,nLinha,nColuna,nPlanilha,oExcel)
Executado depois do bloco de célula (SetBlocoCelula)
@type method
@author Saulo Gomes Martins
@since 22/10/2026
@param xColuna, variant, Número, letra ou nome da coluna/campo de tabela formatada
@param bBloco, codeblock, Bloco de código
@param nPlanilha, numeric, Planilha (padrão: planilha atual do Excel; 0 = todas)
@return object, self
/*/
Method SetBlocoColuna(xColuna As Variant, bBloco As CodeBlock, nPlanilha As Numeric) As Object Class Html
	PARAMTYPE 0	VAR xColuna		AS CHARACTER,NUMERIC
	PARAMTYPE 2	VAR nPlanilha	AS NUMERIC	OPTIONAL DEFAULT ::oExcel:nPlanilhaAt
	AADD(::aColBloco,{nPlanilha,xColuna,bBloco})
Return self

/*/{Protheus.doc} Html::SetBlocoCelula
Bloco executado para cada célula: Eval(bBloco,jCel,nLinha,nColuna,nPlanilha,oExcel)
jCel: valor, tipo (C,N,L,D,T,U), texto (formatado), html (substitui o conteúdo), formula, estilo, ref, tag,
attr (json), class, style, input (json ou ausente), antes, depois (HTML dentro da célula), ignorar
@type method
@author Saulo Gomes Martins
@since 22/10/2026
@param bBloco, codeblock, Bloco de código
@return object, self
/*/
Method SetBlocoCelula(bBloco As CodeBlock) As Object Class Html
	::bCelula	:= bBloco
Return self

/*/{Protheus.doc} Html::Destroy
Libera os caches internos
@type method
@author Saulo Gomes Martins
@since 22/10/2026
/*/
Method Destroy() Class Html
	If ValType(::jFmt)=="J"
		FreeObj(::jFmt)
	EndIf
	::jFmt	:= nil
	If ValType(::jRot)=="J"
		FreeObj(::jRot)
	EndIf
	::jRot	:= nil
	If ValType(::jFmtF)=="J"
		FreeObj(::jFmtF)
	EndIf
	::jFmtF	:= nil
	FwFreeArray(::aSty)
	::aSty	:= {}
Return

/*/{Protheus.doc} Html::Escreve
Acumula texto (CP-1252) no buffer e grava em UTF-8 quando atinge o limite
@type method
@author Saulo Gomes Martins
@since 22/10/2026
@param cTexto, character, Texto (CP-1252) a ser gravado
/*/
Method Escreve(cTexto As Character) Class Html
	::cBuffer	+= cTexto
	If Len(::cBuffer)>=HTML_TAMBUF
		::Descarrega()
	EndIf
Return

/*/{Protheus.doc} Html::Descarrega
Grava em UTF-8 o conteúdo pendente do buffer e o esvazia
@type method
@author Saulo Gomes Martins
@since 22/10/2026
/*/
Method Descarrega() Class Html
	If !Empty(::cBuffer)
		::oFile:Write(Utf8(::cBuffer))
		::cBuffer	:= ""
	EndIf
Return

/*/{Protheus.doc} Html::Gerar
Gera o arquivo HTML no servidor
@type method
@author Saulo Gomes Martins
@since 22/10/2026
@param cArquivo, character, Caminho do arquivo no servidor
@return logical, .T. se gerou
/*/
Method Gerar(cArquivo As Character) Class Html
	Local oExcel := ::oExcel As Object
	Local aPlan := {} As Array
	Local aNomes := {} As Array
	Local nCont As Numeric
	Local nPos As Numeric
	Local cTexto As Character
	Local lForm := !Empty(::cAction) As Logical
	Local jDxf As Variant
	Local aDxf As Array
	Local oErro As Object

	::cBuffer	:= ""
	::lChart	:= .F.
	FwFreeArray(::aSty)
	::aSty		:= {}
	If ValType(::jFmt)=="J"
		FreeObj(::jFmt)
	EndIf
	::jFmt		:= JsonObject():New()
	If ValType(::jRot)=="J"
		FreeObj(::jRot)
	EndIf
	::jRot		:= JsonObject():New()
	::lFormula	:= .F.
	If ValType(::jFmtF)=="J"
		FreeObj(::jFmtF)
	EndIf
	::jFmtF		:= JsonObject():New()

	//Planilhas a gerar
	For nCont:=1 to Len(oExcel:aPlanilhas)
		AADD(aNomes,NomePlan(oExcel,nCont))
		If Empty(::aPlanFiltro)
			AADD(aPlan,nCont)
		Else
			nPos	:= aScan(::aPlanFiltro,{|x| (ValType(x)=="N" .and. x==nCont) .or. (ValType(x)=="C" .and. Upper(AllTrim(x))==Upper(aNomes[nCont])) })
			If nPos>0
				AADD(aPlan,nCont)
			EndIf
		EndIf
	Next
	For nCont:=1 to Len(oExcel:aCharts)
		If aScan(aPlan,oExcel:aCharts[nCont][2])>0
			::lChart	:= .T.
		EndIf
	Next

	::oFile	:= FWFileWriter():New(cArquivo,.T.)
	::oFile:SetCaseSensitive(.T.)
	If !::oFile:Create()
		UserException("Xlsx - Falha ao criar o arquivo html "+cArquivo+": "+::oFile:Error():Message)
	EndIf

	cTexto	:= If(Empty(::cTitulo),oExcel:cNomeFile2,::cTitulo)
	::Escreve('<!DOCTYPE html>'+Chr(10)+'<html lang="pt-BR"><head><meta charset="utf-8">')
	::Escreve('<meta name="viewport" content="width=device-width,initial-scale=1">')
	::Escreve('<meta name="generator" content="advpl-excel custom.excel.Html">')
	::Escreve('<title>'+HtmlEsc(cTexto)+'</title>'+Chr(10))
	::Escreve('<style>'+Chr(10)+HtmlCss()+CssEstilos(self)+Chr(10))
	For nCont:=1 to Len(::aCss)
		::Escreve(::aCss[nCont]+Chr(10))
	Next
	::Escreve('</style>'+Chr(10))
	For nCont:=1 to Len(::aHead)
		::Escreve(::aHead[nCont]+Chr(10))
	Next
	::Escreve('</head><body>'+Chr(10))

	If lForm
		::Escreve('<form class="xh-form" method="'+HtmlEsc(::cMetodo)+'" action="'+HtmlEsc(::cAction)+'">'+Chr(10))
	EndIf
	If ::lAbas .and. Len(aPlan)>1
		::Escreve('<nav class="xh-tabs">')
		For nCont:=1 to Len(aPlan)
			cTexto	:= CorXml(oExcel:asheet[aPlan[nCont]][1],"/xmlns:worksheet/xmlns:sheetPr/xmlns:tabColor")	//Cor da aba
			::Escreve('<button type="button" class="xh-tab'+If(nCont==1,' xh-on','')+'" data-plan="'+cValToChar(aPlan[nCont])+'"'+If(Empty(cTexto),'',' data-cor="'+cTexto+'"')+'>'+HtmlEsc(aNomes[aPlan[nCont]])+'</button>')
		Next
		::Escreve('</nav>'+Chr(10))
	EndIf
	Try
		For nCont:=1 to Len(aPlan)
			GeraPlan(self,aPlan[nCont],aNomes[aPlan[nCont]],!::lAbas .or. nCont==1)
		Next
	Catch oErro
		//Fecha e apaga o arquivo parcial antes de repassar o erro
		::cBuffer	:= ""
		::oFile:Close()
		FreeObj(::oFile)
		::oFile	:= nil
		FErase(cArquivo,,.F.)
		::Destroy()
		FwFreeArray(aPlan)
		FwFreeArray(aNomes)
		UserException(oErro:Description)
	EndTry
	If lForm
		::Escreve('<div class="xh-acoes"><input type="hidden" name="xh_dados" value=""><button type="submit">'+HtmlEsc(::cTxtBotao)+'</button></div></form>'+Chr(10))
	EndIf

	//Estilos de formatação condicional (dxf)
	aDxf	:= DxfCss(oExcel)
	jDxf	:= JsonObject():New()
	jDxf["d"]	:= aDxf
	cTexto	:= jDxf:ToJson()
	cTexto	:= SubStr(cTexto,At("[",cTexto),Rat("]",cTexto)-At("[",cTexto)+1)
	::Escreve('<script type="application/json" id="xh-dxf">'+JsonScript(cTexto)+'</script>'+Chr(10))
	FreeObj(jDxf)
	FwFreeArray(aDxf)

	If ::lChart .and. !Empty(::cChartJs)
		::Escreve('<script src="'+HtmlEsc(::cChartJs)+'"></script>'+Chr(10))
	EndIf
	//Fórmulas: formatos numéricos das células com fórmula, localidade e funções do Excel (formula.js) para o cálculo no navegador
	If ::lFormula
		::Escreve('<script type="application/json" id="xh-fmt">{"local":"'+oExcel:cCalcLocal+'","fmt":'+JsonScript(::jFmtF:ToJson())+'}</script>'+Chr(10))
		If !Empty(::cFormulaJs)
			::Escreve('<script src="'+HtmlEsc(::cFormulaJs)+'"></script>'+Chr(10))
		EndIf
	EndIf
	::Escreve('<script>'+Chr(10)+HtmlJs()+'</script>'+Chr(10))
	For nCont:=1 to Len(::aScript)
		::Escreve('<script>'+Chr(10)+::aScript[nCont]+Chr(10)+'</script>'+Chr(10))
	Next
	::Escreve('</body></html>'+Chr(10))
	::Descarrega()
	::oFile:Close()
	FreeObj(::oFile)
	::oFile	:= nil
	FwFreeArray(aPlan)
	FwFreeArray(aNomes)
	::Destroy()
Return .T.

/*/{Protheus.doc} Html::InfoEstilo
Retorna as informações do estilo para conversão e formatação do valor: {cTipoValor(N,D,T,C,X),aFormato}
@type method
@author Saulo Gomes Martins
@since 22/10/2026
@param nStyle, numeric, Id do estilo (0 based)
@return array, {cTipoValor,aFormato}
/*/
Method InfoEstilo(nStyle As Numeric) Class Html
	Local cXPath As Character
	Local cFmtId As Character
	Local cCode As Character
	Local aFmt As Array
	If nStyle<0
		nStyle	:= 0
	EndIf
	If nStyle+1<=Len(::aSty) .and. ValType(::aSty[nStyle+1])=="A"
		Return ::aSty[nStyle+1]
	EndIf
	While Len(::aSty)<nStyle+1
		AADD(::aSty,nil)
	EndDo
	cXPath	:= "/xmlns:styleSheet/xmlns:cellXfs/xmlns:xf["+cValToChar(nStyle+1)+"]"
	cFmtId	:= ::oExcel:oStyle:XPathGetAtt(cXPath,"numFmtId")
	If Empty(cFmtId)
		cFmtId	:= "0"
	EndIf
	If ValType(::jFmt)!="J"
		::jFmt	:= JsonObject():New()
	EndIf
	If !::jFmt:HasProperty(cFmtId)
		cCode	:= CodigoFmt(::oExcel,Val(cFmtId))
		::jFmt[cFmtId]	:= cCode
	EndIf
	aFmt	:= ParseFmt(::jFmt[cFmtId])
	::aSty[nStyle+1]	:= {aFmt[1],aFmt,::jFmt[cFmtId]}
Return ::aSty[nStyle+1]

/*/{Protheus.doc} Html::FmtValor
Formata o valor conforme o formato numérico do estilo
@type method
@author Saulo Gomes Martins
@since 22/10/2026
@param xValor, variant, Valor (numérico/serial para datas)
@param cTipo, character, Tipo do valor (C,N,L,D,T,U)
@param nStyle, numeric, Id do estilo
@param cCor, character, (referência) cor do formato ([Red], [Blue]...)
@return character, texto formatado
/*/
Method FmtValor(xValor As Variant, cTipo As Character, nStyle As Numeric, cCor As Character) Class Html
	Local aInfo As Array
	cCor	:= ""
	If cTipo=="C"
		Return xValor
	ElseIf cTipo=="L"
		Return If(xValor,"VERDADEIRO","FALSO")
	ElseIf cTipo=="U" .or. ValType(xValor)!="N"
		Return ""
	EndIf
	aInfo	:= ::InfoEstilo(nStyle)
Return FmtNumero(xValor,aInfo[2],@cCor)

/*/{Protheus.doc} Html::FmtFormula
Registra que a página tem fórmula e o formato numérico do estilo da célula, usado para exibir o valor recalculado no navegador
@type method
@author Saulo Gomes Martins
@since 25/10/2026
@param nStyle, numeric, Id do estilo da célula
/*/
Method FmtFormula(nStyle As Numeric) Class Html
	Local aInfo As Array
	Local cChave := cValToChar(Max(nStyle,0)) As Character
	::lFormula	:= .T.
	If !::jFmtF:HasProperty(cChave)
		aInfo	:= ::InfoEstilo(nStyle)
		::jFmtF[cChave]	:= aInfo[3]
	EndIf
Return

//----------------------------------------------------------------------
//GERAÇÃO DA PLANILHA
//----------------------------------------------------------------------
/*/{Protheus.doc} GeraPlan
Gera a <section> de uma planilha
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param oHtml, object, Instância Html
@param nPlan, numeric, Planilha
@param cNome, character, Nome da planilha
@param lVisivel, logical, Seção visível inicialmente
/*/
Static Function GeraPlan(oHtml As Object, nPlan As Numeric, cNome As Character, lVisivel As Logical)
	Local oExcel := oHtml:oExcel As Object
	Local oXml := oExcel:asheet[nPlan][1] As Object
	Local aCtx As Array
	Local jPlan As Variant
	Local jMeta As Variant
	Local aSt As Array
	Local aRow As Variant
	Local nLinAnt := 0 As Numeric
	Local nCont As Numeric
	Local cGrade As Character
	Local lGrade As Logical
	Local aCols As Array
	Local cTexto As Character
	Local aObjs As Array
	Local oErro As Object
	Local nLargTab := 0 As Numeric
	Local cAltLin As Character

	jPlan	:= JsonObject():New()
	jPlan["titulo"]		:= ""
	jPlan["antes"]		:= ""
	jPlan["depois"]		:= ""
	jPlan["class"]		:= ""
	jPlan["attr"]		:= JsonObject():New()
	jPlan["ignorar"]	:= .F.
	If ValType(oHtml:bPlanilha)=="B"
		Eval(oHtml:bPlanilha,jPlan,nPlan,oExcel)
	EndIf
	If jPlan["ignorar"]
		FreeObj(jPlan)
		Return
	EndIf

	jMeta	:= JsonObject():New()
	aCtx	:= Contexto(oHtml,nPlan,cNome,jMeta,@aCols,@aObjs)

	//Linhas de grade
	If ValType(oHtml:xGrade)=="L"
		lGrade	:= oHtml:xGrade
	Else
		cGrade	:= oXml:XPathGetAtt("/xmlns:worksheet/xmlns:sheetViews/xmlns:sheetView","showGridLines")
		lGrade	:= !(cGrade=="0")
	EndIf

	aSt		:= LeitorAbrir(oHtml,nPlan)
	aCtx[CT_MAXCOL]	:= Max(aCtx[CT_MAXCOL],aSt[ST_MAXCOL])
	While Len(aCols)<aCtx[CT_MAXCOL]
		AADD(aCols,{64,.F.})
	EndDo
	If Len(aCols)>aCtx[CT_MAXCOL]
		aSize(aCols,Max(aCtx[CT_MAXCOL],1))
	EndIf
	aCtx[CT_INP]	:= PrepColunas(oHtml,nPlan,aCtx[CT_MAXCOL],.T.)
	aCtx[CT_BLC]	:= PrepColunas(oHtml,nPlan,aCtx[CT_MAXCOL],.F.)
	aCtx[CT_LENTO]	:= ValType(oHtml:bCelula)=="B" .or. !Empty(oHtml:aColInput) .or. !Empty(oHtml:aColBloco)

	oHtml:Escreve('<section class="xh-sec'+If(lVisivel,' xh-on','')+If(Empty(jPlan["class"]),'',' '+jPlan["class"])+'" data-plan="'+cValToChar(nPlan)+'" data-nome="'+HtmlEsc(cNome)+'" id="xh-p'+cValToChar(nPlan)+'"'+AttrJson(jPlan["attr"])+'>'+Chr(10))
	oHtml:Escreve(cValToChar(jPlan["antes"]))
	If !Empty(jPlan["titulo"])
		oHtml:Escreve('<h2 class="xh-tit">'+HtmlEsc(jPlan["titulo"])+'</h2>')
	EndIf
	oHtml:Escreve('<div class="xh-bar"></div><div class="xh-wrap">')
	//Largura fixa (soma das colunas visíveis): sem ela o navegador ignora o table-layout:fixed e alarga as colunas pelo conteúdo
	For nCont:=1 to Len(aCols)
		If !aCols[nCont][2]
			nLargTab	+= aCols[nCont][1]
		EndIf
	Next
	cAltLin	:= oXml:XPathGetAtt("/xmlns:worksheet/xmlns:sheetFormatPr","defaultRowHeight")
	oHtml:Escreve('<table class="xh-t'+If(lGrade,' xh-g','')+If(oHtml:lLarguraAuto,' xh-auto','')+'" style="'+If(oHtml:lLarguraAuto,'','width:'+cValToChar(nLargTab)+'px;')+If(Val(cAltLin)>0,'--xh-rh:'+cValToChar(Round(Val(cAltLin)*4/3,0))+'px','')+'"><colgroup>')
	cTexto	:= ""
	For nCont:=1 to Len(aCols)
		cTexto	+= '<col'+If(aCols[nCont][2],' class="xh-ch" style="visibility:collapse;width:'+cValToChar(aCols[nCont][1])+'px"',' style="width:'+cValToChar(aCols[nCont][1])+'px"')
		If Len(aCols[nCont])>=4	//Agrupamento da coluna {nNivel,lRecolhida}
			cTexto	+= If(aCols[nCont][3]>0,' data-lvl="'+cValToChar(aCols[nCont][3])+'"','')+If(aCols[nCont][4],' data-fch="1"','')
		EndIf
		cTexto	+= '>'
	Next
	oHtml:Escreve(cTexto+'</colgroup><tbody>'+Chr(10))

	Try
		While ValType(aRow:=LeitorProx(aSt))=="A"
			For nCont:=nLinAnt+1 to aRow[1]-1
				Linha(oHtml,aCtx,{nCont,0,.F.,.F.,0,{}})
			Next
			Linha(oHtml,aCtx,aRow)
			nLinAnt	:= aRow[1]
			FwFreeArray(aRow)
		EndDo
	Catch oErro
		LeitorFechar(oHtml,aSt)
		LimpaCtx(aCtx)
		UserException(oErro:Description)
	EndTry
	LeitorFechar(oHtml,aSt)
	For nCont:=nLinAnt+1 to aCtx[CT_MAXLIN]
		Linha(oHtml,aCtx,{nCont,0,.F.,.F.,0,{}})
	Next
	oHtml:Escreve('</tbody></table>'+Chr(10))

	//Imagens e gráficos
	For nCont:=1 to Len(aObjs)
		oHtml:Escreve(aObjs[nCont])
	Next
	oHtml:Escreve('</div>'+Chr(10))
	cTexto	:= jMeta:ToJson()
	oHtml:Escreve('<script type="application/json" class="xh-meta">'+JsonScript(cTexto)+'</script>'+Chr(10))
	oHtml:Escreve(cValToChar(jPlan["depois"]))
	oHtml:Escreve('</section>'+Chr(10))

	LimpaCtx(aCtx)
	FreeObj(jMeta)
	FreeObj(jPlan)
	FwFreeArray(aCols)
	FwFreeArray(aObjs)
Return

/*/{Protheus.doc} ImgEstilo
Estilo do <img> conforme a rotação. Entre 45-135 e 225-315 graus o Excel trata a âncora como a caixa já girada:
a imagem tem largura e altura trocadas, centralizada e girada dentro da caixa (sem distorcer)
@type function
@author Saulo Gomes Martins
@since 24/10/2026
@param aImg, array, {nPlanilha,nIDImagem,nLinha,nColuna,nLargura,nAltura,nRotacao}
@return character, CSS
/*/
Static Function ImgEstilo(aImg As Array)
	Local nGraus := Mod(Mod(aImg[7],360)+360,360) As Numeric
	If nGraus==0
		Return "width:100%;height:100%"
	EndIf
	If (nGraus>=45 .and. nGraus<135) .or. (nGraus>=225 .and. nGraus<315)
		Return "position:absolute;left:50%;top:50%;width:"+cValToChar(aImg[6])+"px;height:"+cValToChar(aImg[5])+"px;transform:translate(-50%,-50%) rotate("+cValToChar(nGraus)+"deg)"
	EndIf
Return "width:100%;height:100%;transform:rotate("+cValToChar(nGraus)+"deg)"

/*/{Protheus.doc} Contexto
Lê os metadados da planilha (colunas, mesclagens, painel, filtro, tabelas, comentários, links,
formatação condicional, imagens e gráficos) e monta o contexto de geração
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param oHtml, object, Instância Html
@param nPlan, numeric, Número da planilha
@param cNome, character, Nome da planilha (CP-1252)
@param jMeta, json, Metadados da planilha enviados ao JavaScript (preenchido pela função)
@param aCols, array, (referência) Larguras das colunas {nLargura,lOculta}
@param aObjs, array, (referência) Imagens e gráficos posicionados na planilha
@return array, aCtx
/*/
Static Function Contexto(oHtml As Object, nPlan As Numeric, cNome As Character, jMeta As Json, aCols As Array, aObjs As Array)
	Local oExcel := oHtml:oExcel As Object
	Local oXml := oExcel:asheet[nPlan][1] As Object
	Local aCtx := Array(CT_TAM) As Array
	Local aChild As Array
	Local aChild2 As Array
	Local nCont As Numeric
	Local nCont2 As Numeric
	Local nMin As Numeric
	Local nMax As Numeric
	Local nLarg As Numeric
	Local lOculta As Logical
	Local aRef As Array
	Local cRef As Character
	Local cTexto As Character
	Local aTab := {} As Array
	Local jTab As Variant
	Local oTab As Object
	Local cEstilo As Character
	Local nNum As Numeric
	Local cY As Character
	Local cX As Character
	Local jPane As Variant
	Local aGraf := {} As Array
	Local nMaxLin := 0 As Numeric
	Local nMaxCol := 0 As Numeric
	Local aColTab As Array
	Local jNomes As Variant
	Local cBase64 As Character
	Local jImg := JsonObject():New() As Json
	Local nNivCol As Numeric
	Local lFchCol As Logical
	Local jResumo As Variant
	Local cTmp As Character

	aCtx[CT_PLAN]	:= nPlan
	aCtx[CT_NOME]	:= cNome
	aCtx[CT_MERGE]	:= nil
	aCtx[CT_COB]	:= nil
	aCtx[CT_IDS]	:= JsonObject():New()
	aCtx[CT_COM]	:= nil
	aCtx[CT_LNK]	:= nil
	aCtx[CT_INP]	:= {}
	aCtx[CT_BLC]	:= {}
	aCtx[CT_LENTO]	:= .F.
	aCols	:= {}
	aObjs	:= {}
	jMeta["plan"]	:= nPlan
	jMeta["nome"]	:= cNome

	//Colunas
	aChild	:= oXml:XPathGetChildArray("/xmlns:worksheet/xmlns:cols")
	For nCont:=1 to Len(aChild)
		nMin	:= Val(oXml:XPathGetAtt(aChild[nCont][2],"min"))
		nMax	:= Val(oXml:XPathGetAtt(aChild[nCont][2],"max"))
		nLarg	:= Val(oXml:XPathGetAtt(aChild[nCont][2],"width"))
		lOculta	:= oXml:XPathGetAtt(aChild[nCont][2],"hidden")=="1"
		nNivCol	:= Val(oXml:XPathGetAtt(aChild[nCont][2],"outlineLevel"))
		lFchCol	:= oXml:XPathGetAtt(aChild[nCont][2],"collapsed")=="1"
		If nMin<=0 .or. nMax<nMin .or. nMax>16384
			Loop
		EndIf
		nMax	:= Min(nMax,1024)	//Definições até a coluna 16384 não geram colunas no html
		If nMin>nMax
			Loop
		EndIf
		While Len(aCols)<nMax
			AADD(aCols,{64,.F.})
		EndDo
		For nCont2:=nMin to nMax
			If nLarg>0
				aCols[nCont2][1]	:= Round(nLarg*7,0)
			EndIf
			aCols[nCont2][2]	:= lOculta
			If nNivCol>0 .or. lFchCol
				aSize(aCols[nCont2],4)
				aCols[nCont2][3]	:= nNivCol
				aCols[nCont2][4]	:= lFchCol
			EndIf
		Next
	Next
	FwFreeArray(aChild)

	//Mesclagens
	aChild	:= oXml:XPathGetChildArray("/xmlns:worksheet/xmlns:mergeCells")
	If !Empty(aChild)
		aCtx[CT_MERGE]	:= JsonObject():New()
		aCtx[CT_COB]	:= JsonObject():New()
		For nCont:=1 to Len(aChild)
			aRef	:= oExcel:LocRef(oXml:XPathGetAtt(aChild[nCont][2],"ref"))
			If aRef[3]==0
				Loop
			EndIf
			aCtx[CT_MERGE][cValToChar(aRef[1])+"|"+cValToChar(aRef[2])]	:= {aRef[3]-aRef[1]+1,aRef[4]-aRef[2]+1}
			For nNum:=aRef[1] to aRef[3]
				For nCont2:=aRef[2] to aRef[4]
					If nNum!=aRef[1] .or. nCont2!=aRef[2]
						aCtx[CT_COB][cValToChar(nNum)+"|"+cValToChar(nCont2)]	:= .T.
					EndIf
				Next
			Next
			nMaxLin	:= Max(nMaxLin,aRef[3])
			nMaxCol	:= Max(nMaxCol,aRef[4])
		Next
	EndIf
	FwFreeArray(aChild)

	//Agrupamento: posição da linha/coluna de resumo (padrão abaixo/à direita)
	If oXml:XPathHasNode("/xmlns:worksheet/xmlns:sheetPr/xmlns:outlinePr")
		jResumo	:= JsonObject():New()
		cTmp	:= Lower(oXml:XPathGetAtt("/xmlns:worksheet/xmlns:sheetPr/xmlns:outlinePr","summaryBelow"))
		jResumo["abaixo"]	:= !(cTmp=="0" .or. cTmp=="false")
		cTmp	:= Lower(oXml:XPathGetAtt("/xmlns:worksheet/xmlns:sheetPr/xmlns:outlinePr","summaryRight"))
		jResumo["direita"]	:= !(cTmp=="0" .or. cTmp=="false")
		jMeta["resumo"]	:= jResumo
	EndIf

	//Painel congelado
	cY	:= oXml:XPathGetAtt("/xmlns:worksheet/xmlns:sheetViews/xmlns:sheetView/xmlns:pane","ySplit")
	cX	:= oXml:XPathGetAtt("/xmlns:worksheet/xmlns:sheetViews/xmlns:sheetView/xmlns:pane","xSplit")
	If "frozen" $ oXml:XPathGetAtt("/xmlns:worksheet/xmlns:sheetViews/xmlns:sheetView/xmlns:pane","state") .and. (Val(cY)>0 .or. Val(cX)>0)
		jPane		:= JsonObject():New()
		jPane["x"]	:= Val(cX)
		jPane["y"]	:= Val(cY)
		jMeta["pane"]	:= jPane
	EndIf

	//Filtro automático
	cRef	:= oXml:XPathGetAtt("/xmlns:worksheet/xmlns:autoFilter","ref")
	If !Empty(cRef)
		jMeta["filtro"]	:= cRef
		aRef	:= oExcel:LocRef(cRef)
		nMaxLin	:= Max(nMaxLin,Max(aRef[1],aRef[3]))
		nMaxCol	:= Max(nMaxCol,Max(aRef[2],aRef[4]))
	EndIf

	//Tabelas formatadas
	For nCont:=1 to Len(oExcel:aPlanilhas[nPlan][5])
		oTab	:= oExcel:aPlanilhas[nPlan][5][nCont]
		cRef	:= oTab:GetAtributo("ref","")
		If Empty(cRef)
			cRef	:= oExcel:Ref(oTab:aRef[1][1],oTab:aRef[1][2])+":"+oExcel:Ref(Max(oTab:aRef[2][1],oTab:aRef[1][1]),Max(oTab:aRef[2][2],oTab:aRef[1][2]))
		EndIf
		jTab	:= JsonObject():New()
		jTab["ref"]		:= cRef
		jTab["nome"]	:= oTab:cNomeTabela
		cEstilo	:= "TableStyleMedium2"
		If ValType(oTab:otableStyleInfo)=="O"
			cEstilo	:= oTab:otableStyleInfo:GetAtributo("name","TableStyleMedium2")
			jTab["listras"]	:= cValToChar(oTab:otableStyleInfo:GetAtributo("showRowStripes","1"))=="1"
		Else
			jTab["listras"]	:= .T.
		EndIf
		jTab["estilo"]	:= cEstilo
		nNum	:= Val(SubStr(cEstilo,At("Style",cEstilo)+5+If("Medium"$cEstilo,6,If("Light"$cEstilo,5,4))))
		jTab["familia"]	:= If("Light" $ cEstilo,"lig",If("Dark" $ cEstilo,"drk","med"))
		jTab["acento"]	:= If(nNum>0,Mod(nNum-1,7),1)
		jTab["cab"]		:= .T.
		jTab["totais"]	:= cValToChar(oTab:GetAtributo("totalsRowCount",0))=="1"
		jTab["filtro"]	:= oTab:lAutoFilter
		//Estrutura para as referências estruturadas (Tab[Coluna]) do cálculo das fórmulas no navegador
		aColTab	:= {}
		For nCont2:=1 to Len(oTab:aColunas)
			AADD(aColTab,DeUtf8(oTab:aColunas[nCont2]))
		Next
		jTab["colunas"]	:= aColTab
		jTab["lc"]		:= oTab:aRef[1][1]
		jTab["li"]		:= oTab:aRef[1][1]+1
		jTab["lf"]		:= oTab:aRef[2][1]
		jTab["lt"]		:= If(cValToChar(oTab:GetAtributo("totalsRowCount",0))=="1",oTab:aRef[2][1]+1,0)
		jTab["c1"]		:= oTab:aRef[1][2]
		AADD(aTab,jTab)
		aRef	:= oExcel:LocRef(cRef)
		nMaxLin	:= Max(nMaxLin,aRef[3])
		nMaxCol	:= Max(nMaxCol,aRef[4])
	Next
	If !Empty(aTab)
		jMeta["tabelas"]	:= aTab
	EndIf

	//Nomes definidos (cálculo das fórmulas no navegador)
	jNomes	:= NomesHtml(oExcel,nPlan)
	If ValType(jNomes)=="J"
		jMeta["nomes"]	:= jNomes
	EndIf

	//Hyperlinks
	aChild	:= oXml:XPathGetChildArray("/xmlns:worksheet/xmlns:hyperlinks")
	If !Empty(aChild)
		aCtx[CT_LNK]	:= JsonObject():New()
		For nCont:=1 to Len(aChild)
			cRef	:= oXml:XPathGetAtt(aChild[nCont][2],"ref")
			aRef	:= oExcel:LocRef(cRef)
			If aRef[1]>0
				aCtx[CT_LNK][cValToChar(aRef[1])+"|"+cValToChar(aRef[2])]	:= {DeUtf8(oXml:XPathGetAtt(aChild[nCont][2],"location")),DeUtf8(oXml:XPathGetAtt(aChild[nCont][2],"tooltip")),DeUtf8(oXml:XPathGetAtt(aChild[nCont][2],"display"))}
				nMaxLin	:= Max(nMaxLin,aRef[1])
				nMaxCol	:= Max(nMaxCol,aRef[2])
			EndIf
		Next
	EndIf
	FwFreeArray(aChild)

	//Comentários
	If ValType(oExcel:asheet[nPlan][3])=="O"
		aChild	:= oExcel:asheet[nPlan][3]:XPathGetChildArray("/xmlns:comments/xmlns:commentList")
		If !Empty(aChild)
			aCtx[CT_COM]	:= JsonObject():New()
			For nCont:=1 to Len(aChild)
				aRef	:= oExcel:LocRef(oExcel:asheet[nPlan][3]:XPathGetAtt(aChild[nCont][2],"ref"))
				cTexto	:= ""
				aChild2	:= oExcel:asheet[nPlan][3]:XPathGetChildArray(aChild[nCont][2]+"/xmlns:text")
				For nCont2:=1 to Len(aChild2)
					If aChild2[nCont2][1]=="r"
						cTexto	+= oExcel:asheet[nPlan][3]:XPathGetNodeValue(aChild2[nCont2][2]+"/xmlns:t")
					ElseIf aChild2[nCont2][1]=="t"
						cTexto	+= aChild2[nCont2][3]
					EndIf
				Next
				FwFreeArray(aChild2)
				If aRef[1]>0
					aCtx[CT_COM][cValToChar(aRef[1])+"|"+cValToChar(aRef[2])]	:= DeUtf8(cTexto)
					nMaxLin	:= Max(nMaxLin,aRef[1])
					nMaxCol	:= Max(nMaxCol,aRef[2])
				EndIf
			Next
		EndIf
		FwFreeArray(aChild)
	EndIf

	//Formatação condicional
	CondFormat(oExcel,oXml,jMeta)

	//Imagens
	For nCont:=1 to Len(oExcel:aImgPos)
		If oExcel:aImgPos[nCont][1]!=nPlan
			Loop
		EndIf
		cTexto	:= cValToChar(oExcel:aImgPos[nCont][2])
		If !jImg:HasProperty(cTexto)
			jImg[cTexto]	:= ImgBase64(oExcel,oExcel:aImgPos[nCont][2])
		EndIf
		cBase64	:= jImg[cTexto]
		If Empty(cBase64)
			Loop
		EndIf
		AADD(aObjs,'<div class="xh-obj xh-img" data-r1="'+cValToChar(oExcel:aImgPos[nCont][3])+'" data-c1="'+cValToChar(oExcel:aImgPos[nCont][4])+'" data-w="'+cValToChar(oExcel:aImgPos[nCont][5])+'" data-h="'+cValToChar(oExcel:aImgPos[nCont][6])+'">'+;
			'<img alt="" src="'+cBase64+'" style="'+ImgEstilo(oExcel:aImgPos[nCont])+'"></div>'+Chr(10))
		nMaxLin	:= Max(nMaxLin,oExcel:aImgPos[nCont][3])
		nMaxCol	:= Max(nMaxCol,oExcel:aImgPos[nCont][4])
	Next
	FreeObj(jImg)

	//Gráficos
	For nCont:=1 to Len(oExcel:aCharts)
		If oExcel:aCharts[nCont][2]!=nPlan
			Loop
		EndIf
		AADD(aGraf,ChartJson(oExcel:aCharts[nCont][1]))
		AADD(aObjs,'<div class="xh-obj xh-graf" data-graf="'+cValToChar(Len(aGraf)-1)+'" data-r1="'+cValToChar(oExcel:aCharts[nCont][3])+'" data-c1="'+cValToChar(oExcel:aCharts[nCont][4])+'" data-r2="'+cValToChar(oExcel:aCharts[nCont][5])+'" data-c2="'+cValToChar(oExcel:aCharts[nCont][6])+'"></div>'+Chr(10))
		nMaxLin	:= Max(nMaxLin,oExcel:aCharts[nCont][5])
		nMaxCol	:= Max(nMaxCol,oExcel:aCharts[nCont][6])
	Next
	If !Empty(aGraf)
		jMeta["graficos"]	:= aGraf
	EndIf

	aCtx[CT_MAXLIN]	:= nMaxLin
	aCtx[CT_MAXCOL]	:= nMaxCol
	//Células que precisam de id: âncoras e destinos de hyperlink são resolvidos no cliente pela grade, id apenas para âncora html (#xh1_A1)
Return aCtx

/*/{Protheus.doc} LimpaCtx
Libera os Json e o array do contexto da planilha
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param aCtx, array, Contexto da planilha (posições CT_*)
/*/
/*/{Protheus.doc} NomesHtml
Nomes definidos visíveis na planilha (globais e locais; o local prevalece) com a fórmula de cada um
@type function
@author Saulo Gomes Martins
@since 25/10/2026
@param oExcel, object, Instância de custom.excel.Xlsx
@param nPlan, numeric, Número da planilha
@return variant, Json {"NOME": "fórmula"} ou Nil quando não há nomes
/*/
Static Function NomesHtml(oExcel As Object, nPlan As Numeric)
	Local cBase := "/xmlns:workbook/xmlns:definedNames/xmlns:definedName" As Character
	Local cPath As Character
	Local nCont As Numeric
	Local nQtd As Numeric
	Local cNome As Character
	Local cLocal As Character
	Local aLocais := {} As Array
	Local jRet As Variant
	nQtd	:= oExcel:oworkbook:XPathChildCount("/xmlns:workbook/xmlns:definedNames")
	For nCont:=1 to nQtd
		cPath	:= cBase+"["+cValToChar(nCont)+"]"
		cNome	:= Upper(oExcel:oworkbook:XPathGetAtt(cPath,"name"))
		cLocal	:= oExcel:oworkbook:XPathGetAtt(cPath,"localSheetId")
		If Left(cNome,6)=="_XLNM." .or. (!Empty(cLocal) .and. Val(cLocal)+1!=nPlan) .or. (Empty(cLocal) .and. aScan(aLocais,cNome)>0)
			Loop
		EndIf
		If !Empty(cLocal)
			AADD(aLocais,cNome)
		EndIf
		If ValType(jRet)!="J"
			jRet	:= JsonObject():New()
		EndIf
		jRet[cNome]	:= oExcel:oworkbook:XPathGetNodeValue(cPath)
	Next
	FwFreeArray(aLocais)
Return jRet

Static Function LimpaCtx(aCtx As Array)
	Local nCont As Numeric
	For nCont:=CT_MERGE to CT_LNK
		If ValType(aCtx[nCont])=="J"
			FreeObj(aCtx[nCont])
		EndIf
	Next
	FwFreeArray(aCtx)
Return

/*/{Protheus.doc} PrepColunas
Resolve, por número de coluna, as configurações de input (lInput=.T.) ou os blocos de coluna
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param oHtml, object, Instância Html
@param nPlan, numeric, Número da planilha
@param nMaxCol, numeric, Última coluna da planilha
@param lInput, logical, .T. configurações de input, .F. blocos de coluna
@return array, Array por coluna
/*/
Static Function PrepColunas(oHtml As Object, nPlan As Numeric, nMaxCol As Numeric, lInput As Logical)
	Local aRet := {} As Array
	Local aLista := If(lInput,oHtml:aColInput,oHtml:aColBloco) As Array
	Local nCont As Numeric
	Local aCol As Array
	Local nCol As Numeric
	Local nLinIni As Numeric
	Local nLinFim As Numeric
	For nCont:=1 to Len(aLista)
		If aLista[nCont][1]!=0 .and. aLista[nCont][1]!=nPlan
			Loop
		EndIf
		nLinIni	:= 0
		nLinFim	:= 0
		nCol	:= ColunaHtml(oHtml:oExcel,nPlan,aLista[nCont][2],@nLinIni,@nLinFim)
		If nCol<=0
			Loop
		EndIf
		While Len(aRet)<nCol
			AADD(aRet,nil)
		EndDo
		If lInput
			aCol	:= aClone(aLista[nCont])
			If aCol[4]<=0
				aCol[4]	:= nLinIni
			EndIf
			If aCol[5]<=0
				aCol[5]	:= nLinFim
			EndIf
			aRet[nCol]	:= aCol
		Else
			If ValType(aRet[nCol])!="A"
				aRet[nCol]	:= {}
			EndIf
			AADD(aRet[nCol],aLista[nCont][3])
		EndIf
	Next
Return aRet

/*/{Protheus.doc} ColunaHtml
Converte número, letra ou nome de coluna/campo de tabela formatada no número da coluna
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param oExcel, object, Instância de custom.excel.Xlsx
@param nPlan, numeric, Número da planilha
@param xColuna, variant, Número, letra ou nome da coluna/campo de tabela formatada
@param nLinIni, numeric, (referência) 1ª linha de dados quando coluna de tabela
@param nLinFim, numeric, (referência) última linha de dados quando coluna de tabela
@return numeric, número da coluna (0 se não encontrou)
/*/
Static Function ColunaHtml(oExcel As Object, nPlan As Numeric, xColuna As Variant, nLinIni As Numeric, nLinFim As Numeric)
	Local nCont As Numeric
	Local oTab As Object
	Local aCol As Variant
	Local cLetra As Character
	If ValType(xColuna)=="N"
		Return xColuna
	EndIf
	For nCont:=1 to Len(oExcel:aPlanilhas[nPlan][5])
		oTab	:= oExcel:aPlanilhas[nPlan][5][nCont]
		aCol	:= nil
		If !oTab:oColunas:Get(xColuna,@aCol)
			oTab:oColunasCampo:Get(xColuna,@aCol)
		EndIf
		If ValType(aCol)=="A"
			nLinIni	:= oTab:aRef[1][1]+1		//Primeira linha após o cabeçalho
			nLinFim	:= Max(oTab:aRef[2][1],nLinIni)	//Última linha de dados (o total fica em aRef[2][1]+1)
			Return aCol[2]
		EndIf
	Next
	cLetra	:= Upper(AllTrim(xColuna))
	If Len(cLetra)>=1 .and. Len(cLetra)<=3
		For nCont:=1 to Len(cLetra)
			If !(SubStr(cLetra,nCont,1) $ "ABCDEFGHIJKLMNOPQRSTUVWXYZ")
				Return 0
			EndIf
		Next
		Return oExcel:StringToNum(cLetra)
	EndIf
Return 0

//----------------------------------------------------------------------
//LINHAS E CÉLULAS
//----------------------------------------------------------------------
/*/{Protheus.doc} Linha
Gera o <tr> de uma linha. aRow: {nLinha,nNivel,lFechado,lOculta,nAltura,aCelulas}
aCelulas: {{nColuna,xValor,cTipo,nStyle,cFormula},...} ordenado por coluna
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param oHtml, object, Instância Html
@param aCtx, array, Contexto da planilha (posições CT_*)
@param aRow, array, Linha {nLinha,nNivel,lFechado,lOculta,nAltura,aCelulas}
/*/
Static Function Linha(oHtml As Object, aCtx As Array, aRow As Array)
	Local nLin := aRow[1] As Numeric
	Local aCel := aRow[6] As Array
	Local nMaxCol := aCtx[CT_MAXCOL] As Numeric
	Local nCol As Numeric
	Local nP := 1 As Numeric
	Local cTr As Character
	Local cTds := "" As Character
	Local jLin As Variant
	Local cKey As Character
	Local lCob := ValType(aCtx[CT_COB])=="J" As Logical
	Local cLin := cValToChar(nLin) As Character
	Local cClass := "" As Character
	Local cStyle := "" As Character

	If !Empty(aCel)
		nMaxCol	:= Max(nMaxCol,aCel[Len(aCel)][1])
	EndIf
	If aRow[4]
		cClass	:= "xh-hid"
	EndIf
	If aRow[5]>0
		cStyle	:= "height:"+cValToChar(Round(aRow[5]*4/3,0))+"px"
	EndIf
	If ValType(oHtml:bLinha)=="B"
		jLin	:= JsonObject():New()
		jLin["attr"]	:= JsonObject():New()
		jLin["class"]	:= cClass
		jLin["style"]	:= cStyle
		jLin["antes"]	:= ""
		jLin["depois"]	:= ""
		jLin["ignorar"]	:= .F.
		Eval(oHtml:bLinha,jLin,nLin,aCtx[CT_PLAN],oHtml:oExcel)
		If jLin["ignorar"]
			FreeObj(jLin)
			Return
		EndIf
		cClass	:= jLin["class"]
		cStyle	:= jLin["style"]
	EndIf
	cTr	:= '<tr data-r="'+cLin+'"'
	If aRow[2]>0
		cTr	+= ' data-lvl="'+cValToChar(aRow[2])+'"'
	EndIf
	If aRow[3]	//Linha de resumo de grupo recolhido
		cTr	+= ' data-fch="1"'
	EndIf
	If !Empty(cClass)
		cTr	+= ' class="'+cClass+'"'
	EndIf
	If !Empty(cStyle)
		cTr	+= ' style="'+cStyle+'"'
	EndIf
	If ValType(jLin)=="J"
		cTr	+= AttrJson(jLin["attr"])
	EndIf
	cTr	+= '>'
	For nCol:=1 to nMaxCol
		If lCob
			cKey	:= cLin+"|"+cValToChar(nCol)
			If aCtx[CT_COB]:HasProperty(cKey)
				If nP<=Len(aCel) .and. aCel[nP][1]==nCol
					nP++
				EndIf
				Loop
			EndIf
		EndIf
		If nP<=Len(aCel) .and. aCel[nP][1]==nCol
			cTds	+= Celula(oHtml,aCtx,nLin,aCel[nP])
			nP++
		Else
			cTds	+= Celula(oHtml,aCtx,nLin,{nCol,nil,"U",0,""})
		EndIf
	Next
	If ValType(jLin)=="J"
		oHtml:Escreve(cValToChar(jLin["antes"])+cTr+cTds+'</tr>'+cValToChar(jLin["depois"])+Chr(10))
		FreeObj(jLin)
	Else
		oHtml:Escreve(cTr+cTds+'</tr>'+Chr(10))
	EndIf
Return

/*/{Protheus.doc} Celula
Gera o <td> de uma célula
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param oHtml, object, Instância Html
@param aCtx, array, Contexto da planilha (posições CT_*)
@param nLin, numeric, Número da linha
@param aCel, array, {nColuna,xValor,cTipo,nStyle,cFormula}
@return character, HTML da célula
/*/
Static Function Celula(oHtml As Object, aCtx As Array, nLin As Numeric, aCel As Array)
	Local nCol := aCel[1] As Numeric
	Local xValor := aCel[2] As Variant
	Local cTipo := aCel[3] As Character
	Local nStyle := aCel[4] As Numeric
	Local cClass := "" As Character
	Local cAttr := "" As Character
	Local cTexto := "" As Character
	Local cCor := "" As Character
	Local cKey As Character
	Local cConteudo As Character
	Local aLnk As Variant
	Local aInp As Variant
	Local aMerge As Variant

	If nStyle>0
		cClass	:= "s"+cValToChar(nStyle)
	EndIf
	If cTipo $ "NDT"
		cClass	+= " xh-n"
		cAttr	+= ' data-v="'+NumAttr(xValor)+'"'
		If cTipo $ "DT"
			cAttr	+= ' data-t="d"'	//Data: habilita os filtros de data no JS
		EndIf
		cTexto	:= oHtml:FmtValor(xValor,cTipo,nStyle,@cCor)
	ElseIf cTipo=="L"
		cClass	+= " xh-b"
		cAttr	+= ' data-v="'+If(xValor,'1','0')+'"'
		cTexto	:= If(xValor,"VERDADEIRO","FALSO")
	ElseIf cTipo=="C"
		cTexto	:= xValor
	EndIf
	If Len(aCel)>=5 .and. ValType(aCel[5])=="C" .and. !Empty(aCel[5])	//Fórmula: recalculada no navegador (inputs e filtros)
		cAttr	+= ' data-f="'+HtmlEsc(aCel[5])+'"'
		oHtml:FmtFormula(nStyle)
	EndIf
	cKey	:= cValToChar(nLin)+"|"+cValToChar(nCol)
	If ValType(aCtx[CT_MERGE])=="J" .and. aCtx[CT_MERGE]:HasProperty(cKey)
		aMerge	:= aCtx[CT_MERGE][cKey]
		If aMerge[1]>1
			cAttr	+= ' rowspan="'+cValToChar(aMerge[1])+'"'
		EndIf
		If aMerge[2]>1
			cAttr	+= ' colspan="'+cValToChar(aMerge[2])+'"'
		EndIf
	EndIf
	If ValType(aCtx[CT_COM])=="J" .and. aCtx[CT_COM]:HasProperty(cKey)
		cClass	+= " xh-cm"
		cAttr	+= ' title="'+HtmlEsc(aCtx[CT_COM][cKey])+'"'
	EndIf
	If ValType(aCtx[CT_LNK])=="J" .and. aCtx[CT_LNK]:HasProperty(cKey)
		aLnk	:= aCtx[CT_LNK][cKey]
		If Empty(cTexto)
			cTexto	:= aLnk[3]
		EndIf
	EndIf
	If nCol<=Len(aCtx[CT_INP]) .and. ValType(aCtx[CT_INP][nCol])=="A"
		aInp	:= aCtx[CT_INP][nCol]
		If nLin<aInp[4] .or. (aInp[5]>0 .and. nLin>aInp[5])
			aInp	:= nil
		EndIf
	EndIf
	If aCtx[CT_LENTO] .and. (ValType(oHtml:bCelula)=="B" .or. ValType(aInp)=="A" .or. (nCol<=Len(aCtx[CT_BLC]) .and. ValType(aCtx[CT_BLC][nCol])=="A"))
		Return CelulaJson(oHtml,aCtx,nLin,aCel,AllTrim(cClass),cAttr,cTexto,cCor,aLnk,aInp)
	EndIf
	cConteudo	:= HtmlEsc(cTexto)
	If !Empty(cCor)
		cConteudo	:= '<span style="color:'+cCor+'">'+cConteudo+'</span>'
	EndIf
	If ValType(aLnk)=="A"
		cConteudo	:= '<a class="xh-lk" href="#" data-loc="'+HtmlEsc(aLnk[1])+'"'+If(Empty(aLnk[2]),'',' title="'+HtmlEsc(aLnk[2])+'"')+'>'+cConteudo+'</a>'
	EndIf
	If nStyle>0 .and. ValType(oHtml:jRot)=="J" .and. oHtml:jRot:HasProperty(cValToChar(nStyle))
		cConteudo	:= '<span class="xh-rot">'+cConteudo+'</span>'
	EndIf
	cClass	:= AllTrim(cClass)
Return '<td'+If(Empty(cClass),'',' class="'+cClass+'"')+cAttr+'>'+cConteudo+'</td>'

/*/{Protheus.doc} CelulaJson
Montagem da célula através de Json, executando os blocos de célula/coluna e o input
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param oHtml, object, Instância Html
@param aCtx, array, Contexto da planilha (posições CT_*)
@param nLin, numeric, Número da linha
@param aCel, array, {nColuna,xValor,cTipo,nStyle,cFormula}
@param cClass, character, Classes CSS da célula
@param cAttr, character, Atributos já montados da célula
@param cTexto, character, Texto formatado do valor
@param cCor, character, Cor do formato numérico
@param aLnk, variant, Hyperlink da célula {location,tooltip,display} ou Nil
@param aInp, variant, Configuração de input da coluna ou Nil
@return character, HTML da célula
/*/
Static Function CelulaJson(oHtml As Object, aCtx As Array, nLin As Numeric, aCel As Array, cClass As Character, cAttr As Character, cTexto As Character, cCor As Character, aLnk As Variant, aInp As Variant)
	Local oExcel := oHtml:oExcel As Object
	Local nCol := aCel[1] As Numeric
	Local jCel := JsonObject():New() As Json
	Local jInp As Variant
	Local nCont As Numeric
	Local cRet As Character
	Local cConteudo As Character
	Local aBlocos As Variant
	Local xValor As Variant

	jCel["valor"]	:= ValorAdvpl(aCel[2],aCel[3])
	jCel["tipo"]	:= aCel[3]
	jCel["texto"]	:= cTexto
	jCel["formula"]	:= aCel[5]
	jCel["estilo"]	:= aCel[4]
	jCel["ref"]		:= oExcel:Ref(nLin,nCol)
	jCel["tag"]		:= "td"
	jCel["attr"]	:= AttrStr2Json(cAttr)
	jCel["class"]	:= cClass
	jCel["style"]	:= If(Empty(cCor),"","color:"+cCor)
	jCel["antes"]	:= ""
	jCel["depois"]	:= ""
	jCel["ignorar"]	:= .F.
	If ValType(aInp)=="A"
		jInp	:= JsonObject():New()
		jInp["tipo"]			:= TipoInput(aInp[3],aCel[3])
		jInp["nome"]			:= If(Empty(aInp[6]),jCel["ref"],aInp[6]+"_"+cValToChar(nLin))
		jInp["somenteLeitura"]	:= aInp[7]
		jInp["opcoes"]			:= aClone(aInp[8])
		jCel["input"]	:= jInp
	EndIf
	If ValType(oHtml:bCelula)=="B"
		Eval(oHtml:bCelula,jCel,nLin,nCol,aCtx[CT_PLAN],oExcel)
	EndIf
	If nCol<=Len(aCtx[CT_BLC]) .and. ValType(aCtx[CT_BLC][nCol])=="A"
		aBlocos	:= aCtx[CT_BLC][nCol]
		For nCont:=1 to Len(aBlocos)
			Eval(aBlocos[nCont],jCel,nLin,nCol,aCtx[CT_PLAN],oExcel)
		Next
	EndIf
	If jCel["ignorar"]
		FreeObj(jCel)
		Return '<td></td>'
	EndIf
	If jCel:HasProperty("html") .and. ValType(jCel["html"])=="C"
		cConteudo	:= jCel["html"]
	ElseIf jCel:HasProperty("input") .and. ValType(jCel["input"])=="J"
		xValor	:= jCel["valor"]
		If aCel[3]=="D" .and. ValType(xValor)!="D"
			xValor	:= ValorAdvpl(aCel[2],"D")	//Json pode não manter o tipo data
		EndIf
		cConteudo	:= InputHtml(jCel["input"],xValor,jCel["tipo"])
	Else
		cConteudo	:= HtmlEsc(cValToChar(jCel["texto"]))
		If ValType(aLnk)=="A"
			cConteudo	:= '<a class="xh-lk" href="#" data-loc="'+HtmlEsc(aLnk[1])+'"'+If(Empty(aLnk[2]),'',' title="'+HtmlEsc(aLnk[2])+'"')+'>'+cConteudo+'</a>'
		EndIf
	EndIf
	If aCel[4]>0 .and. ValType(oHtml:jRot)=="J" .and. oHtml:jRot:HasProperty(cValToChar(aCel[4])) .and. !(jCel:HasProperty("html") .and. ValType(jCel["html"])=="C") .and. !(jCel:HasProperty("input") .and. ValType(jCel["input"])=="J")
		cConteudo	:= '<span class="xh-rot">'+cConteudo+'</span>'
	EndIf
	cRet	:= '<'+jCel["tag"]
	If !Empty(jCel["class"])
		cRet	+= ' class="'+HtmlEsc(jCel["class"])+'"'
	EndIf
	If !Empty(jCel["style"])
		cRet	+= ' style="'+HtmlEsc(jCel["style"])+'"'
	EndIf
	cRet	+= AttrJson(jCel["attr"])+'>'+cValToChar(jCel["antes"])+cConteudo+cValToChar(jCel["depois"])+'</'+jCel["tag"]+'>'
	FreeObj(jCel)
Return cRet

/*/{Protheus.doc} TipoInput
Resolve o tipo do input quando "auto"
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param cTipo, character, Tipo do input configurado (auto, text, number...)
@param cTipoValor, character, Tipo do valor (N,D,T,C,L...)
@return character, Tipo do input
/*/
Static Function TipoInput(cTipo As Character, cTipoValor As Character)
	If !(cTipo=="auto")
		Return cTipo
	EndIf
	Do Case
		Case cTipoValor=="N"	;	Return "number"
		Case cTipoValor=="D"	;	Return "date"
		Case cTipoValor=="T"	;	Return "datetime"
		Case cTipoValor=="L"	;	Return "checkbox"
	EndCase
Return "text"

/*/{Protheus.doc} InputHtml
Monta o HTML do input
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param jInp, json, {tipo,nome,somenteLeitura,opcoes}
@param xValor, variant, Valor (tipo AdvPL)
@param cTipoValor, character, Tipo do valor
@return character, HTML do input
/*/
Static Function InputHtml(jInp As Json, xValor As Variant, cTipoValor As Character)
	Local cTipo := lower(cValToChar(jInp["tipo"])) As Character
	Local cNome := HtmlEsc(cValToChar(jInp["nome"])) As Character
	Local lRO := jInp:HasProperty("somenteLeitura") .and. ValType(jInp["somenteLeitura"])=="L" .and. jInp["somenteLeitura"] As Logical
	Local cRet As Character
	Local cValor := "" As Character
	Local aOpc As Variant
	Local nCont As Numeric
	Local cOpcV As Character
	Local cOpcT As Character
	If ValType(xValor)=="D"
		cValor	:= If(Empty(xValor),"",Transform(DToS(xValor),"@R 9999-99-99"))
	ElseIf ValType(xValor)=="N" .and. cTipoValor=="T"
		cValor	:= DtHrIso(xValor)
	ElseIf ValType(xValor)=="N"
		cValor	:= cValToChar(xValor)
	ElseIf ValType(xValor)=="C"
		cValor	:= xValor
	EndIf
	Do Case
		Case cTipo=="checkbox"
			cRet	:= '<input class="xh-in" type="checkbox" name="'+cNome+'" value="1"'+If(ValType(xValor)=="L" .and. xValor,' checked','')+If(lRO,' disabled','')+'>'
		Case cTipo=="textarea"
			cRet	:= '<textarea class="xh-in" name="'+cNome+'"'+If(lRO,' readonly','')+'>'+HtmlEsc(cValor)+'</textarea>'
		Case cTipo=="select"
			cRet	:= '<select class="xh-in" name="'+cNome+'"'+If(lRO,' disabled','')+'>'
			aOpc	:= If(jInp:HasProperty("opcoes"),jInp["opcoes"],{})
			For nCont:=1 to Len(aOpc)
				If ValType(aOpc[nCont])=="A"
					cOpcV	:= cValToChar(aOpc[nCont][1])
					cOpcT	:= cValToChar(aOpc[nCont][Len(aOpc[nCont])])
				Else
					cOpcV	:= cValToChar(aOpc[nCont])
					cOpcT	:= cOpcV
				EndIf
				cRet	+= '<option value="'+HtmlEsc(cOpcV)+'"'+If(AllTrim(cOpcV)==AllTrim(cValor),' selected','')+'>'+HtmlEsc(cOpcT)+'</option>'
			Next
			cRet	+= '</select>'
		Otherwise
			If cTipo=="datetime"
				cTipo	:= "datetime-local"
			EndIf
			cRet	:= '<input class="xh-in" type="'+cTipo+'" name="'+cNome+'" value="'+HtmlEsc(cValor)+'"'+If(cTipo=="number",' step="any"','')+If(lRO,' readonly','')+'>'
	EndCase
Return cRet

/*/{Protheus.doc} ValorAdvpl
Converte o valor lido (serial para datas) no tipo AdvPL exposto nos blocos
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param xValor, variant, Valor lido (serial numérico para datas)
@param cTipo, character, Tipo do valor (C,N,L,D,T,U)
@return variant, Valor convertido para o tipo AdvPL
/*/
Static Function ValorAdvpl(xValor As Variant, cTipo As Character)
	If cTipo=="D" .and. ValType(xValor)=="N"
		Return STOD("18991230")+Int(xValor)
	EndIf
Return xValor

/*/{Protheus.doc} NumAttr
Número em texto com até 15 dígitos significativos (separador "."), sem a perda de casas do cValToChar (8 decimais).
Mesma regra do formato Geral do cálculo de fórmulas (custom.excel.calc), usada no data-v lido pelo JavaScript
@type function
@author Saulo Gomes Martins
@since 25/10/2026
@param nNum, numeric, Número
@return character, Número em texto
/*/
Static Function NumAttr(nNum As Numeric)
	Local nAbs := Abs(nNum) As Numeric
	Local nExp As Numeric
	Local nDig As Numeric
	Local cDig As Character
	Local cSinal := If(nNum<0,"-","") As Character
	If nNum==Int(nNum) .and. nAbs<1000000000000000
		Return cValToChar(nNum)
	EndIf
	nExp	:= Int(Log10(nAbs))
	If 10^nExp>nAbs
		nExp--
	EndIf
	If nExp<=14	//Potência positiva de 10 é exata
		nDig	:= Round(nAbs*(10^(14-nExp)),0)
	Else
		nDig	:= Round(nAbs/(10^(nExp-14)),0)
	EndIf
	If nDig>=1000000000000000
		nDig	:= Round(nDig/10,0)
		nExp++
	EndIf
	cDig	:= cValToChar(nDig)
	While Len(cDig)>1 .and. Right(cDig,1)=="0"
		cDig	:= Left(cDig,Len(cDig)-1)
	EndDo
	If nExp>=15 .or. nExp<-9	//Notação científica
		Return cSinal+Left(cDig,1)+If(Len(cDig)>1,"."+SubStr(cDig,2),"")+"E"+If(nExp<0,"-","+")+StrZero(Abs(nExp),2)
	EndIf
	If nExp<0
		Return cSinal+"0."+Replicate("0",-nExp-1)+cDig
	EndIf
	If Len(cDig)<=nExp+1
		Return cSinal+cDig+Replicate("0",nExp+1-Len(cDig))
	EndIf
Return cSinal+Left(cDig,nExp+1)+"."+SubStr(cDig,nExp+2)

/*/{Protheus.doc} DtHrIso
Converte o serial de data/hora do Excel no formato ISO (AAAA-MM-DDTHH:MM)
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param nSerial, numeric, Serial de data/hora do Excel
@return character, Data e hora no formato ISO
/*/
Static Function DtHrIso(nSerial As Numeric)
	Local dData := STOD("18991230")+Int(nSerial) As Date
	Local nSeg := Round((nSerial-Int(nSerial))*86400,0) As Numeric
	If nSeg>=86400
		dData++
		nSeg	-= 86400
	EndIf
Return Transform(DToS(dData),"@R 9999-99-99")+"T"+StrZero(Int(nSeg/3600),2)+":"+StrZero(Int(Mod(nSeg,3600)/60),2)

/*/{Protheus.doc} AttrJson
Converte um Json de atributos em texto ( chave="valor")
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param jAttr, variant, Json de atributos (ignorado quando não for Json)
@return character, Atributos em texto
/*/
Static Function AttrJson(jAttr As Variant)
	Local cRet := "" As Character
	Local aNomes As Array
	Local nCont As Numeric
	Local xValor As Variant
	If ValType(jAttr)!="J"
		Return ""
	EndIf
	aNomes	:= jAttr:GetNames()
	For nCont:=1 to Len(aNomes)
		xValor	:= jAttr[aNomes[nCont]]
		If ValType(xValor)=="L"
			If xValor
				cRet	+= ' '+aNomes[nCont]
			EndIf
		ElseIf ValType(xValor)!="U"
			cRet	+= ' '+aNomes[nCont]+'="'+HtmlEsc(cValToChar(xValor))+'"'
		EndIf
	Next
	FwFreeArray(aNomes)
Return cRet

/*/{Protheus.doc} AttrStr2Json
Converte os atributos montados (texto) em Json para os blocos de código
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param cAttr, character, Atributos em texto ( chave="valor")
@return json, Json de atributos
/*/
Static Function AttrStr2Json(cAttr As Character)
	Local jRet := JsonObject():New() As Json
	Local nPos As Numeric
	Local nFim As Numeric
	Local cNome As Character
	While (nPos:=At('="',cAttr))>0
		cNome	:= AllTrim(SubStr(cAttr,1,nPos-1))
		nFim	:= At('"',cAttr,nPos+2)
		jRet[cNome]	:= DesEscHtml(SubStr(cAttr,nPos+2,nFim-nPos-2))
		cAttr	:= SubStr(cAttr,nFim+1)
	EndDo
Return jRet

//----------------------------------------------------------------------
//LEITURA DAS CÉLULAS
//----------------------------------------------------------------------
/*/{Protheus.doc} LeitorAbrir
Prepara a leitura das linhas da planilha conforme o tipo do Excel
A=arquivo de linhas (tmprowN.xml), M=xml da planilha (gravado em arquivo temporário), B=tabelas temporárias
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param oHtml, object, Instância Html
@param nPlan, numeric, Número da planilha
@return array, aSt
/*/
Static Function LeitorAbrir(oHtml As Object, nPlan As Numeric)
	Local oExcel := oHtml:oExcel As Object
	Local aSt := Array(ST_TAM) As Array
	Local cArq As Character
	Local cQuery As Character
	Local cAliasMax As Character
	Local aRow As Variant
	aSt[ST_HANDLE]	:= -1
	aSt[ST_BUF]		:= ""
	aSt[ST_POS]		:= 1
	aSt[ST_EOF]		:= .F.
	aSt[ST_ALIAS]	:= ""
	aSt[ST_LINHAS]	:= nil
	aSt[ST_ARQTMP]	:= ""
	aSt[ST_MAXCOL]	:= 0
	aSt[ST_HTML]	:= oHtml
	If oExcel:lBD
		aSt[ST_MODO]	:= "B"
		cAliasMax	:= GetNextAlias()
		If oExcel:ExecSql(cAliasMax,"SELECT MAX(COL) MAXCOL FROM "+oExcel:cTabCol+" WHERE PLA="+cValToChar(nPlan)+" AND D_E_L_E_T_=' '",oExcel:cDriver)
			If (cAliasMax)->(!Eof())
				aSt[ST_MAXCOL]	:= (cAliasMax)->MAXCOL
			EndIf
			(cAliasMax)->(DbCloseArea())
		EndIf
		cQuery	:= "SELECT L.LIN,L.OLEVEL,L.COLLAP,L.CHIDDEN,L.CHEIGHT,L.HT,C.COL,C.STY,C.TIPO,C.FORMULA,C.TPVLR,C.VLR"
		cQuery	+= " FROM "+oExcel:cTabLin+" L"
		cQuery	+= " LEFT JOIN "+oExcel:cTabCol+" C ON C.PLA=L.PLA AND C.LIN=L.LIN AND C.D_E_L_E_T_=' '"
		cQuery	+= " WHERE L.PLA="+cValToChar(nPlan)+" AND L.D_E_L_E_T_=' '"
		cQuery	+= " ORDER BY L.LIN,C.COL"
		aSt[ST_ALIAS]	:= GetNextAlias()
		If !oExcel:ExecSql(aSt[ST_ALIAS],cQuery,oExcel:cDriver)
			UserException("Xlsx - Erro ao ler as células para o html. "+TCSqlError())
		EndIf
	ElseIf oExcel:lArquivo
		aSt[ST_MODO]	:= "A"
		cArq	:= "\tmpxls\"+oExcel:cTmpFile+"\"+oExcel:cNomeFile+"\xl\worksheets\tmprow"+cValToChar(nPlan)+".xml"
		If !File(cArq,,.F.)
			cArq	:= oExcel:DirHtml()+"tmprow"+cValToChar(nPlan)+".xml"
		EndIf
		If !File(cArq,,.F.)
			UserException("Xlsx - Dados da planilha "+cValToChar(nPlan)+" não encontrados para gerar o html. No tipo 'A', mantenha oExcel:lHtml igual a .T. antes do Save() para preservar os dados.")
		EndIf
		If nPlan<=Len(oExcel:aMaxCol)
			aSt[ST_MAXCOL]	:= oExcel:aMaxCol[nPlan]
		EndIf
		aSt[ST_HANDLE]	:= FOpen(cArq,FO_READ+FO_SHARED,,.F.)
		If aSt[ST_HANDLE]<0
			UserException("Xlsx - Erro ao abrir "+cArq+" Ferror: "+cValToChar(FError()))
		EndIf
	Else
		aSt[ST_MODO]	:= "M"
		FWMakeDir(oExcel:DirHtml(),.F.)
		cArq	:= oExcel:DirHtml()+"sheet"+cValToChar(nPlan)+".xml"
		oExcel:asheet[nPlan][1]:Save2File(cArq)
		aSt[ST_ARQTMP]	:= cArq
		aSt[ST_HANDLE]	:= FOpen(cArq,FO_READ+FO_SHARED,,.F.)
		If aSt[ST_HANDLE]<0
			UserException("Xlsx - Erro ao abrir "+cArq+" Ferror: "+cValToChar(FError()))
		EndIf
		//No tipo M as linhas/células não ficam ordenadas no xml
		aSt[ST_LINHAS]	:= {}
		While ValType(aRow:=XmlProxRow(aSt))=="A"
			aSort(aRow[6],,,{|x,y| x[1]<y[1]})
			If !Empty(aRow[6])
				aSt[ST_MAXCOL]	:= Max(aSt[ST_MAXCOL],aRow[6][Len(aRow[6])][1])
			EndIf
			AADD(aSt[ST_LINHAS],aRow)
		EndDo
		aSort(aSt[ST_LINHAS],,,{|x,y| x[1]<y[1]})
		aSt[ST_POS]	:= 1
	EndIf
Return aSt

/*/{Protheus.doc} LeitorProx
Retorna a próxima linha {nLinha,nNivel,lFechado,lOculta,nAltura,aCelulas} ou Nil no fim
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param aSt, array, Estado da leitura (posições ST_*)
@return array, Próxima linha {nLinha,nNivel,lFechado,lOculta,nAltura,aCelulas} ou Nil no fim
/*/
Static Function LeitorProx(aSt As Array)
	Local aRet As Variant
	If aSt[ST_MODO]=="M"
		If aSt[ST_POS]>Len(aSt[ST_LINHAS])
			Return nil
		EndIf
		aRet	:= aSt[ST_LINHAS][aSt[ST_POS]]
		aSt[ST_LINHAS][aSt[ST_POS]]	:= nil
		aSt[ST_POS]++
		Return aRet
	ElseIf aSt[ST_MODO]=="A"
		Return XmlProxRow(aSt)
	EndIf
Return BdProxRow(aSt)

/*/{Protheus.doc} LeitorFechar
Encerra a leitura: fecha o arquivo e o alias, apaga o arquivo temporário e libera as linhas carregadas
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param oHtml, object, Instância Html
@param aSt, array, Estado da leitura (posições ST_*)
/*/
Static Function LeitorFechar(oHtml As Object, aSt As Array)
	If aSt[ST_HANDLE]>=0
		FClose(aSt[ST_HANDLE])
	EndIf
	If !Empty(aSt[ST_ALIAS]) .and. Select(aSt[ST_ALIAS])>0
		(aSt[ST_ALIAS])->(DbCloseArea())
	EndIf
	If !Empty(aSt[ST_ARQTMP])
		FErase(aSt[ST_ARQTMP],,.F.)
	EndIf
	If ValType(aSt[ST_LINHAS])=="A"
		FwFreeArray(aSt[ST_LINHAS])
	EndIf
	aSt[ST_LINHAS]	:= nil
	aSt[ST_HTML]	:= nil	//Não liberar a instância Html
	FwFreeArray(aSt)
Return

/*/{Protheus.doc} BdProxRow
Leitura da próxima linha no tipo B (tabelas temporárias)
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param aSt, array, Estado da leitura (posições ST_*)
@return array, Próxima linha {nLinha,nNivel,lFechado,lOculta,nAltura,aCelulas} ou Nil no fim
/*/
Static Function BdProxRow(aSt As Array)
	Local cAlias := aSt[ST_ALIAS] As Character
	Local oHtml := aSt[ST_HTML] As Object
	Local aRet As Array
	Local nLin As Numeric
	Local cTipo As Character
	Local xValor As Variant
	Local nSty As Numeric
	Local cTpVlr As Character
	Local lAchou As Logical
	If (cAlias)->(Eof())
		Return nil
	EndIf
	nLin	:= (cAlias)->LIN
	aRet	:= {nLin,Val((cAlias)->OLEVEL),(cAlias)->COLLAP=="1",(cAlias)->CHIDDEN=="1",If((cAlias)->CHEIGHT=="1",(cAlias)->HT,0),{}}
	While (cAlias)->(!Eof()) .and. (cAlias)->LIN==nLin
		If !Empty((cAlias)->COL)
			nSty	:= If(ValType((cAlias)->STY)=="N",(cAlias)->STY,0)
			cTpVlr	:= (cAlias)->TPVLR
			xValor	:= nil
			cTipo	:= "U"
			If cTpVlr=="U"
			ElseIf (cAlias)->TIPO=="s"
				lAchou	:= .F.
				xValor	:= oHtml:oExcel:GetStrComp(Val((cAlias)->VLR),@lAchou)
				xValor	:= If(lAchou .and. ValType(xValor)=="C",xValor,"")
				cTipo	:= "C"
			ElseIf (cAlias)->TIPO=="i" .or. cTpVlr=="C"
				xValor	:= RTrim((cAlias)->VLR)
				cTipo	:= "C"
			ElseIf (cAlias)->TIPO=="b"
				xValor	:= AllTrim((cAlias)->VLR)=="1"
				cTipo	:= "L"
			Else
				xValor	:= Val(AllTrim((cAlias)->VLR))
				cTipo	:= TipoNum(oHtml,Max(nSty,0))
			EndIf
			AADD(aRet[6],{(cAlias)->COL,xValor,cTipo,Max(nSty,0),DesEscXml(RTrim((cAlias)->FORMULA))})
		EndIf
		(cAlias)->(DbSkip())
	EndDo
Return aRet

/*/{Protheus.doc} TipoNum
Tipo do valor numérico conforme o formato do estilo: N, D (data) ou T (data e hora/hora)
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param oHtml, object, Instância Html
@param nStyle, numeric, Id do estilo
@return character, N, D ou T
/*/
Static Function TipoNum(oHtml As Object, nStyle As Numeric)
	Local cTipo As Character
	If ValType(oHtml)!="O"
		Return "N"
	EndIf
	cTipo	:= oHtml:InfoEstilo(nStyle)[1]
	If cTipo $ "DT"
		Return cTipo
	EndIf
Return "N"

/*/{Protheus.doc} XmlProxRow
Leitura em streaming do próximo <row> de um xml de planilha (tipo A e M)
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param aSt, array, Estado da leitura (posições ST_*)
@return array, Próxima linha {nLinha,nNivel,lFechado,lOculta,nAltura,aCelulas} ou Nil no fim
/*/
Static Function XmlProxRow(aSt As Array)
	Local oHtml := aSt[ST_HTML] As Object
	Local nIni As Numeric
	Local nFimTag As Numeric
	Local nFim As Numeric
	Local cRow As Character
	While .T.
		nIni	:= At("<row",aSt[ST_BUF],aSt[ST_POS])
		While nIni>0 .and. nIni+4<=Len(aSt[ST_BUF]) .and. !(SubStr(aSt[ST_BUF],nIni+4,1) $ " >/")
			nIni	:= At("<row",aSt[ST_BUF],nIni+4)	//Ignora <rowBreaks
		EndDo
		If nIni>0
			nFimTag	:= At(">",aSt[ST_BUF],nIni)
			If nFimTag>0
				If SubStr(aSt[ST_BUF],nFimTag-1,1)=="/"
					nFim	:= nFimTag
				Else
					nFim	:= FimTag(aSt[ST_BUF],"</row>",nFimTag)
					If nFim>0
						nFim	+= 5
					EndIf
				EndIf
				If nFim>0
					cRow		:= SubStr(aSt[ST_BUF],nIni,nFim-nIni+1)
					aSt[ST_POS]	:= nFim+1
					Return ParseRow(oHtml,cRow)
				EndIf
			EndIf
		EndIf
		If aSt[ST_EOF]
			Return nil
		EndIf
		LerBloco(aSt,If(nIni>0,nIni,Max(1,Len(aSt[ST_BUF])-5)))
	EndDo
Return nil

/*/{Protheus.doc} LerBloco
Lê o próximo bloco do arquivo mantendo o conteúdo a partir de nManter
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param aSt, array, Estado da leitura (posições ST_*)
@param nManter, numeric, Posição do buffer a partir da qual o conteúdo atual é mantido
/*/
Static Function LerBloco(aSt As Array, nManter As Numeric)
	Local cBloco := Space(HTML_TAMBUF) As Character
	Local nLidos As Numeric
	nLidos	:= FRead(aSt[ST_HANDLE],@cBloco,HTML_TAMBUF)
	If nLidos<=0
		aSt[ST_EOF]	:= .T.
		Return
	EndIf
	If nLidos<HTML_TAMBUF
		cBloco	:= Left(cBloco,nLidos)
	EndIf
	aSt[ST_BUF]	:= SubStr(aSt[ST_BUF],nManter)+cBloco
	aSt[ST_POS]	:= 1
Return

/*/{Protheus.doc} FimTag
Procura a tag de fechamento ignorando seções CDATA
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param cTexto, character, Texto xml
@param cFecha, character, Tag de fechamento procurada
@param nIni, numeric, Posição inicial da busca
@return numeric, posição inicial da tag de fechamento (0 se não encontrou)
/*/
Static Function FimTag(cTexto As Character, cFecha As Character, nIni As Numeric)
	Local nPos := nIni As Numeric
	Local nFecha As Numeric
	Local nCData As Numeric
	Local nFimCData As Numeric
	While .T.
		nFecha	:= At(cFecha,cTexto,nPos)
		nCData	:= At("<![CDATA[",cTexto,nPos)
		If nCData>0 .and. (nFecha==0 .or. nCData<nFecha)
			nFimCData	:= At("]]>",cTexto,nCData+9)
			If nFimCData==0
				Return 0
			EndIf
			nPos	:= nFimCData+3
			Loop
		EndIf
		Exit
	EndDo
Return nFecha

/*/{Protheus.doc} ParseRow
Interpreta o xml de um <row>
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param oHtml, object, Instância Html
@param cRow, character, Xml do <row>
@return array, {nLinha,nNivel,lFechado,lOculta,nAltura,aCelulas}
/*/
Static Function ParseRow(oHtml As Object, cRow As Character)
	Local nFimTag := At(">",cRow) As Numeric
	Local cTag := SubStr(cRow,1,nFimTag) As Character
	Local aRet As Array
	Local nPos := nFimTag+1 As Numeric
	Local nIni As Numeric
	Local nFim As Numeric
	Local nFimC As Numeric
	Local cCTag As Character
	Local cInterno As Character
	Local cR As Character
	Local cS As Character
	Local cT As Character
	Local cV As Character
	Local cF As Character
	Local nCol As Numeric
	Local nSty As Numeric
	Local xValor As Variant
	Local cTipo As Character
	Local oExcel := oHtml:oExcel As Object

	aRet	:= {Val(AttrXml(cTag,"r")),Val(AttrXml(cTag,"outlineLevel")),AttrXml(cTag,"collapsed")=="1",AttrXml(cTag,"hidden")=="1",If(AttrXml(cTag,"customHeight")=="1",Val(AttrXml(cTag,"ht")),0),{}}
	While .T.
		nIni	:= At("<c",cRow,nPos)
		If nIni==0
			Exit
		EndIf
		If !(SubStr(cRow,nIni+2,1) $ " >/")
			nPos	:= nIni+2
			Loop
		EndIf
		nFim	:= At(">",cRow,nIni)
		cCTag	:= SubStr(cRow,nIni,nFim-nIni+1)
		If SubStr(cRow,nFim-1,1)=="/"
			cInterno	:= ""
			nPos		:= nFim+1
		Else
			nFimC		:= FimTag(cRow,"</c>",nFim+1)
			If nFimC==0
				Exit
			EndIf
			cInterno	:= SubStr(cRow,nFim+1,nFimC-nFim-1)
			nPos		:= nFimC+4
		EndIf
		cR		:= AttrXml(cCTag,"r")
		cS		:= AttrXml(cCTag,"s")
		cT		:= AttrXml(cCTag,"t")
		nCol	:= oExcel:LocRef(cR)[2]
		nSty	:= If(Empty(cS),0,Val(cS))
		cF		:= ""
		If "<f" $ cInterno
			nFim	:= At("<is",cInterno)
			If nFim==0
				nFim	:= At("<v",cInterno)
			EndIf
			cF	:= ValorTag(If(nFim>0,Left(cInterno,nFim-1),cInterno),"f")	//Não procura dentro do texto
		EndIf
		xValor	:= nil
		cTipo	:= "U"
		If cT=="inlineStr" .or. "<is" $ cInterno
			xValor	:= TextoIs(cInterno)
			cTipo	:= "C"
		Else
			cV	:= ValorTag(cInterno,"v")
			If cT=="s"
				xValor	:= SharedStr(oExcel,cV)
				cTipo	:= "C"
			ElseIf cT=="str" .or. cT=="e"
				xValor	:= DeUtf8(cV)
				cTipo	:= "C"
			ElseIf cT=="b"
				xValor	:= cV=="1"
				cTipo	:= "L"
			ElseIf !Empty(cV)
				xValor	:= Val(cV)
				If "E" $ Upper(cV)
					xValor	:= NumCientifico(cV)
				EndIf
				cTipo	:= TipoNum(oHtml,nSty)
			EndIf
		EndIf
		AADD(aRet[6],{nCol,xValor,cTipo,nSty,cF})
	EndDo
Return aRet

/*/{Protheus.doc} NumCientifico
Converte um texto em notação científica (ex: 1.5E-3) em número
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param cV, character, Valor em texto
@return numeric, Valor numérico
/*/
Static Function NumCientifico(cV As Character)
	Local nPos := At("E",Upper(cV)) As Numeric
Return Val(SubStr(cV,1,nPos-1))*(10^Val(SubStr(cV,nPos+1)))

/*/{Protheus.doc} AttrXml
Retorna o valor de um atributo de uma tag xml
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param cTag, character, Tag xml
@param cNome, character, Nome do atributo
@return character, Valor do atributo ("" se não encontrou)
/*/
Static Function AttrXml(cTag As Character, cNome As Character)
	Local nPos := At(' '+cNome+'="',cTag) As Numeric
	Local nFim As Numeric
	If nPos==0
		Return ""
	EndIf
	nPos	+= Len(cNome)+3
	nFim	:= At('"',cTag,nPos)
Return SubStr(cTag,nPos,nFim-nPos)

/*/{Protheus.doc} ValorTag
Conteúdo da primeira tag <cTag> (texto decodificado)
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param cXml, character, Xml
@param cTag, character, Nome da tag
@return character, Texto da tag ("" se não encontrou)
/*/
Static Function ValorTag(cXml As Character, cTag As Character)
	Local nIni := At("<"+cTag,cXml) As Numeric
	Local nFimTag As Numeric
	Local nFim As Numeric
	While nIni>0 .and. !(SubStr(cXml,nIni+Len(cTag)+1,1) $ " >/")
		nIni	:= At("<"+cTag,cXml,nIni+1)
	EndDo
	If nIni==0
		Return ""
	EndIf
	nFimTag	:= At(">",cXml,nIni)
	If SubStr(cXml,nFimTag-1,1)=="/"
		Return ""
	EndIf
	nFim	:= FimTag(cXml,"</"+cTag+">",nFimTag+1)
	If nFim==0
		Return ""
	EndIf
Return TextoXml(SubStr(cXml,nFimTag+1,nFim-nFimTag-1))

/*/{Protheus.doc} TextoIs
Texto de um <is> (concatena os <t> de todos os <r>)
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param cXml, character, Xml do <is>
@return character, Texto concatenado
/*/
Static Function TextoIs(cXml As Character)
	Local cRet := "" As Character
	Local nPos := 1 As Numeric
	Local nIni As Numeric
	Local nFimTag As Numeric
	Local nFim As Numeric
	While (nIni:=At("<t",cXml,nPos))>0
		If !(SubStr(cXml,nIni+2,1) $ " >")
			nPos	:= nIni+2
			Loop
		EndIf
		nFimTag	:= At(">",cXml,nIni)
		nFim	:= FimTag(cXml,"</t>",nFimTag+1)
		If nFim==0
			Exit
		EndIf
		cRet	+= TextoXml(SubStr(cXml,nFimTag+1,nFim-nFimTag-1))
		nPos	:= nFim+4
	EndDo
Return cRet

/*/{Protheus.doc} TextoXml
Converte o conteúdo xml (CDATA ou com entidades) em texto CP-1252
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param cTexto, character, Conteúdo xml
@return character, Texto em CP-1252
/*/
Static Function TextoXml(cTexto As Character)
	Local cRet := "" As Character
	Local nPos := 1 As Numeric
	Local nIni As Numeric
	Local nFim As Numeric
	If !("<![CDATA[" $ cTexto)
		Return DeUtf8(DesEscXml(cTexto))
	EndIf
	While (nIni:=At("<![CDATA[",cTexto,nPos))>0
		cRet	+= DesEscXml(SubStr(cTexto,nPos,nIni-nPos))
		nFim	:= At("]]>",cTexto,nIni+9)
		If nFim==0
			nFim	:= Len(cTexto)+1
		EndIf
		cRet	+= SubStr(cTexto,nIni+9,nFim-nIni-9)
		nPos	:= nFim+3
	EndDo
	cRet	+= DesEscXml(SubStr(cTexto,nPos))
Return DeUtf8(cRet)

/*/{Protheus.doc} DesEscXml
Converte as entidades xml (&lt; &gt; &quot; &apos; &amp; e caracteres de controle) nos caracteres correspondentes
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param cTexto, character, Texto com entidades xml
@return character, Texto sem entidades
/*/
Static Function DesEscXml(cTexto As Character)
	If !("&" $ cTexto)
		Return cTexto
	EndIf
	cTexto	:= StrTran(cTexto,"&lt;","<")
	cTexto	:= StrTran(cTexto,"&gt;",">")
	cTexto	:= StrTran(cTexto,"&quot;",'"')
	cTexto	:= StrTran(cTexto,"&apos;","'")
	cTexto	:= StrTran(cTexto,"&#10;",Chr(10))
	cTexto	:= StrTran(cTexto,"&#xA;",Chr(10))
	cTexto	:= StrTran(cTexto,"&#13;",Chr(13))
	cTexto	:= StrTran(cTexto,"&#xD;",Chr(13))
	cTexto	:= StrTran(cTexto,"&#9;",Chr(9))
	cTexto	:= StrTran(cTexto,"&amp;","&")
Return cTexto

/*/{Protheus.doc} DesEscHtml
Converte as entidades html básicas (&lt; &gt; &quot; &amp;) nos caracteres correspondentes
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param cTexto, character, Texto com entidades html
@return character, Texto sem entidades
/*/
Static Function DesEscHtml(cTexto As Character)
	If !("&" $ cTexto)
		Return cTexto
	EndIf
	cTexto	:= StrTran(cTexto,"&lt;","<")
	cTexto	:= StrTran(cTexto,"&gt;",">")
	cTexto	:= StrTran(cTexto,"&quot;",'"')
	cTexto	:= StrTran(cTexto,"&amp;","&")
Return cTexto

/*/{Protheus.doc} SharedStr
Texto de string compartilhada (arquivo aberto com Open)
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param oExcel, object, Instância de custom.excel.Xlsx
@param cPos, character, Índice da string compartilhada (0 based)
@return character, Texto da string ("" se não existir)
/*/
Static Function SharedStr(oExcel As Object, cPos As Character)
	Local cPath As Character
	If ValType(oExcel:osharedStrings)!="O" .or. Empty(cPos)
		Return ""
	EndIf
	cPath	:= "/xmlns:sst/xmlns:si["+cValToChar(Val(cPos)+1)+"]"
	If oExcel:osharedStrings:XPathHasNode(cPath+"/xmlns:t")
		Return DeUtf8(oExcel:osharedStrings:XPathGetNodeValue(cPath+"/xmlns:t"))
	EndIf
Return DeUtf8(oExcel:osharedStrings:XPathGetNodeValue(cPath))

//----------------------------------------------------------------------
//ESTILOS
//----------------------------------------------------------------------
/*/{Protheus.doc} CssEstilos
Gera uma classe CSS (.sN) para cada estilo (cellXfs) com as propriedades diferentes do padrão
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param oHtml, object, Instância Html
@return character, CSS
/*/
Static Function CssEstilos(oHtml As Object)
	Local oStyle := oHtml:oExcel:oStyle As Object
	Local cBase := "/xmlns:styleSheet" As Character
	Local nQtd As Numeric
	Local nCont As Numeric
	Local cXPath As Character
	Local cRet := "" As Character
	Local cCss As Character
	Local jFont := JsonObject():New() As Json
	Local jFill := JsonObject():New() As Json
	Local jBorda := JsonObject():New() As Json
	Local cId As Character
	Local cFonte0 As Character
	Local cTam0 As Character
	Local nRot As Numeric

	cFonte0	:= oStyle:XPathGetAtt(cBase+"/xmlns:fonts/xmlns:font[1]/xmlns:name","val")
	cTam0	:= oStyle:XPathGetAtt(cBase+"/xmlns:fonts/xmlns:font[1]/xmlns:sz","val")
	If !Empty(cFonte0) .and. !(Upper(cFonte0)=="CALIBRI")
		cRet	+= ":where(.xh-t) td{font-family:'"+cFonte0+"',Calibri,Arial,sans-serif}"+Chr(10)
	EndIf
	If !Empty(cTam0) .and. !(cTam0=="11")
		cRet	+= ":where(.xh-t) td{font-size:"+cTam0+"pt}"+Chr(10)
	EndIf
	nQtd	:= oStyle:XPathChildCount(cBase+"/xmlns:cellXfs")
	For nCont:=1 to nQtd
		cXPath	:= cBase+"/xmlns:cellXfs/xmlns:xf["+cValToChar(nCont)+"]"
		cCss	:= ""
		cId		:= oStyle:XPathGetAtt(cXPath,"fontId")
		If !Empty(cId) .and. !(cId=="0")
			If !jFont:HasProperty(cId)
				jFont[cId]	:= CssFonte(oStyle,cBase+"/xmlns:fonts/xmlns:font["+cValToChar(Val(cId)+1)+"]",cFonte0,cTam0)
			EndIf
			cCss	+= jFont[cId]
		EndIf
		cId		:= oStyle:XPathGetAtt(cXPath,"fillId")
		If !Empty(cId) .and. Val(cId)>1
			If !jFill:HasProperty(cId)
				jFill[cId]	:= CssFill(oStyle,cBase+"/xmlns:fills/xmlns:fill["+cValToChar(Val(cId)+1)+"]",.F.)
			EndIf
			cCss	+= jFill[cId]
		EndIf
		cId		:= oStyle:XPathGetAtt(cXPath,"borderId")
		If !Empty(cId) .and. !(cId=="0")
			If !jBorda:HasProperty(cId)
				jBorda[cId]	:= CssBorda(oStyle,cBase+"/xmlns:borders/xmlns:border["+cValToChar(Val(cId)+1)+"]")
			EndIf
			cCss	+= jBorda[cId]
		EndIf
		nRot	:= 0
		If oStyle:XPathHasNode(cXPath+"/xmlns:alignment")
			cCss	+= CssAlinha(oStyle,cXPath+"/xmlns:alignment",@nRot)
		EndIf
		If nRot!=0	//Texto girado: a célula envolve o conteúdo em <span class="xh-rot">
			cCss	+= "overflow:visible;"
			cRet	+= ".s"+cValToChar(nCont-1)+">.xh-rot{display:inline-block;transform:rotate("+cValToChar(nRot)+"deg);transform-origin:0 100%}"+Chr(10)
			oHtml:jRot[cValToChar(nCont-1)]	:= nRot
		EndIf
		If !Empty(cCss)
			cRet	+= ".s"+cValToChar(nCont-1)+"{"+cCss+"}"+Chr(10)
		EndIf
	Next
	FreeObj(jFont)
	FreeObj(jFill)
	FreeObj(jBorda)
Return cRet

/*/{Protheus.doc} CssFonte
CSS da fonte (negrito, itálico, sublinhado, tachado, tamanho, cor e nome) com as propriedades diferentes da fonte padrão
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param oStyle, object, Xml de estilos
@param cPath, character, XPath do nó da fonte
@param cFonte0, character, Nome da fonte padrão
@param cTam0, character, Tamanho da fonte padrão
@return character, CSS
/*/
Static Function CssFonte(oStyle As Object, cPath As Character, cFonte0 As Character, cTam0 As Character)
	Local cCss := "" As Character
	Local cTmp As Character
	Local cDecor := "" As Character
	If oStyle:XPathHasNode(cPath+"/xmlns:b") .and. !(oStyle:XPathGetAtt(cPath+"/xmlns:b","val") $ "0|false")
		cCss	+= "font-weight:bold;"
	EndIf
	If oStyle:XPathHasNode(cPath+"/xmlns:i") .and. !(oStyle:XPathGetAtt(cPath+"/xmlns:i","val") $ "0|false")
		cCss	+= "font-style:italic;"
	EndIf
	If oStyle:XPathHasNode(cPath+"/xmlns:u") .and. !(oStyle:XPathGetAtt(cPath+"/xmlns:u","val")=="none")
		cDecor	+= " underline"
	EndIf
	If oStyle:XPathHasNode(cPath+"/xmlns:strike") .and. !(oStyle:XPathGetAtt(cPath+"/xmlns:strike","val") $ "0|false")
		cDecor	+= " line-through"
	EndIf
	If !Empty(cDecor)
		cCss	+= "text-decoration:"+AllTrim(cDecor)+";"
	EndIf
	cTmp	:= oStyle:XPathGetAtt(cPath+"/xmlns:sz","val")
	If !Empty(cTmp) .and. !(cTmp==cTam0)
		cCss	+= "font-size:"+cTmp+"pt;"
	EndIf
	cTmp	:= CorXml(oStyle,cPath+"/xmlns:color")
	If !Empty(cTmp) .and. !(cTmp=="#000000")
		cCss	+= "color:"+cTmp+";"
	EndIf
	cTmp	:= oStyle:XPathGetAtt(cPath+"/xmlns:name","val")
	If !Empty(cTmp) .and. !(cTmp==cFonte0)
		cCss	+= "font-family:'"+StrTran(cTmp,"'","")+"',Calibri,Arial,sans-serif;"
	EndIf
Return cCss

/*/{Protheus.doc} CssFill
CSS do preenchimento. Em estilo de célula a cor sólida está em fgColor; no dxf em bgColor
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param oStyle, object, Xml de estilos
@param cPath, character, XPath do nó de preenchimento
@param lDxf, logical, .T. estilo de formatação condicional (dxf)
@return character, CSS
/*/
Static Function CssFill(oStyle As Object, cPath As Character, lDxf As Logical)
	Local cTipo := oStyle:XPathGetAtt(cPath+"/xmlns:patternFill","patternType") As Character
	Local cCor := "" As Character
	Local aStops As Array
	Local nCont As Numeric
	Local cGrad := "" As Character
	Local cIni := "" As Character
	Local cFim := "" As Character
	Local cRet As Character
	If oStyle:XPathHasNode(cPath+"/xmlns:gradientFill")
		aStops	:= oStyle:XPathGetChildArray(cPath+"/xmlns:gradientFill")
		For nCont:=1 to Len(aStops)
			cCor	:= CorXml(oStyle,aStops[nCont][2]+"/xmlns:color")
			If !Empty(cCor)
				cGrad	+= ","+cCor+" "+cValToChar(Round(Val(oStyle:XPathGetAtt(aStops[nCont][2],"position"))*100,0))+"%"
				If Empty(cIni)
					cIni	:= cCor
				EndIf
				cFim	:= cCor
			EndIf
		Next
		FwFreeArray(aStops)
		If !Empty(cGrad)
			If oStyle:XPathGetAtt(cPath+"/xmlns:gradientFill","type")=="path"
				//Retângulo interno (left/right/top/bottom) na cor inicial e degradê até as bordas na cor final:
				//camada vertical (cor final com o meio transparente) sobre a horizontal
				cRet	:= "background-image:linear-gradient(180deg,"+cFim+" 0%,"+cFim+"00 "+PctGrad(oStyle,cPath,"top")+"%,"+cFim+"00 "+PctGrad(oStyle,cPath,"bottom")+"%,"+cFim+" 100%),"
				cRet	+= "linear-gradient(90deg,"+cFim+" 0%,"+cIni+" "+PctGrad(oStyle,cPath,"left")+"%,"+cIni+" "+PctGrad(oStyle,cPath,"right")+"%,"+cFim+" 100%);"
				Return cRet+"background-size:100% 100%;background-position:0 0;background-repeat:no-repeat;"
			EndIf
			Return "background-image:linear-gradient("+cValToChar(90+Val(oStyle:XPathGetAtt(cPath+"/xmlns:gradientFill","degree")))+"deg"+cGrad+");background-size:100% 100%;background-position:0 0;background-repeat:no-repeat;"
		EndIf
		Return ""
	EndIf
	If cTipo=="none" .or. (Empty(cTipo) .and. !lDxf)
		Return ""
	EndIf
	If lDxf
		cCor	:= CorXml(oStyle,cPath+"/xmlns:patternFill/xmlns:bgColor")
		If Empty(cCor)
			cCor	:= CorXml(oStyle,cPath+"/xmlns:patternFill/xmlns:fgColor")
		EndIf
	Else
		cCor	:= CorXml(oStyle,cPath+"/xmlns:patternFill/xmlns:fgColor")
		If Empty(cCor) .and. !(cTipo=="solid")
			cCor	:= CorXml(oStyle,cPath+"/xmlns:patternFill/xmlns:bgColor")
		EndIf
	EndIf
	If Empty(cCor)
		Return ""
	EndIf
Return "background-color:"+cCor+";background-image:none;"

/*/{Protheus.doc} PctGrad
Posição (0-100) do retângulo interno do degradê "path" (left/right/top/bottom). Sem o atributo = 0 (padr
@type function
@author Saulo Gomes Martins
@since 24/10/2026
@param oStyle, object, Xml de estilos
@param cPath, character, XPath do nó fill
@param cLado, character, left, right, top ou bottom
@return character, Percentual
/*/
Static Function PctGrad(oStyle As Object, cPath As Character, cLado As Character)
	Local cVal := oStyle:XPathGetAtt(cPath+"/xmlns:gradientFill",cLado) As Character
Return cValToChar(Round(Val(cVal)*100,0))

/*/{Protheus.doc} CssBorda
CSS das bordas (esquerda, direita, superior e inferior)
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param oStyle, object, Xml de estilos
@param cPath, character, XPath do nó da borda
@return character, CSS
/*/
Static Function CssBorda(oStyle As Object, cPath As Character)
	Local aLados := {{"left","border-left"},{"right","border-right"},{"top","border-top"},{"bottom","border-bottom"}} As Array
	Local nCont As Numeric
	Local cTipo As Character
	Local cCor As Character
	Local cCss := "" As Character
	For nCont:=1 to Len(aLados)
		cTipo	:= oStyle:XPathGetAtt(cPath+"/xmlns:"+aLados[nCont][1],"style")
		If Empty(cTipo) .or. cTipo=="none"
			Loop
		EndIf
		cCor	:= CorXml(oStyle,cPath+"/xmlns:"+aLados[nCont][1]+"/xmlns:color")
		cCss	+= aLados[nCont][2]+":"+EstiloBorda(cTipo)+" "+If(Empty(cCor),"#000000",cCor)+";"
	Next
	FwFreeArray(aLados)
Return cCss

/*/{Protheus.doc} EstiloBorda
Converte o estilo de borda do Excel em largura e estilo CSS
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param cTipo, character, Estilo da borda (thin, medium, thick, double, dashed...)
@return character, Largura e estilo CSS da borda
/*/
Static Function EstiloBorda(cTipo As Character)
	Do Case
		Case cTipo=="medium"			;	Return "2px solid"
		Case cTipo=="thick"				;	Return "3px solid"
		Case cTipo=="double"			;	Return "3px double"
		Case cTipo=="dashed"			;	Return "1px dashed"
		Case cTipo=="dotted"			;	Return "1px dotted"
		Case cTipo=="hair"				;	Return "1px dotted"
		Case cTipo $ "mediumDashed|mediumDashDot|mediumDashDotDot|slantDashDot"	;	Return "2px dashed"
		Case cTipo $ "dashDot|dashDotDot"	;	Return "1px dashed"
	EndCase
Return "1px solid"

/*/{Protheus.doc} CssAlinha
CSS do alinhamento da célula
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param oStyle, object, Xml de estilos
@param cPath, character, XPath do nó de alinhamento
@param nRot, numeric, (referência) Graus para girar o texto (0 = sem rotação por transform)
@return character, CSS
/*/
Static Function CssAlinha(oStyle As Object, cPath As Character, nRot As Numeric)
	Local cH := oStyle:XPathGetAtt(cPath,"horizontal") As Character
	Local cV := oStyle:XPathGetAtt(cPath,"vertical") As Character
	Local cTmp As Character
	Local cCss := "" As Character
	//Alinhamento() grava horizontal="bottom"/vertical="general" quando não informado
	If cH $ "top|bottom"
		cH	:= ""
	EndIf
	If cV=="general"
		cV	:= ""
	EndIf
	Do Case
		Case cH $ "center|centerContinuous"	;	cCss	+= "text-align:center;"
		Case cH=="right"					;	cCss	+= "text-align:right;"
		Case cH=="left"						;	cCss	+= "text-align:left;"
		Case cH $ "justify|distributed"		;	cCss	+= "text-align:justify;"
	EndCase
	Do Case
		Case cV=="top"						;	cCss	+= "vertical-align:top;"
		Case cV $ "center|justify|distributed"	;	cCss	+= "vertical-align:middle;"
	EndCase
	If oStyle:XPathGetAtt(cPath,"wrapText") $ "1|true"
		cCss	+= "white-space:pre-wrap;word-wrap:break-word;"
	EndIf
	cTmp	:= oStyle:XPathGetAtt(cPath,"indent")
	If Val(cTmp)>0
		cCss	+= If(cH=="right","padding-right:","padding-left:")+cValToChar(Val(cTmp)*9+3)+"px;"
	EndIf
	nRot	:= 0
	cTmp	:= oStyle:XPathGetAtt(cPath,"textRotation")
	Do Case
		Case cTmp=="255"			;	cCss	+= "writing-mode:vertical-rl;text-orientation:upright;"
		Case Val(cTmp)==90			;	cCss	+= "writing-mode:vertical-rl;transform:rotate(180deg);"
		Case Val(cTmp)==180			;	cCss	+= "writing-mode:vertical-rl;"
		Case Val(cTmp)>0 .and. Val(cTmp)<90	;	nRot	:= -Val(cTmp)	//Anti-horário
		Case Val(cTmp)>90 .and. Val(cTmp)<180	;	nRot	:= Val(cTmp)-90	//Horário
	EndCase
Return cCss

/*/{Protheus.doc} CorXml
Converte o nó de cor (rgb, indexed ou theme) em #RRGGBB
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param oStyle, object, Xml que contém a cor
@param cPath, character, XPath do nó da cor
@return character, Cor #RRGGBB ("" se não informada)
/*/
Static Function CorXml(oStyle As Object, cPath As Character)
	Local cRgb As Character
	Local cIdx As Character
	Local cTema As Character
	Local aIdx As Array
	Local aTema As Array
	If !oStyle:XPathHasNode(cPath)
		Return ""
	EndIf
	cRgb	:= oStyle:XPathGetAtt(cPath,"rgb")
	If !Empty(cRgb)
		Return "#"+Right(cRgb,6)
	EndIf
	cIdx	:= oStyle:XPathGetAtt(cPath,"indexed")
	If !Empty(cIdx)
		aIdx	:= {"000000","FFFFFF","FF0000","00FF00","0000FF","FFFF00","FF00FF","00FFFF",;
					"000000","FFFFFF","FF0000","00FF00","0000FF","FFFF00","FF00FF","00FFFF",;
					"800000","008000","000080","808000","800080","008080","C0C0C0","808080",;
					"9999FF","993366","FFFFCC","CCFFFF","660066","FF8080","0066CC","CCCCFF",;
					"000080","FF00FF","FFFF00","00FFFF","800080","800000","008080","0000FF",;
					"00CCFF","CCFFFF","CCFFCC","FFFF99","99CCFF","FF99CC","CC99FF","FFCC99",;
					"3366FF","33CCCC","99CC00","FFCC00","FF9900","FF6600","666699","969696",;
					"003366","339966","003300","333300","993300","993366","333399","333333"}
		If Val(cIdx)<64
			Return "#"+aIdx[Val(cIdx)+1]
		EndIf
		Return ""
	EndIf
	cTema	:= oStyle:XPathGetAtt(cPath,"theme")
	If !Empty(cTema)
		aTema	:= {"FFFFFF","000000","EEECE1","1F497D","4F81BD","C0504D","9BBB59","8064A2","4BACC6","F79646"}	//Tema padrão gravado pela biblioteca
		If Val(cTema)<Len(aTema)
			Return "#"+aTema[Val(cTema)+1]
		EndIf
	EndIf
Return ""

/*/{Protheus.doc} DxfCss
Converte os estilos de formatação condicional (dxfs) em objetos de estilo do JavaScript
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param oExcel, object, Instância de custom.excel.Xlsx
@return array, Array de Json
/*/
Static Function DxfCss(oExcel As Object)
	Local oStyle := oExcel:oStyle As Object
	Local aRet := {} As Array
	Local nQtd As Numeric
	Local nCont As Numeric
	Local cPath As Character
	Local jDxf As Variant
	Local cTmp As Character
	Local cDecor As Character
	Local aLados := {{"left","borderLeft"},{"right","borderRight"},{"top","borderTop"},{"bottom","borderBottom"}} As Array
	Local nLado As Numeric
	nQtd	:= oStyle:XPathChildCount("/xmlns:styleSheet/xmlns:dxfs")
	For nCont:=1 to nQtd
		cPath	:= "/xmlns:styleSheet/xmlns:dxfs/xmlns:dxf["+cValToChar(nCont)+"]"
		jDxf	:= JsonObject():New()
		If oStyle:XPathHasNode(cPath+"/xmlns:font")
			If oStyle:XPathHasNode(cPath+"/xmlns:font/xmlns:b")
				jDxf["fontWeight"]	:= "bold"
			EndIf
			If oStyle:XPathHasNode(cPath+"/xmlns:font/xmlns:i")
				jDxf["fontStyle"]	:= "italic"
			EndIf
			cDecor	:= ""
			If oStyle:XPathHasNode(cPath+"/xmlns:font/xmlns:u")
				cDecor	+= " underline"
			EndIf
			If oStyle:XPathHasNode(cPath+"/xmlns:font/xmlns:strike")
				cDecor	+= " line-through"
			EndIf
			If !Empty(cDecor)
				jDxf["textDecoration"]	:= AllTrim(cDecor)
			EndIf
			cTmp	:= CorXml(oStyle,cPath+"/xmlns:font/xmlns:color")
			If !Empty(cTmp)
				jDxf["color"]	:= cTmp
			EndIf
		EndIf
		If oStyle:XPathHasNode(cPath+"/xmlns:fill")
			cTmp	:= CssFill(oStyle,cPath+"/xmlns:fill",.T.)
			If "background-color:" $ cTmp
				jDxf["backgroundColor"]	:= SubStr(cTmp,18,7)
				jDxf["backgroundImage"]	:= "none"
			EndIf
		EndIf
		If oStyle:XPathHasNode(cPath+"/xmlns:border")
			For nLado:=1 to Len(aLados)
				cTmp	:= oStyle:XPathGetAtt(cPath+"/xmlns:border/xmlns:"+aLados[nLado][1],"style")
				If !Empty(cTmp) .and. !(cTmp=="none")
					jDxf[aLados[nLado][2]]	:= EstiloBorda(cTmp)+" "+If(Empty(CorXml(oStyle,cPath+"/xmlns:border/xmlns:"+aLados[nLado][1]+"/xmlns:color")),"#000000",CorXml(oStyle,cPath+"/xmlns:border/xmlns:"+aLados[nLado][1]+"/xmlns:color"))
				EndIf
			Next
		EndIf
		AADD(aRet,jDxf)
	Next
	FwFreeArray(aLados)
Return aRet

/*/{Protheus.doc} CondFormat
Lê as regras de formatação condicional da planilha para avaliação no cliente
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param oExcel, object, Instância de custom.excel.Xlsx
@param oXml, object, Xml da planilha
@param jMeta, json, Metadados da planilha (recebe as regras de formatação condicional)
/*/
Static Function CondFormat(oExcel As Object, oXml As Object, jMeta As Json)
	Local aChild As Array
	Local aRegras As Array
	Local aCf := {} As Array
	Local aLista As Array
	Local aCfvo As Array
	Local aForm As Array
	Local nCont As Numeric
	Local nCont2 As Numeric
	Local nCont3 As Numeric
	Local jCf As Variant
	Local jRg As Variant
	Local jVo As Variant
	Local cPath As Character
	Local cTipo As Character
	Local cSub As Character
	aChild	:= oXml:XPathGetChildArray("/xmlns:worksheet")
	For nCont:=1 to Len(aChild)
		If !(aChild[nCont][1]=="conditionalFormatting")
			Loop
		EndIf
		jCf		:= JsonObject():New()
		jCf["sqref"]	:= oXml:XPathGetAtt(aChild[nCont][2],"sqref")
		aLista	:= {}
		aRegras	:= oXml:XPathGetChildArray(aChild[nCont][2])
		For nCont2:=1 to Len(aRegras)
			If !(aRegras[nCont2][1]=="cfRule")
				Loop
			EndIf
			cPath	:= aRegras[nCont2][2]
			cTipo	:= oXml:XPathGetAtt(cPath,"type")
			jRg		:= JsonObject():New()
			jRg["tipo"]			:= cTipo
			jRg["prioridade"]	:= Val(oXml:XPathGetAtt(cPath,"priority"))
			jRg["operador"]		:= oXml:XPathGetAtt(cPath,"operator")
			jRg["periodo"]		:= oXml:XPathGetAtt(cPath,"timePeriod")
			If !Empty(oXml:XPathGetAtt(cPath,"dxfId"))
				jRg["dxf"]	:= Val(oXml:XPathGetAtt(cPath,"dxfId"))
			EndIf
			aForm	:= {}
			aCfvo	:= oXml:XPathGetChildArray(cPath)
			For nCont3:=1 to Len(aCfvo)
				If aCfvo[nCont3][1]=="formula"
					AADD(aForm,DeUtf8(DesEscXml(aCfvo[nCont3][3])))
				EndIf
			Next
			FwFreeArray(aCfvo)
			jRg["formulas"]	:= aForm
			cSub	:= ""
			If cTipo=="dataBar" .or. cTipo=="iconSet"
				cSub	:= cPath+"/xmlns:"+cTipo
				jRg["mostrar"]	:= !(oXml:XPathGetAtt(cSub,"showValue")=="0")
				If cTipo=="dataBar"
					jRg["cor"]	:= CorXml(oXml,cSub+"/xmlns:color")
				Else
					jRg["icones"]	:= oXml:XPathGetAtt(cSub,"iconSet")
					jRg["reverso"]	:= oXml:XPathGetAtt(cSub,"reverse")=="1"
				EndIf
				aCfvo	:= oXml:XPathGetChildArray(cSub)
				aForm	:= {}
				For nCont3:=1 to Len(aCfvo)
					If aCfvo[nCont3][1]=="cfvo"
						jVo	:= JsonObject():New()
						jVo["type"]	:= oXml:XPathGetAtt(aCfvo[nCont3][2],"type")
						jVo["val"]	:= oXml:XPathGetAtt(aCfvo[nCont3][2],"val")
						AADD(aForm,jVo)
					EndIf
				Next
				FwFreeArray(aCfvo)
				jRg["cfvo"]	:= aForm
			EndIf
			AADD(aLista,jRg)
		Next
		FwFreeArray(aRegras)
		jCf["regras"]	:= aLista
		AADD(aCf,jCf)
	Next
	FwFreeArray(aChild)
	If !Empty(aCf)
		jMeta["cf"]	:= aCf
	EndIf
Return

//----------------------------------------------------------------------
//FORMATAÇÃO DE NÚMEROS E DATAS
//----------------------------------------------------------------------
/*/{Protheus.doc} CodigoFmt
Código do formato numérico (nativo ou numFmts)
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param oExcel, object, Instância de custom.excel.Xlsx
@param nFmtId, numeric, Id do formato numérico
@return character, Código do formato
/*/
Static Function CodigoFmt(oExcel As Object, nFmtId As Numeric)
	Local cCode As Character
	Do Case
		Case nFmtId==0	;	Return "General"
		Case nFmtId==1	;	Return "0"
		Case nFmtId==2	;	Return "0.00"
		Case nFmtId==3	;	Return "#,##0"
		Case nFmtId==4	;	Return "#,##0.00"
		Case nFmtId==9	;	Return "0%"
		Case nFmtId==10	;	Return "0.00%"
		Case nFmtId==11	;	Return "0.00E+00"
		Case nFmtId==12	;	Return "General"
		Case nFmtId==13	;	Return "General"
		Case nFmtId==14	;	Return "dd/mm/yyyy"
		Case nFmtId==15	;	Return "d-mmm-yy"
		Case nFmtId==16	;	Return "d-mmm"
		Case nFmtId==17	;	Return "mmm-yy"
		Case nFmtId==18	;	Return "h:mm AM/PM"
		Case nFmtId==19	;	Return "h:mm:ss AM/PM"
		Case nFmtId==20	;	Return "hh:mm"
		Case nFmtId==21	;	Return "hh:mm:ss"
		Case nFmtId==22	;	Return "dd/mm/yyyy hh:mm"
		Case nFmtId==37	;	Return "#,##0 ;(#,##0)"
		Case nFmtId==38	;	Return "#,##0 ;[Red](#,##0)"
		Case nFmtId==39	;	Return "#,##0.00;(#,##0.00)"
		Case nFmtId==40	;	Return "#,##0.00;[Red](#,##0.00)"
		Case nFmtId==45	;	Return "mm:ss"
		Case nFmtId==46	;	Return "[h]:mm:ss"
		Case nFmtId==47	;	Return "mm:ss.0"
		Case nFmtId==48	;	Return "##0.0E+0"
		Case nFmtId==49	;	Return "@"
	EndCase
	cCode	:= oExcel:oStyle:XPathGetAtt("/xmlns:styleSheet/xmlns:numFmts/xmlns:numFmt[@numFmtId='"+cValToChar(nFmtId)+"']","formatCode")
	If Empty(cCode)
		cCode	:= "General"
	EndIf
Return DesEscXml(cCode)

/*/{Protheus.doc} ParseFmt
Interpreta o código do formato. Retorno: {cTipoValor(N,D,T,C,X),aSecoes}
Seção: {cTipo(G,N,D,@),cPrefixo,cSufixo,nDecimais,lMilhar,lPercentual,lCientifico,nMinInt,aTokens,cCor}
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param cCode, character, Código do formato numérico
@return array, {cTipoValor,aSecoes}
/*/
Static Function ParseFmt(cCode As Character)
	Local aSecoes := {} As Array
	Local aPartes As Array
	Local nCont As Numeric
	Local cTipo := "N" As Character
	Local aSec As Array
	Local lData := .F. As Logical
	Local lHora := .F. As Logical
	aPartes	:= SepSecao(cCode)
	For nCont:=1 to Min(Len(aPartes),4)
		If nCont>1 .and. Empty(aPartes[nCont])
			aSec	:= {"L","","",0,.F.,.F.,.F.,0,{},""}	//Seção vazia: não exibe o valor
		Else
			aSec	:= ParseSecao(aPartes[nCont])
		EndIf
		AADD(aSecoes,aSec)
		If aSec[1]=="D"
			lData	:= lData .or. aScan(aSec[9],{|x| Left(x[1],1) $ "ydm" })>0
			lHora	:= lHora .or. aScan(aSec[9],{|x| Left(x[1],1) $ "hMs[" })>0
		EndIf
	Next
	If Empty(aSecoes)
		AADD(aSecoes,ParseSecao("General"))
	EndIf
	If aSecoes[1][1]=="D"
		cTipo	:= If(lHora,"T","D")
	ElseIf aSecoes[1][1]=="@"
		cTipo	:= "C"
	EndIf
Return {cTipo,aSecoes}

/*/{Protheus.doc} SepSecao
Separa as seções (;) do código do formato, ignorando aspas e colchetes
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param cCode, character, Código do formato numérico
@return array, Seções do formato
/*/
Static Function SepSecao(cCode As Character)
	Local aRet := {} As Array
	Local cAtual := "" As Character
	Local nCont As Numeric
	Local cCh As Character
	Local lAspas := .F. As Logical
	Local lColch := .F. As Logical
	For nCont:=1 to Len(cCode)
		cCh	:= SubStr(cCode,nCont,1)
		If cCh=='"'
			lAspas	:= !lAspas
		ElseIf cCh=="[" .and. !lAspas
			lColch	:= .T.
		ElseIf cCh=="]" .and. !lAspas
			lColch	:= .F.
		ElseIf cCh=="\" .and. !lAspas
			cAtual	+= SubStr(cCode,nCont,2)
			nCont++
			Loop
		ElseIf cCh==";" .and. !lAspas .and. !lColch
			AADD(aRet,cAtual)
			cAtual	:= ""
			Loop
		EndIf
		cAtual	+= cCh
	Next
	AADD(aRet,cAtual)
Return aRet

/*/{Protheus.doc} ParseSecao
Interpreta uma seção do formato
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param cSec, character, Seção do formato
@return array, Seção interpretada
/*/
Static Function ParseSecao(cSec As Character)
	Local aSec := {"N","","",0,.F.,.F.,.F.,0,{},""} As Array
	Local nCont := 1 As Numeric
	Local nTam := Len(cSec) As Numeric
	Local cCh As Character
	Local cLow As Character
	Local nFim As Numeric
	Local cBloco As Character
	Local nEstado := 0 As Numeric	//0=antes dos dígitos, 1=parte inteira, 2=decimais, 3=depois
	Local aTok := {} As Array
	Local cLit := "" As Character
	Local lData := .F. As Logical
	Local nRun As Numeric
	Local nTok As Numeric
	Local cAnt As Character
	Local cProx As Character
	If Upper(AllTrim(cSec))=="GENERAL" .or. Empty(cSec)
		aSec[1]	:= "G"
		Return aSec
	EndIf
	//Identifica data/hora: letras y,m,d,h,s fora de aspas/colchetes
	lData	:= TemData(cSec)
	If lData
		aSec[1]	:= "D"
	EndIf
	While nCont<=nTam
		cCh		:= SubStr(cSec,nCont,1)
		cLow	:= Lower(cCh)
		If cCh=='"'
			nFim	:= At('"',cSec,nCont+1)
			If nFim==0
				nFim	:= nTam+1
			EndIf
			cLit	:= SubStr(cSec,nCont+1,nFim-nCont-1)
			nCont	:= nFim+1
			AddLit(aSec,aTok,cLit,nEstado,lData)
			Loop
		ElseIf cCh=="\"
			AddLit(aSec,aTok,SubStr(cSec,nCont+1,1),nEstado,lData)
			nCont	+= 2
			Loop
		ElseIf cCh=="_"
			AddLit(aSec,aTok," ",nEstado,lData)
			nCont	+= 2
			Loop
		ElseIf cCh=="*"
			nCont	+= 2
			Loop
		ElseIf cCh=="["
			nFim	:= At("]",cSec,nCont)
			If nFim==0
				nFim	:= nTam
			EndIf
			cBloco	:= SubStr(cSec,nCont+1,nFim-nCont-1)
			If Left(cBloco,1)=="$"
				cBloco	:= SubStr(cBloco,2)
				If At("-",cBloco)>0
					cBloco	:= SubStr(cBloco,1,At("-",cBloco)-1)
				EndIf
				AddLit(aSec,aTok,cBloco,nEstado,lData)
			ElseIf lData .and. Lower(cBloco) $ "h|hh|m|mm|s|ss"
				AADD(aTok,{"["+Lower(Left(cBloco,1))+"]",""})
			ElseIf CorNome(cBloco)!=""
				aSec[10]	:= CorNome(cBloco)
			EndIf
			nCont	:= nFim+1
			Loop
		EndIf
		If lData
			If Upper(SubStr(cSec,nCont,5))=="AM/PM"
				AADD(aTok,{"ampm",""})
				nCont	+= 5
				Loop
			ElseIf Upper(SubStr(cSec,nCont,3))=="A/P"
				AADD(aTok,{"ap",""})
				nCont	+= 3
				Loop
			ElseIf cLow=="a" .and. Lower(SubStr(cSec,nCont,3))=="aaa"	//Dia da semana em português (aaa = ddd, aaaa = dddd)
				nRun	:= 3
				While nCont+nRun<=nTam .and. Lower(SubStr(cSec,nCont+nRun,1))=="a"
					nRun++
				EndDo
				AADD(aTok,{If(nRun>3,"dddd","ddd"),""})
				nCont	+= nRun
				Loop
			ElseIf cLow $ "ymdhs"
				nRun	:= 1
				While nCont+nRun<=nTam .and. Lower(SubStr(cSec,nCont+nRun,1))==cLow
					nRun++
				EndDo
				AADD(aTok,{Replicate(cLow,nRun),""})
				nCont	+= nRun
				Loop
			ElseIf cCh=="." .and. SubStr(cSec,nCont+1,1)=="0" .and. Len(aTok)>0 .and. Left(aTok[Len(aTok)][1],1)=="s"
				While nCont+1<=nTam .and. SubStr(cSec,nCont+1,1)=="0"
					nCont++
				EndDo
				nCont++
				Loop
			ElseIf cCh=="@"
				nCont++
				Loop
			EndIf
			AddLit(aSec,aTok,cCh,nEstado,lData)
			nCont++
			Loop
		EndIf
		//Numérico
		If cCh=="@"
			aSec[1]	:= "@"
			AddLit(aSec,aTok,"@",nEstado,lData)
			nCont++
			Loop
		ElseIf cCh $ "0#?"
			If nEstado==0
				nEstado	:= 1
			EndIf
			If nEstado==1 .and. cCh=="0"
				aSec[8]++
			ElseIf nEstado==2 .and. cCh $ "0#?"
				aSec[4]++
			EndIf
			If nEstado==3
				nEstado	:= 3
			EndIf
			nCont++
			Loop
		ElseIf cCh=="." .and. nEstado<=1 .and. SubStr(cSec,nCont+1,1) $ "0#?"
			nEstado	:= 2
			nCont++
			Loop
		ElseIf cCh=="," .and. nEstado==1
			aSec[5]	:= .T.
			nCont++
			Loop
		ElseIf Upper(cCh)=="E" .and. nEstado>=1 .and. SubStr(cSec,nCont+1,1) $ "+-"
			aSec[7]	:= .T.
			nCont	+= 2
			While nCont<=nTam .and. SubStr(cSec,nCont,1) $ "0#"
				nCont++
			EndDo
			nEstado	:= 3
			Loop
		ElseIf cCh=="%"
			aSec[6]	:= .T.
		EndIf
		If nEstado==1 .or. nEstado==2
			nEstado	:= 3
		EndIf
		AddLit(aSec,aTok,cCh,nEstado,lData)
		nCont++
	EndDo
	If lData
		//Resolve m/mm como minuto (após hora ou antes de segundo)
		For nTok:=1 to Len(aTok)
			If aTok[nTok][1] $ "m|mm"
				cAnt	:= TokAnt(aTok,nTok,-1)
				cProx	:= TokAnt(aTok,nTok,1)
				If Left(cAnt,1) $ "h[" .or. Left(cProx,1)=="s"
					aTok[nTok][1]	:= Upper(aTok[nTok][1])
				EndIf
			EndIf
		Next
		aSec[9]	:= aTok
	ElseIf aSec[1]=="N" .and. nEstado==0 .and. !aSec[6]
		aSec[1]	:= "L"	//Somente texto fixo
	EndIf
Return aSec

/*/{Protheus.doc} TemData
Verifica se a seção do formato contém tokens de data/hora (ignorando literais e cores)
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param cSec, character, Seção do formato
@return logical, .T. se for formato de data/hora
/*/
Static Function TemData(cSec As Character)
	Local nCont As Numeric
	Local cCh As Character
	Local lAspas := .F. As Logical
	Local lColch := .F. As Logical
	For nCont:=1 to Len(cSec)
		cCh	:= SubStr(cSec,nCont,1)
		If cCh=='"'
			lAspas	:= !lAspas
		ElseIf cCh=="\" .and. !lAspas
			nCont++
		ElseIf cCh=="[" .and. !lAspas
			lColch	:= .T.
			If Lower(SubStr(cSec,nCont+1,1)) $ "hms" .and. SubStr(cSec,nCont+2,1) $ "hms]"
				Return .T.
			EndIf
		ElseIf cCh=="]"
			lColch	:= .F.
		ElseIf !lAspas .and. !lColch .and. Lower(cCh) $ "ymdhs"
			Return .T.
		EndIf
	Next
Return .F.

/*/{Protheus.doc} TokAnt
Retorna o tipo do token anterior/posterior que não seja literal
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param aTok, array, Tokens da seção
@param nTok, numeric, Posição do token atual
@param nPasso, numeric, Direção da busca (-1 anterior, 1 posterior)
@return character, Tipo do token ("" se não encontrou)
/*/
Static Function TokAnt(aTok As Array, nTok As Numeric, nPasso As Numeric)
	Local nCont := nTok+nPasso As Numeric
	While nCont>=1 .and. nCont<=Len(aTok)
		If !(aTok[nCont][1]=="lit")
			Return aTok[nCont][1]
		EndIf
		nCont	+= nPasso
	EndDo
Return ""

/*/{Protheus.doc} AddLit
Adiciona um literal aos tokens de data, ao prefixo ou ao sufixo da seção
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param aSec, array, Seção do formato
@param aTok, array, Tokens da seção
@param cLit, character, Literal
@param nEstado, numeric, 0 antes do número (prefixo), senão sufixo
@param lData, logical, .T. formato de data
/*/
Static Function AddLit(aSec As Array, aTok As Array, cLit As Character, nEstado As Numeric, lData As Logical)
	If lData
		AADD(aTok,{"lit",cLit})
	ElseIf nEstado==0
		aSec[2]	+= cLit
	Else
		aSec[3]	+= cLit
	EndIf
Return

/*/{Protheus.doc} CorNome
Converte o nome da cor do formato ([Red], [Blue]...) em #RRGGBB
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param cNome, character, Nome da cor
@return character, Cor #RRGGBB ("" se não reconhecida)
/*/
Static Function CorNome(cNome As Character)
	Local cLow := Lower(cNome) As Character
	Do Case
		Case cLow=="red"		;	Return "#ff0000"
		Case cLow=="blue"		;	Return "#0000ff"
		Case cLow=="green"		;	Return "#008000"
		Case cLow=="yellow"		;	Return "#ffff00"
		Case cLow=="magenta"	;	Return "#ff00ff"
		Case cLow=="cyan"		;	Return "#00ffff"
		Case cLow=="white"		;	Return "#ffffff"
		Case cLow=="black"		;	Return "#000000"
		Case Left(cLow,5)=="color"	;	Return "#000000"
	EndCase
Return ""

/*/{Protheus.doc} FmtNumero
Formata o número conforme o formato interpretado (pt-BR: decimal "," e milhar ".")
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param nValor, numeric, Valor
@param aFmt, array, Formato interpretado {cTipoValor,aSecoes}
@param cCor, character, (referência) cor da seção utilizada
@return character, Texto formatado
/*/
Static Function FmtNumero(nValor As Numeric, aFmt As Array, cCor As Character)
	Local aSecoes := aFmt[2] As Array
	Local aSec As Array
	Local lNeg := nValor<0 As Logical
	Local lSinal := .F. As Logical
	Local cRet As Character
	If nValor<0 .and. Len(aSecoes)>=2 .and. aSecoes[2][1]!="@"
		aSec	:= aSecoes[2]
	ElseIf nValor==0 .and. Len(aSecoes)>=3 .and. aSecoes[3][1]!="@"
		aSec	:= aSecoes[3]
	Else
		aSec	:= aSecoes[1]
		lSinal	:= lNeg .and. aSec[1]!="D"
	EndIf
	cCor	:= aSec[10]
	Do Case
		Case aSec[1]=="G"
			cRet	:= NumGeral(Abs(nValor))
		Case aSec[1]=="D"
			Return FmtData(nValor,aSec[9])
		Case aSec[1]=="@"
			cRet	:= StrTran(aSec[2]+aSec[3],"@",NumGeral(Abs(nValor)))
		Case aSec[1]=="L"
			cRet	:= aSec[2]
		Otherwise
			cRet	:= aSec[2]+NumMascara(Abs(nValor),aSec)+aSec[3]
	EndCase
	If lSinal
		cRet	:= "-"+cRet
	EndIf
Return AllTrim(cRet)

/*/{Protheus.doc} NumGeral
Formata o número no formato Geral do Excel (notação científica para valores extremos)
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param nValor, numeric, Valor
@return character, Texto formatado
/*/
Static Function NumGeral(nValor As Numeric)
	Local cRet As Character
	If nValor!=0 .and. (nValor>=100000000000 .or. nValor<0.000000001)
		Return StrTran(NumCient(nValor,5),".",",")
	EndIf
	cRet	:= cValToChar(nValor)
	If "." $ cRet .and. Len(cRet)>12
		cRet	:= AllTrim(Str(nValor,20,Max(0,10-Len(cValToChar(Int(nValor))))))
		While "." $ cRet .and. Right(cRet,1)=="0"
			cRet	:= Left(cRet,Len(cRet)-1)
		EndDo
		If Right(cRet,1)=="."
			cRet	:= Left(cRet,Len(cRet)-1)
		EndIf
	EndIf
Return StrTran(cRet,".",",")

/*/{Protheus.doc} NumCient
Formata o número em notação científica
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param nValor, numeric, Valor
@param nDec, numeric, Casas decimais da mantissa
@return character, Texto formatado
/*/
Static Function NumCient(nValor As Numeric, nDec As Numeric)
	Local nExp := 0 As Numeric
	Local nMant := nValor As Numeric
	If nValor!=0
		nExp	:= Int(Log(nValor)/Log(10))
		If 10^nExp>nValor
			nExp--
		EndIf
		nMant	:= nValor/(10^nExp)
	EndIf
Return AllTrim(Str(nMant,20,nDec))+"E"+If(nExp<0,"-","+")+StrZero(Abs(nExp),2)

/*/{Protheus.doc} NumMascara
Formata o número conforme a seção do formato (decimais, milhar, percentual e científico)
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param nValor, numeric, Valor
@param aSec, array, Seção do formato
@return character, Texto formatado
/*/
Static Function NumMascara(nValor As Numeric, aSec As Array)
	Local nDec := aSec[4] As Numeric
	Local cNum As Character
	Local cInt As Character
	Local cDec := "" As Character
	Local nPos As Numeric
	Local cMil := "" As Character
	If aSec[6]
		nValor	:= nValor*100
	EndIf
	If aSec[7]
		Return StrTran(NumCient(nValor,nDec),".",",")
	EndIf
	cNum	:= AllTrim(Str(nValor,32,nDec))
	nPos	:= At(".",cNum)
	If nPos>0
		cInt	:= SubStr(cNum,1,nPos-1)
		cDec	:= SubStr(cNum,nPos+1)
	Else
		cInt	:= cNum
	EndIf
	If cInt=="0" .and. aSec[8]==0
		cInt	:= ""
	EndIf
	If Len(cInt)<aSec[8]
		cInt	:= Replicate("0",aSec[8]-Len(cInt))+cInt
	EndIf
	If aSec[5] .and. Len(cInt)>3
		While Len(cInt)>3
			cMil	:= "."+Right(cInt,3)+cMil
			cInt	:= Left(cInt,Len(cInt)-3)
		EndDo
		cInt	+= cMil
	EndIf
Return cInt+If(nDec>0,","+cDec,"")

/*/{Protheus.doc} FmtData
Formata o serial de data/hora do Excel conforme os tokens do formato
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param nSerial, numeric, Serial de data/hora do Excel
@param aTok, array, Tokens do formato de data
@return character, Texto formatado
/*/
Static Function FmtData(nSerial As Numeric, aTok As Array)
	Local dData := STOD("18991230")+Int(nSerial) As Date
	Local nSeg := Round((nSerial-Int(nSerial))*86400,0) As Numeric
	Local nHora As Numeric
	Local nMin As Numeric
	Local nS As Numeric
	Local lAmPm := aScan(aTok,{|x| x[1] $ "ampm|ap" })>0 As Logical
	Local nCont As Numeric
	Local cTok As Character
	Local cRet := "" As Character
	Local aMes := {"janeiro","fevereiro","março","abril","maio","junho","julho","agosto","setembro","outubro","novembro","dezembro"} As Array
	Local aDia := {"domingo","segunda-feira","terça-feira","quarta-feira","quinta-feira","sexta-feira","sábado"} As Array
	If nSeg>=86400
		dData++
		nSeg	-= 86400
	EndIf
	nHora	:= Int(nSeg/3600)
	nMin	:= Int(Mod(nSeg,3600)/60)
	nS		:= Mod(nSeg,60)
	For nCont:=1 to Len(aTok)
		cTok	:= aTok[nCont][1]
		Do Case
			Case cTok=="lit"	;	cRet	+= aTok[nCont][2]
			Case cTok=="yyyy" .or. cTok=="yyy"	;	cRet	+= StrZero(Year(dData),4)
			Case Left(cTok,1)=="y"	;	cRet	+= Right(StrZero(Year(dData),4),2)
			Case cTok=="mmmmm"	;	cRet	+= Left(aMes[Month(dData)],1)
			Case cTok=="mmmm"	;	cRet	+= aMes[Month(dData)]
			Case cTok=="mmm"	;	cRet	+= Left(aMes[Month(dData)],3)
			Case cTok=="mm"		;	cRet	+= StrZero(Month(dData),2)
			Case cTok=="m"		;	cRet	+= cValToChar(Month(dData))
			Case Len(cTok)>=4 .and. Left(cTok,1)=="d"	;	cRet	+= aDia[Dow(dData)]
			Case cTok=="ddd"	;	cRet	+= Left(aDia[Dow(dData)],3)
			Case cTok=="dd"		;	cRet	+= StrZero(Day(dData),2)
			Case cTok=="d"		;	cRet	+= cValToChar(Day(dData))
			Case cTok=="[h]"	;	cRet	+= cValToChar(Int(Round(nSerial*86400,0)/3600))
			Case cTok=="[m]"	;	cRet	+= cValToChar(Int(Round(nSerial*86400,0)/60))
			Case cTok=="[s]"	;	cRet	+= cValToChar(Round(nSerial*86400,0))
			Case Left(cTok,1)=="h"
				HoraFmt(@cRet,nHora,lAmPm,Len(cTok))
			Case cTok=="MM"		;	cRet	+= StrZero(nMin,2)
			Case cTok=="M"		;	cRet	+= cValToChar(nMin)
			Case Len(cTok)>=2 .and. Left(cTok,1)=="s"	;	cRet	+= StrZero(nS,2)
			Case cTok=="s"		;	cRet	+= cValToChar(nS)
			Case cTok=="ampm"	;	cRet	+= If(nHora<12,"AM","PM")
			Case cTok=="ap"		;	cRet	+= If(nHora<12,"A","P")
		EndCase
	Next
	FwFreeArray(aMes)
	FwFreeArray(aDia)
Return cRet

/*/{Protheus.doc} HoraFmt
Adiciona a hora formatada (12 ou 24 horas) ao texto
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param cRet, character, (referência) Texto em montagem
@param nHora, numeric, Hora
@param lAmPm, logical, .T. formato 12 horas (AM/PM)
@param nTam, numeric, Tamanho do token (2 = com zero à esquerda)
/*/
Static Function HoraFmt(cRet As Character, nHora As Numeric, lAmPm As Logical, nTam As Numeric)
	If lAmPm
		nHora	:= Mod(nHora,12)
		If nHora==0
			nHora	:= 12
		EndIf
	EndIf
	cRet	+= If(nTam>=2,StrZero(nHora,2),cValToChar(nHora))
Return

//----------------------------------------------------------------------
//IMAGENS E GRÁFICOS
//----------------------------------------------------------------------
/*/{Protheus.doc} ImgBase64
Retorna a imagem como data URI (base64). Procura na pasta do xlsx e na pasta preservada para o html
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param oExcel, object, Instância de custom.excel.Xlsx
@param nID, numeric, Id da imagem
@return character, Data URI da imagem ("" se não encontrou)
/*/
Static Function ImgBase64(oExcel As Object, nID As Numeric)
	Local nPos := aScan(oExcel:aImagens,{|x| x[1]==nID }) As Numeric
	Local cNome As Character
	Local cArq As Character
	Local nHandle As Numeric
	Local nTam As Numeric
	Local cConteudo As Character
	Local cExt As Character
	If nPos==0
		Return ""
	EndIf
	cNome	:= oExcel:aImagens[nPos][2]
	cArq	:= "\tmpxls\"+oExcel:cTmpFile+"\"+oExcel:cNomeFile+"\xl\media\"+cNome
	If !File(cArq,,.F.)
		cArq	:= oExcel:DirHtml()+"media\"+cNome
	EndIf
	If !File(cArq,,.F.)
		Return ""
	EndIf
	nHandle	:= FOpen(cArq,FO_READ+FO_SHARED,,.F.)
	If nHandle<0
		Return ""
	EndIf
	nTam		:= FSeek(nHandle,0,2)
	FSeek(nHandle,0,0)
	cConteudo	:= Space(nTam)
	FRead(nHandle,@cConteudo,nTam)
	FClose(nHandle)
	cExt	:= Lower(SubStr(cNome,Rat(".",cNome)+1))
	If cExt=="jpg"
		cExt	:= "jpeg"
	ElseIf cExt=="svg"
		cExt	:= "svg+xml"
	EndIf
Return "data:image/"+cExt+";base64,"+Encode64(cConteudo)

/*/{Protheus.doc} ChartJson
Converte um gráfico (custom.excel.chart) na configuração usada pelo JavaScript (Chart.js)
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param oChart, object, Gráfico (custom.excel.chart)
@return json, Configuração do gráfico
/*/
Static Function ChartJson(oChart As Object)
	Local jRet := JsonObject():New() As Json
	Local cClasse := Upper(oChart:cClassName) As Character
	Local aSeries := {} As Array
	Local aMembros := {} As Array
	Local nCont As Numeric
	Local jMembro As Variant
	Local jAux As Variant
	Do Case
		Case "CHARTBAR" $ cClasse			;	jRet["tipo"]	:= "bar"
		Case "CHARTLINE" $ cClasse			;	jRet["tipo"]	:= "line"
		Case "CHARTDOUGHNUT" $ cClasse		;	jRet["tipo"]	:= "doughnut"
		Case "CHARTOFPIE" $ cClasse			;	jRet["tipo"]	:= "ofpie"
		Case "CHARTPIE" $ cClasse			;	jRet["tipo"]	:= "pie"
		Case "CHARTBUBBLE" $ cClasse		;	jRet["tipo"]	:= "bubble"
		Case "CHARTSCATTER" $ cClasse		;	jRet["tipo"]	:= "scatter"
		Case "CHARTAREA" $ cClasse			;	jRet["tipo"]	:= "area"
		Case "CHARTSTOCK" $ cClasse			;	jRet["tipo"]	:= "stock"
		Case "CHARTRADAR" $ cClasse			;	jRet["tipo"]	:= "radar"
		Case "CHARTSURFACE" $ cClasse		;	jRet["tipo"]	:= "surface"
		Case "CHARTCOMBO" $ cClasse			;	jRet["tipo"]	:= "combo"
		Otherwise							;	jRet["tipo"]	:= "bar"
	EndCase
	jRet["titulo"]		:= If(ValType(oChart:cTitulo)=="C",DeUtf8(oChart:cTitulo),"")
	jRet["legenda"]		:= If(ValType(oChart:lLegenda)=="L",oChart:lLegenda,.T.)
	jRet["posLegenda"]	:= If(ValType(oChart:cPosLegenda)=="C",oChart:cPosLegenda,"r")
	jRet["grade"]		:= If(ValType(oChart:lGrade)=="L",oChart:lGrade,.T.)
	If jRet["tipo"] $ "bar"
		jRet["horizontal"]	:= oChart:cDirecao=="bar"
	EndIf
	If jRet["tipo"] $ "bar|line|area"
		jRet["agrupamento"]	:= oChart:cAgrupamento
	EndIf
	If jRet["tipo"]=="line"
		jRet["marcador"]	:= oChart:lMarcador
		jRet["suavizar"]	:= oChart:lSuavizar
	EndIf
	If jRet["tipo"] $ "scatter|bubble|radar"
		jRet["estilo"]		:= If(ValType(oChart:cEstilo)=="C",oChart:cEstilo,"")
	EndIf
	If jRet["tipo"]=="doughnut"
		jRet["furo"]		:= oChart:nFuro
	EndIf
	If ValType(oChart:l3D)=="L" .and. oChart:l3D
		jRet["3d"]		:= .T.
	EndIf
	If "CHARTBAR" $ cClasse .and. ValType(oChart:nGapWidth)=="N"	//Espaço entre grupos de barras (%)
		jRet["gap"]		:= oChart:nGapWidth
	EndIf
	If jRet["tipo"] $ "pie|doughnut|ofpie"
		If ValType(oChart:nAnguloIni)=="N"
			jRet["angulo"]	:= oChart:nAnguloIni
		EndIf
		If ValType(oChart:lRotulos)=="L" .and. oChart:lRotulos	//Rótulos de dados
			jAux	:= JsonObject():New()
			jAux["val"]	:= ValType(oChart:lRotVal)=="L" .and. oChart:lRotVal
			jAux["pct"]	:= ValType(oChart:lRotPct)=="L" .and. oChart:lRotPct
			jAux["cat"]	:= ValType(oChart:lRotCat)=="L" .and. oChart:lRotCat
			jRet["rotulos"]	:= jAux
		EndIf
	EndIf
	If jRet["tipo"]=="ofpie"	//Pizza de pizza: divisão dos pontos e tamanho da secundária
		jAux	:= JsonObject():New()
		jAux["tipo"]		:= oChart:cTipoSec
		jAux["divisao"]	:= oChart:cDivisao
		jAux["valor"]	:= oChart:nDivisao
		jAux["tam"]		:= oChart:nTamSec
		jRet["sec"]		:= jAux
	EndIf
	If jRet["tipo"]=="bubble"
		jRet["escala"]	:= oChart:nEscala
		jRet["tamRepr"]	:= oChart:cTamRepr
	EndIf
	If jRet["tipo"]=="combo"
		For nCont:=1 to Len(oChart:aCharts)
			jMembro	:= ChartJson(oChart:aCharts[nCont][1])
			jMembro["secundario"]	:= oChart:aCharts[nCont][2]
			AADD(aMembros,jMembro)
		Next
		jRet["membros"]	:= aMembros
	EndIf
	For nCont:=1 to Len(oChart:aSeries)
		AADD(aSeries,SerieJson(oChart:aSeries[nCont]))
	Next
	jRet["series"]	:= aSeries
Return jRet

/*/{Protheus.doc} SerieJson
Converte uma série do gráfico em Json
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param oSerie, object, Série do gráfico
@return json, Série do gráfico
/*/
Static Function SerieJson(oSerie As Object)
	Local jRet := JsonObject():New() As Json
	jRet["nome"]	:= If(ValType(oSerie:cNome)=="C",DeUtf8(oSerie:cNome),"")
	jRet["cor"]		:= If(ValType(oSerie:cCor)=="C",oSerie:cCor,"")
	jRet["refVal"]	:= If(ValType(oSerie:cRefVal)=="C",oSerie:cRefVal,"")
	jRet["refCat"]	:= If(ValType(oSerie:cRefCat)=="C",oSerie:cRefCat,"")
	jRet["refX"]	:= If(ValType(oSerie:cRefX)=="C",oSerie:cRefX,"")
	jRet["refY"]	:= If(ValType(oSerie:cRefY)=="C",oSerie:cRefY,"")
	jRet["refTam"]	:= If(ValType(oSerie:cRefTam)=="C",oSerie:cRefTam,"")
	jRet["val"]		:= ArrJson(oSerie:aVal)
	jRet["cat"]		:= ArrJson(oSerie:aCat)
	jRet["x"]		:= ArrJson(oSerie:aX)
	jRet["y"]		:= ArrJson(oSerie:aY)
	jRet["tam"]		:= ArrJson(oSerie:aTam)
	If ValType(oSerie:xMarcador)=="L"
		jRet["marcador"]	:= oSerie:xMarcador
	EndIf
	If ValType(oSerie:xSuavizar)=="L"
		jRet["suavizar"]	:= oSerie:xSuavizar
	EndIf
	If ValType(oSerie:nExplosao)=="N" .and. oSerie:nExplosao>0
		jRet["explosao"]	:= oSerie:nExplosao
	EndIf
Return jRet

/*/{Protheus.doc} ArrJson
Converte um array de dados em array compatível com Json (texto em CP-1252, data em texto e lógico em 1/0)
@type function
@author Saulo Gomes Martins
@since 22/10/2026
@param aDados, variant, Dados (ignorado quando não for array)
@return array, Dados convertidos
/*/
Static Function ArrJson(aDados As Variant)
	Local aRet := {} As Array
	Local nCont As Numeric
	If ValType(aDados)!="A"
		Return aRet
	EndIf
	For nCont:=1 to Len(aDados)
		Do Case
			Case ValType(aDados[nCont])=="N"	;	AADD(aRet,aDados[nCont])
			Case ValType(aDados[nCont])=="C"	;	AADD(aRet,DeUtf8(aDados[nCont]))
			Case ValType(aDados[nCont])=="D"	;	AADD(aRet,DToC(aDados[nCont]))
			Case ValType(aDados[nCont])=="L"	;	AADD(aRet,If(aDados[nCont],1,0))
			Otherwise							;	AADD(aRet,"")
		EndCase
	Next
Return aRet

