	cRet	+= "if(r1<1||c1<1||h<1||w<1){return er(E_REF);}"+Chr(10)
	cRet	+= "return new Rf(a.sec,r1,c1,r1+Math.floor(h)-1,c1+Math.floor(w)-1);"+Chr(10)
	cRet	+= "},'V');"+Chr(10)
	cRet	+= "def('INDIRECT',function(v,cx){"+Chr(10)
	cRet	+= "var s=txt1(v[0]),a1=v[1]===undefined?true:bool1(v[1]),n;"+Chr(10)
	cRet	+= "if(isE(s)){return s;}"+Chr(10)
	cRet	+= "try{"+Chr(10)
	cRet	+= "if(a1===false){var m=/^(?:(.+)!)?R(\d+)C(\d+)$/i.exec(s);if(!m){return er(E_REF);}s=(m[1]?m[1]+'!':'')+colLetra(+m[3])+m[2];}"+Chr(10)
	cRet	+= "n=analisa(s);"+Chr(10)
	cRet	+= "}catch(e){return er(E_REF);}"+Chr(10)
	cRet	+= "var r=ev(n,cx);"+Chr(10)
	cRet	+= "return r instanceof Rf?r:er(E_REF);"+Chr(10)
	cRet	+= "},'V');"+Chr(10)
	cRet	+= "def('TRANSPOSE',function(v){var m=mat(v[0]).v;return new Mt(m[0].map(function(x,j){return m.map(function(l){return l[j];});}));});"+Chr(10)
	cRet	+= "def('SEQUENCE',function(v){"+Chr(10)
	cRet	+= "var l=num1(v[0]),c=v[1]===undefined?1:num1(v[1]),s=v[2]===undefined?1:num1(v[2]),p=v[3]===undefined?1:num1(v[3]),res=[],i,j,ln;"+Chr(10)
	cRet	+= "if(isE(l)){return l;}if(isE(c)){return c;}if(isE(s)){return s;}if(isE(p)){return p;}"+Chr(10)
	cRet	+= "for(i=0;i<l;i++){ln=[];for(j=0;j<c;j++){ln.push(limpa(s+(i*c+j)*p));}res.push(ln);}"+Chr(10)
	cRet	+= "return res.length?new Mt(res):er(E_CALC);"+Chr(10)
	cRet	+= "});"+Chr(10)
	cRet	+= "def('UNIQUE',function(v){"+Chr(10)
	cRet	+= "var m=mat(v[0]).v,col=v[1]!==undefined&&bool1(v[1])===true,uma=v[2]!==undefined&&bool1(v[2])===true,ks={},res=[],its;"+Chr(10)
	cRet	+= "its=col?m[0].map(function(x,j){return m.map(function(l){return l[j];});}):m;"+Chr(10)
	cRet	+= "its.forEach(function(it){var k=it.map(function(x){return tipoRank(x)+':'+String(x).toLowerCase();}).join('\u0001');ks[k]=ks[k]||{n:0,it:it};ks[k].n++;});"+Chr(10)
	cRet	+= "Object.keys(ks).forEach(function(k){if(!uma||ks[k].n===1){res.push(ks[k].it);}});"+Chr(10)
	cRet	+= "if(!res.length){return er(E_CALC);}"+Chr(10)
	cRet	+= "return new Mt(col?res[0].map(function(x,i){return res.map(function(r){return r[i];});}):res);"+Chr(10)
	cRet	+= "});"+Chr(10)
	cRet	+= "def('SORT',function(v){"+Chr(10)
	cRet	+= "var m=mat(v[0]).v.slice(),k=v[1]===undefined?1:num1(v[1]),o=v[2]===undefined?1:num1(v[2]);"+Chr(10)
	cRet	+= "if(isE(k)){return k;}if(isE(o)){return o;}"+Chr(10)
	cRet	+= "m.sort(function(a,b){return compara(a[k-1],b[k-1])*(o<0?-1:1);});"+Chr(10)
	cRet	+= "return new Mt(m);"+Chr(10)
	cRet	+= "});"+Chr(10)
	cRet	+= "def('FILTER',function(v){"+Chr(10)
	cRet	+= "var m=mat(v[0]).v,c=mat(v[1]).v,res=[];"+Chr(10)
	cRet	+= "if(c.length===m.length){m.forEach(function(l,i){var b=bool1(c[i][0]);if(b===true){res.push(l);}});}"+Chr(10)
	cRet	+= "else if(c[0].length===m[0].length){"+Chr(10)
	cRet	+= "var cols=c[0].map(function(x){return bool1(x)===true;});"+Chr(10)
