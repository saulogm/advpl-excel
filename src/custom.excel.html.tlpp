	cRet	+= "return new Mt(res);"+Chr(10)
	cRet	+= "});"+Chr(10)
	cRet	+= "def('TAKE',function(v){var m=mat(v[0]).v,l=v[1]===undefined?m.length:num1(v[1]),c=v[2]===undefined?m[0].length:num1(v[2]);m=l<0?m.slice(l):m.slice(0,l);return new Mt(m.map(function(x){return c<0?x.slice(c):x.slice(0,c);}));});"+Chr(10)
	cRet	+= "def('DROP',function(v){var m=mat(v[0]).v,l=v[1]===undefined?0:num1(v[1]),c=v[2]===undefined?0:num1(v[2]);m=l<0?m.slice(0,l):m.slice(l);m=m.map(function(x){return c<0?x.slice(0,c):x.slice(c);});return m.length&&m[0].length?new Mt(m):er(E_CALC);});"+Chr(10)
	cRet	+= "def('HYPERLINK',function(v){return v[1]===undefined?esc(v[0]):esc(v[1]);});"+Chr(10)
	cRet	+= "/* ---------- formatos numericos (mesma interpretacao do AdvPL) ---------- */"+Chr(10)
	cRet	+= "function corNome(n){var c={red:'#ff0000',blue:'#0000ff',green:'#008000',yellow:'#ffff00',magenta:'#ff00ff',cyan:'#00ffff',white:'#ffffff',black:'#000000'}[n.toLowerCase()];return c||(/^color/i.test(n)?'#000000':'');}"+Chr(10)
	cRet	+= "function sepSecao(f){"+Chr(10)
	cRet	+= "var r=[],at='',i,ch,q=false,b=false;"+Chr(10)
	cRet	+= "for(i=0;i<f.length;i++){"+Chr(10)
	cRet	+= "ch=f.charAt(i);"+Chr(10)
	cRet	+= "if(ch==='"+'"'+"'){q=!q;}else if(ch==='['&&!q){b=true;}else if(ch===']'&&!q){b=false;}"+Chr(10)
	cRet	+= "else if(ch==='\\'&&!q){at+=f.substr(i,2);i++;continue;}"+Chr(10)
	cRet	+= "else if(ch===';'&&!q&&!b){r.push(at);at='';continue;}"+Chr(10)
	cRet	+= "at+=ch;"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "r.push(at);"+Chr(10)
	cRet	+= "return r;"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "function temData(s){"+Chr(10)
	cRet	+= "var q=false,b=false,i,ch;"+Chr(10)
	cRet	+= "for(i=0;i<s.length;i++){"+Chr(10)
	cRet	+= "ch=s.charAt(i);"+Chr(10)
	cRet	+= "if(ch==='"+'"'+"'){q=!q;}"+Chr(10)
	cRet	+= "else if(ch==='\\'&&!q){i++;}"+Chr(10)
	cRet	+= "else if(ch==='['&&!q){b=true;if(/[hms]/i.test(s.charAt(i+1))&&/[hms\]]/i.test(s.charAt(i+2))){return true;}}"+Chr(10)
	cRet	+= "else if(ch===']'){b=false;}"+Chr(10)
	cRet	+= "else if(!q&&!b&&/[ymdhs]/i.test(ch)){return true;}"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "return false;"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "function secao(s){"+Chr(10)
	cRet	+= "var o={tp:'N',pre:'',suf:'',dec:0,mil:false,pct:false,cie:false,mint:0,tok:[],cor:''},i=0,n=s.length,ch,lw,fim,bl,est=0,dt,run,lit;"+Chr(10)
	cRet	+= "if(/^\s*general\s*$/i.test(s)||s===''){o.tp='G';return o;}"+Chr(10)
	cRet	+= "dt=temData(s);"+Chr(10)
	cRet	+= "if(dt){o.tp='D';}"+Chr(10)
	cRet	+= "function add(l){if(dt){o.tok.push(['lit',l]);}else if(est===0){o.pre+=l;}else{o.suf+=l;}}"+Chr(10)
	cRet	+= "while(i<n){"+Chr(10)
	cRet	+= "ch=s.charAt(i);lw=ch.toLowerCase();"+Chr(10)
	cRet	+= "if(ch==='"+'"'+"'){fim=s.indexOf('"+'"'+"',i+1);if(fim<0){fim=n;}add(s.substring(i+1,fim));i=fim+1;continue;}"+Chr(10)
	cRet	+= "if(ch==='\\'){add(s.charAt(i+1));i+=2;continue;}"+Chr(10)
	cRet	+= "if(ch==='_'){add(' ');i+=2;continue;}"+Chr(10)
	cRet	+= "if(ch==='*'){i+=2;continue;}"+Chr(10)
	cRet	+= "if(ch==='['){"+Chr(10)
	cRet	+= "fim=s.indexOf(']',i);if(fim<0){fim=n-1;}"+Chr(10)
	cRet	+= "bl=s.substring(i+1,fim);"+Chr(10)
	cRet	+= "if(bl.charAt(0)==='$'){bl=bl.substring(1);if(bl.indexOf('-')>=0){bl=bl.substring(0,bl.indexOf('-'));}add(bl);}"+Chr(10)
	cRet	+= "else if(dt&&/^(h|hh|m|mm|s|ss)$/i.test(bl)){o.tok.push(['['+bl.charAt(0).toLowerCase()+']','']);}"+Chr(10)
	cRet	+= "else if(corNome(bl)){o.cor=corNome(bl);}"+Chr(10)
	cRet	+= "i=fim+1;continue;"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "if(dt){"+Chr(10)
	cRet	+= "if(s.substr(i,5).toUpperCase()==='AM/PM'){o.tok.push(['ampm','']);i+=5;continue;}"+Chr(10)
	cRet	+= "if(s.substr(i,3).toUpperCase()==='A/P'){o.tok.push(['ap','']);i+=3;continue;}"+Chr(10)
	cRet	+= "if(lw==='a'&&s.substr(i,3).toLowerCase()==='aaa'){run=3;while(i+run<n&&s.charAt(i+run).toLowerCase()==='a'){run++;}o.tok.push([run>3?'dddd':'ddd','']);i+=run;continue;}"+Chr(10)
	cRet	+= "if('ymdhs'.indexOf(lw)>=0){run=1;while(i+run<n&&s.charAt(i+run).toLowerCase()===lw){run++;}o.tok.push([new Array(run+1).join(lw),'']);i+=run;continue;}"+Chr(10)
	cRet	+= "if(ch==='.'&&s.charAt(i+1)==='0'&&o.tok.length&&o.tok[o.tok.length-1][0].charAt(0)==='s'){while(i+1<n&&s.charAt(i+1)==='0'){i++;}i++;continue;}"+Chr(10)
	cRet	+= "if(ch==='@'){i++;continue;}"+Chr(10)
	cRet	+= "add(ch);i++;continue;"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "if(ch==='@'){o.tp='@';add('@');i++;continue;}"+Chr(10)
	cRet	+= "if('0#?'.indexOf(ch)>=0){if(est===0){est=1;}if(est===1&&ch==='0'){o.mint++;}else if(est===2){o.dec++;}i++;continue;}"+Chr(10)
	cRet	+= "if(ch==='.'&&est<=1&&'0#?'.indexOf(s.charAt(i+1))>=0){est=2;i++;continue;}"+Chr(10)
	cRet	+= "if(ch===','&&est===1){o.mil=true;i++;continue;}"+Chr(10)
	cRet	+= "if(lw==='e'&&est>=1&&'+-'.indexOf(s.charAt(i+1))>=0){o.cie=true;i+=2;while(i<n&&'0#'.indexOf(s.charAt(i))>=0){i++;}est=3;continue;}"+Chr(10)
	cRet	+= "if(ch==='%'){o.pct=true;}"+Chr(10)
	cRet	+= "if(est===1||est===2){est=3;}"+Chr(10)
	cRet	+= "add(ch);i++;"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "if(dt){"+Chr(10)
	cRet	+= "o.tok.forEach(function(t,k){"+Chr(10)
	cRet	+= "if(t[0]==='m'||t[0]==='mm'){"+Chr(10)
	cRet	+= "var a=tokVizinho(o.tok,k,-1),p=tokVizinho(o.tok,k,1);"+Chr(10)
	cRet	+= "if('h['.indexOf(a.charAt(0))>=0&&a!==''||p.charAt(0)==='s'){t[0]=t[0].toUpperCase();}"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "});"+Chr(10)
	cRet	+= "}else if(o.tp==='N'&&est===0&&!o.pct){o.tp='L';}"+Chr(10)
	cRet	+= "return o;"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "function tokVizinho(t,k,p){for(var i=k+p;i>=0&&i<t.length;i+=p){if(t[i][0]!=='lit'){return t[i][0];}}return '';}"+Chr(10)
	cRet	+= "function parseFmt(f){"+Chr(10)
	cRet	+= "if(FL.fpar[f]){return FL.fpar[f];}"+Chr(10)
	cRet	+= "var ps=sepSecao(f),ss=[],i;"+Chr(10)
	cRet	+= "for(i=0;i<Math.min(ps.length,4);i++){ss.push(i>0&&ps[i]===''?{tp:'L',pre:'',suf:'',tok:[],cor:''}:secao(ps[i]));}"+Chr(10)
	cRet	+= "if(!ss.length){ss.push(secao('General'));}"+Chr(10)
	cRet	+= "FL.fpar[f]=ss;"+Chr(10)
	cRet	+= "return ss;"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "function numCient(v,d,sd){"+Chr(10)
	cRet	+= "var e=0,m=v;"+Chr(10)
	cRet	+= "if(v!==0){e=Math.floor(Math.log(v)/Math.LN10);if(Math.pow(10,e)>v){e--;}m=v/Math.pow(10,e);if(+m.toFixed(d)>=10){m/=10;e++;}}"+Chr(10)
	cRet	+= "return m.toFixed(d).replace('.',sd)+'E'+(e<0?'-':'+')+('0'+Math.abs(e)).slice(-2);"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "function mascara(v,o,sd,sm){"+Chr(10)
	cRet	+= "var d=o.dec,s,p,ip,dp='';"+Chr(10)
	cRet	+= "if(o.pct){v=v*100;}"+Chr(10)
	cRet	+= "if(o.cie){return numCient(v,d,sd);}"+Chr(10)
	cRet	+= "s=(+v.toPrecision(15)).toFixed(d);"+Chr(10)
	cRet	+= "p=s.indexOf('.');"+Chr(10)
	cRet	+= "ip=p>=0?s.substring(0,p):s;"+Chr(10)
	cRet	+= "if(p>=0){dp=s.substring(p+1);}"+Chr(10)
	cRet	+= "if(ip==='0'&&o.mint===0){ip='';}"+Chr(10)
	cRet	+= "while(ip.length<o.mint){ip='0'+ip;}"+Chr(10)
	cRet	+= "if(o.mil&&ip.length>3){ip=ip.replace(/\B(?=(\d{3})+(?!\d))/g,sm);}"+Chr(10)
	cRet	+= "return ip+(d>0?sd+dp:'');"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "var MESES=['janeiro','fevereiro','mar\u00e7o','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro'];"+Chr(10)
	cRet	+= "var DIAS=['domingo','segunda-feira','ter\u00e7a-feira','quarta-feira','quinta-feira','sexta-feira','s\u00e1bado'];"+Chr(10)
	cRet	+= "function z2(n){return (n<10?'0':'')+n;}"+Chr(10)
	cRet	+= "function fmtData(v,tok){"+Chr(10)
	cRet	+= "var d=serDt(v),sg=Math.round((v-Math.floor(v))*86400),r='',ap=tok.some(function(t){return t[0]==='ampm'||t[0]==='ap';}),h,mi,ss;"+Chr(10)
	cRet	+= "if(sg>=86400){d=new Date(d.getTime()+864e5);sg-=86400;}"+Chr(10)
	cRet	+= "h=Math.floor(sg/3600);mi=Math.floor(sg%3600/60);ss=sg%60;"+Chr(10)
	cRet	+= "tok.forEach(function(t){"+Chr(10)
	cRet	+= "var k=t[0],hh;"+Chr(10)
	cRet	+= "if(k==='lit'){r+=t[1];}"+Chr(10)
	cRet	+= "else if(k==='yyyy'||k==='yyy'){r+=d.getUTCFullYear();}"+Chr(10)
	cRet	+= "else if(k.charAt(0)==='y'){r+=String(d.getUTCFullYear()).slice(-2);}"+Chr(10)
	cRet	+= "else if(k==='mmmmm'){r+=MESES[d.getUTCMonth()].charAt(0);}"+Chr(10)
	cRet	+= "else if(k==='mmmm'){r+=MESES[d.getUTCMonth()];}"+Chr(10)
	cRet	+= "else if(k==='mmm'){r+=MESES[d.getUTCMonth()].substring(0,3);}"+Chr(10)
	cRet	+= "else if(k==='mm'){r+=z2(d.getUTCMonth()+1);}"+Chr(10)
	cRet	+= "else if(k==='m'){r+=d.getUTCMonth()+1;}"+Chr(10)
	cRet	+= "else if(k.length>=4&&k.charAt(0)==='d'){r+=DIAS[d.getUTCDay()];}"+Chr(10)
	cRet	+= "else if(k==='ddd'){r+=DIAS[d.getUTCDay()].substring(0,3);}"+Chr(10)
	cRet	+= "else if(k==='dd'){r+=z2(d.getUTCDate());}"+Chr(10)
	cRet	+= "else if(k==='d'){r+=d.getUTCDate();}"+Chr(10)
	cRet	+= "else if(k==='[h]'){r+=Math.floor(Math.round(v*86400)/3600);}"+Chr(10)
	cRet	+= "else if(k==='[m]'){r+=Math.floor(Math.round(v*86400)/60);}"+Chr(10)
	cRet	+= "else if(k==='[s]'){r+=Math.round(v*86400);}"+Chr(10)
	cRet	+= "else if(k.charAt(0)==='h'){hh=ap?(h%12||12):h;r+=k.length>=2?z2(hh):hh;}"+Chr(10)
	cRet	+= "else if(k==='MM'){r+=z2(mi);}"+Chr(10)
	cRet	+= "else if(k==='M'){r+=mi;}"+Chr(10)
	cRet	+= "else if(k.length>=2&&k.charAt(0)==='s'){r+=z2(ss);}"+Chr(10)
	cRet	+= "else if(k==='s'){r+=ss;}"+Chr(10)
	cRet	+= "else if(k==='ampm'){r+=h<12?'AM':'PM';}"+Chr(10)
	cRet	+= "else if(k==='ap'){r+=h<12?'A':'P';}"+Chr(10)
	cRet	+= "});"+Chr(10)
	cRet	+= "return r;"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "/* formata o numero: retorna {t:texto,cor:cor do formato} */"+Chr(10)
	cRet	+= "function fmtNumero(v,ss,sd,sm){"+Chr(10)
	cRet	+= "sd=sd||',';sm=sm||'.';"+Chr(10)
	cRet	+= "var s,sinal=false,r;"+Chr(10)
	cRet	+= "if(v<0&&ss.length>=2&&ss[1].tp!=='@'){s=ss[1];}"+Chr(10)
	cRet	+= "else if(v===0&&ss.length>=3&&ss[2].tp!=='@'){s=ss[2];}"+Chr(10)
	cRet	+= "else{s=ss[0];sinal=v<0&&s.tp!=='D';}"+Chr(10)
	cRet	+= "if(s.tp==='D'){return {t:fmtData(v,s.tok),cor:s.cor};}"+Chr(10)
	cRet	+= "if(s.tp==='G'){r=numGeral(Math.abs(v),sd);}"+Chr(10)
	cRet	+= "else if(s.tp==='@'){r=(s.pre+s.suf).replace(/@/g,numGeral(Math.abs(v),sd));}"+Chr(10)
	cRet	+= "else if(s.tp==='L'){r=s.pre;}"+Chr(10)
	cRet	+= "else{r=s.pre+mascara(Math.abs(v),s,sd,sm)+s.suf;}"+Chr(10)
	cRet	+= "if(sinal){r='-'+r;}"+Chr(10)
	cRet	+= "return {t:r.trim(),cor:s.cor};"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "X.formata=function(v,codigo){return fmtNumero(v,parseFmt(codigo)).t;};"+Chr(10)
	cRet	+= "/* ---------- celulas com formula ---------- */"+Chr(10)
	cRet	+= "var CALC={pass:0,todas:[],idx:{},blk:{},faixas:[],vol:[],vis:[]};"+Chr(10)
	cRet	+= "function chaveCel(sec,r,c){return sec.getAttribute('data-plan')+'|'+r+'|'+c;}"+Chr(10)
	cRet	+= "function estiloTd(td){var m=/(?:^|\s)s(\d+)(?:\s|$)/.exec(td.className);return m?m[1]:'0';}"+Chr(10)
	cRet	+= "function formatoTd(td){var s=estiloTd(td),f=FL.fmt[s];return parseFmt(f===undefined?'General':f);}"+Chr(10)
	cRet	+= "/* exibe o valor calculado na celula, com o formato numerico do estilo */"+Chr(10)
	cRet	+= "function exibe(td){"+Chr(10)
	cRet	+= "var v=td._v,txt,cor='',alvo,sp;"+Chr(10)
	cRet	+= "if(v instanceof Mt){v=v.v[0][0];}"+Chr(10)
	cRet	+= "if(v instanceof Rf){v=esc(v);}"+Chr(10)
	cRet	+= "if(v instanceof Lb){v=er(E_CALC);}"+Chr(10)
	cRet	+= "td.classList.remove('xh-n');td.classList.remove('xh-b');td.removeAttribute('data-v');"+Chr(10)
	cRet	+= "if(typeof v==='number'){"+Chr(10)
	cRet	+= "var r=fmtNumero(v,formatoTd(td));txt=r.t;cor=r.cor;"+Chr(10)
	cRet	+= "td.classList.add('xh-n');td.setAttribute('data-v',String(v));"+Chr(10)
	cRet	+= "}else if(typeof v==='boolean'){txt=v?'VERDADEIRO':'FALSO';td.classList.add('xh-b');td.setAttribute('data-v',v?'1':'0');}"+Chr(10)
	cRet	+= "else if(isE(v)){txt=v.e;}"+Chr(10)
	cRet	+= "else{txt=v===null||v===undefined?'':String(v);}"+Chr(10)
	cRet	+= "alvo=td.querySelector('a.xh-lk')||td.querySelector('.xh-rot');"+Chr(10)
	cRet	+= "if(!alvo){"+Chr(10)
	cRet	+= "qa(':scope > :not(.xh-fb):not(.xh-ic)',td).forEach(function(e){e.remove();});"+Chr(10)
	cRet	+= "Array.prototype.slice.call(td.childNodes).forEach(function(nd){if(nd.nodeType===3){nd.remove();}});"+Chr(10)
	cRet	+= "alvo=mk('span','xh-fv');td.appendChild(alvo);"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "alvo.textContent=txt;"+Chr(10)
	cRet	+= "alvo.style.color=cor||'';"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "/* areas (precedentes) da formula para o grafo de dependencias */"+Chr(10)
	cRet	+= "function precedentes(td,a,res,cx){"+Chr(10)
	cRet	+= "if(!a||typeof a!=='object'){return;}"+Chr(10)
	cRet	+= "switch(a[0]){"+Chr(10)
	cRet	+= "case 'r':"+Chr(10)
	cRet	+= "var sec=a[1]===null?cx.sec:secNome(a[1]);"+Chr(10)
	cRet	+= "if(sec){res.push({sec:sec,r1:a[2],c1:a[3],r2:a[4]<0?1e9:a[4],c2:a[5]<0?1e9:a[5]});}"+Chr(10)
	cRet	+= "return;"+Chr(10)
	cRet	+= "case 't':"+Chr(10)
	cRet	+= "var t=estrut(a[1],a[2],cx);"+Chr(10)
	cRet	+= "if(t instanceof Rf){res.push({sec:t.sec,r1:t.r1,c1:t.c1,r2:t.r2,c2:t.c2});}"+Chr(10)
	cRet	+= "return;"+Chr(10)
	cRet	+= "case 'nm':"+Chr(10)
	cRet	+= "var s2=a[2]?secNome(a[2]):cx.sec,f=s2?nomesMeta(s2)[a[1]]:undefined;"+Chr(10)
	cRet	+= "if(f!==undefined){try{precedentes(td,analisa(f),res,{sec:s2,td:td});}catch(e){res.vol=true;}}"+Chr(10)
	cRet	+= "return;"+Chr(10)
	cRet	+= "case 'f':"+Chr(10)
	cRet	+= "var d=FX[a[1]];"+Chr(10)
	cRet	+= "if(d&&d.fl.indexOf('V')>=0){res.vol=true;}"+Chr(10)
	cRet	+= "a[2].forEach(function(x){precedentes(td,x,res,cx);});"+Chr(10)
	cRet	+= "return;"+Chr(10)
	cRet	+= "case 'a':a[1].forEach(function(l){l.forEach(function(x){precedentes(td,x,res,cx);});});return;"+Chr(10)
	cRet	+= "case 'c':precedentes(td,a[1],res,cx);a[2].forEach(function(x){precedentes(td,x,res,cx);});return;"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "for(var i=1;i<a.length;i++){if(Array.isArray(a[i])){precedentes(td,a[i],res,cx);}}"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "function preparaFormulas(){"+Chr(10)
	cRet	+= "var dx=q('#xh-fmt');"+Chr(10)
	cRet	+= "if(dx){try{var j=JSON.parse(dx.textContent);FL.fmt=j.fmt||{};FL.loc=j.local||'pt-BR';}catch(e){}}"+Chr(10)
	cRet	+= "CALC.todas=[];CALC.idx={};CALC.blk={};CALC.faixas=[];CALC.vol=[];CALC.vis=[];"+Chr(10)
	cRet	+= "secoes().forEach(function(sec){"+Chr(10)
	cRet	+= "var g=grade(sec);"+Chr(10)
	cRet	+= "qa('td[data-f]',sec).forEach(function(td){"+Chr(10)
	cRet	+= "if(tdInp(td)){return;}"+Chr(10)
	cRet	+= "var f=td.getAttribute('data-f'),deps=[];"+Chr(10)
	cRet	+= "try{td._a=analisa(f);}catch(e){return;}"+Chr(10)
	cRet	+= "td._f=f;td._sec=sec;td._ok=true;td._v=valBruto(td);"+Chr(10)
	cRet	+= "td._st=/(^|[^A-Z0-9_.])(SUBTOTAL|AGGREGATE)\s*\(/i.test(f);"+Chr(10)
	cRet	+= "CALC.todas.push(td);"+Chr(10)
	cRet	+= "precedentes(td,td._a,deps,{sec:sec,td:td});"+Chr(10)
	cRet	+= "if(deps.vol){CALC.vol.push(td);}"+Chr(10)
	cRet	+= "if(td._st){CALC.vis.push(td);}"+Chr(10)
	cRet	+= "deps.forEach(function(d){"+Chr(10)
	cRet	+= "if(d.r1===d.r2&&d.c1===d.c2){var k=chaveCel(d.sec,d.r1,d.c1);(CALC.idx[k]=CALC.idx[k]||[]).push(td);}"+Chr(10)
	cRet	+= "else{"+Chr(10)
	cRet	+= "d.td=td;"+Chr(10)
	cRet	+= "/* faixas pequenas ficam indexadas por bloco de 64 linhas; as grandes sao varridas */"+Chr(10)
	cRet	+= "if(d.r2-d.r1<256){for(var b=d.r1>>6;b<=d.r2>>6;b++){var kb=d.sec.getAttribute('data-plan')+'|'+b;(CALC.blk[kb]=CALC.blk[kb]||[]).push(d);}}"+Chr(10)
	cRet	+= "else{CALC.faixas.push(d);}"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "});"+Chr(10)
	cRet	+= "});"+Chr(10)
	cRet	+= "});"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "/* calcula a celula (os precedentes pendentes sao calculados antes, por recursao) */"+Chr(10)
	cRet	+= "function calcTd(td){"+Chr(10)
	cRet	+= "if(td._ok||td._calc){return;}"+Chr(10)
	cRet	+= "td._calc=true;"+Chr(10)
	cRet	+= "var v;"+Chr(10)
	cRet	+= "try{"+Chr(10)
	cRet	+= "v=ev(td._a,{sec:td._sec,td:td,sc:null});"+Chr(10)
	cRet	+= "if(v instanceof Rf){v=multi(v)?mat(v).v[0][0]:esc(v);}"+Chr(10)
	cRet	+= "else if(v instanceof Mt){v=v.v[0][0];}"+Chr(10)
	cRet	+= "td._v=v===null||v===undefined?0:v;"+Chr(10)
	cRet	+= "}catch(e){"+Chr(10)
	cRet	+= "/* funcao desconhecida ou erro interno: mantem o valor gravado */"+Chr(10)
	cRet	+= "if(!(e instanceof SemFn)&&window.console){console.warn('xlsxHtml formula',td._f,e);}"+Chr(10)
	cRet	+= "td._v=valBruto(td);"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "td._calc=false;td._ok=true;td._mud=CALC.pass;"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "function dependentes(sec,r,c,fn){"+Chr(10)
	cRet	+= "(CALC.idx[chaveCel(sec,r,c)]||[]).forEach(fn);"+Chr(10)
	cRet	+= "var i,d,l=CALC.blk[sec.getAttribute('data-plan')+'|'+(r>>6)]||[];"+Chr(10)
	cRet	+= "for(i=0;i<l.length;i++){d=l[i];if(r>=d.r1&&r<=d.r2&&c>=d.c1&&c<=d.c2){fn(d.td);}}"+Chr(10)
	cRet	+= "for(i=0;i<CALC.faixas.length;i++){d=CALC.faixas[i];if(d.sec===sec&&r>=d.r1&&r<=d.r2&&c>=d.c1&&c<=d.c2){fn(d.td);}}"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "/* recalcula as formulas que dependem das celulas alteradas (lista de td) e as indicadas em extra */"+Chr(10)
	cRet	+= "function recalcula(alt,extra){"+Chr(10)
	cRet	+= "var fila=[],suj=[],i,td;"+Chr(10)
	cRet	+= "CALC.pass++;"+Chr(10)
	cRet	+= "function marca(t){if(t._sj===CALC.pass){return;}t._sj=CALC.pass;t._ok=false;suj.push(t);fila.push(t);}"+Chr(10)
	cRet	+= "(extra||[]).forEach(marca);"+Chr(10)
	cRet	+= "CALC.vol.forEach(marca);"+Chr(10)
	cRet	+= "(alt||[]).forEach(function(t){fila.push(t);});"+Chr(10)
	cRet	+= "while(fila.length){"+Chr(10)
	cRet	+= "td=fila.pop();"+Chr(10)
	cRet	+= "if(td._r===undefined){grade(td.closest('.xh-sec'));}"+Chr(10)
	cRet	+= "dependentes(td._sec||td.closest('.xh-sec'),td._r,td._c,marca);"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "for(i=0;i<suj.length;i++){calcTd(suj[i]);}"+Chr(10)
	cRet	+= "suj.forEach(exibe);"+Chr(10)
	cRet	+= "if(suj.length){"+Chr(10)
	cRet	+= "document.dispatchEvent(new CustomEvent('xlsxhtml:recalculo',{detail:{celulas:suj}}));"+Chr(10)
	cRet	+= "if(X.aposRecalculo){X.aposRecalculo(suj);}"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "return suj;"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "X.recalcula=function(ref){"+Chr(10)
	cRet	+= "var r=ref?recalcula(celulas(ref)):recalcula(null,CALC.todas);"+Chr(10)
	cRet	+= "reavalia();"+Chr(10)
	cRet	+= "return r;"+Chr(10)
	cRet	+= "};"+Chr(10)
	cRet	+= "X.calcula=function(f,plan){"+Chr(10)
	cRet	+= "var sec=plan===undefined?(q('.xh-sec.xh-on')||secoes()[0]):(typeof plan==='number'?q('.xh-sec[data-plan="+'"'+"'+plan+'"+'"'+"]'):secNome(plan));"+Chr(10)
	cRet	+= "var v=ev(analisa(String(f).replace(/^=/,'')),{sec:sec,td:null,sc:null});"+Chr(10)
	cRet	+= "v=v instanceof Rf||v instanceof Mt?(unica(v)?esc(v):mat(v).v):v;"+Chr(10)
	cRet	+= "return isE(v)?v.e:v;"+Chr(10)
	cRet	+= "};"+Chr(10)
	cRet	+= "X.valorFormula=function(ref){var td=celulas(ref)[0];if(!td){return null;}var v=valTd(td);return isE(v)?v.e:v;};"+Chr(10)
	cRet	+= "var pendInp=[],agInp=0;"+Chr(10)
	cRet	+= "function eventoInput(ev){"+Chr(10)
	cRet	+= "var inp=ev.target;"+Chr(10)
	cRet	+= "if(!inp||!inp.classList||!inp.classList.contains('xh-in')){return;}"+Chr(10)
	cRet	+= "var td=inp.closest('td');"+Chr(10)
	cRet	+= "if(!td){return;}"+Chr(10)
	cRet	+= "if(pendInp.indexOf(td)<0){pendInp.push(td);}"+Chr(10)
	cRet	+= "if(!agInp){agInp=(window.requestAnimationFrame||setTimeout)(function(){agInp=0;var l=pendInp;pendInp=[];if(CALC.todas.length){recalcula(l);}reavalia();});}"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "/* apos input, filtro ou agrupamento: subtotais das linhas visiveis, graficos, formatacao condicional e layout (uma vez por quadro) */"+Chr(10)
	cRet	+= "var agRe=0,reVis=false;"+Chr(10)
	cRet	+= "function reavalia(vis){"+Chr(10)
	cRet	+= "if(vis){reVis=true;}"+Chr(10)
	cRet	+= "if(agRe){return;}"+Chr(10)
	cRet	+= "agRe=(window.requestAnimationFrame||setTimeout)(function(){"+Chr(10)
	cRet	+= "agRe=0;"+Chr(10)
	cRet	+= "if(reVis){reVis=false;if(CALC.vis.length){recalcula(null,CALC.vis);}}"+Chr(10)
	cRet	+= "secoes().forEach(function(s){condicional(s);});"+Chr(10)
	cRet	+= "atualizaGraficos();"+Chr(10)
	cRet	+= "qa('.xh-sec.xh-on').forEach(layout);"+Chr(10)
	cRet	+= "});"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "function formulas(){"+Chr(10)
	cRet	+= "preparaFormulas();"+Chr(10)
	cRet	+= "document.addEventListener('input',eventoInput);"+Chr(10)
	cRet	+= "document.addEventListener('change',eventoInput);"+Chr(10)
	cRet	+= "if(!CALC.todas.length){return;}"+Chr(10)
	cRet	+= "/* formulas sem valor gravado (o AdvPL nao calculou): calcula no navegador */"+Chr(10)
	cRet	+= "recalcula(null,CALC.todas.filter(function(td){return td._v===null&&td.textContent==='';}));"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "X.visibilidade=function(){reavalia(true);};"+Chr(10)
Return cRet
