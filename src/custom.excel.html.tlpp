	cRet	+= "def('BYCOL',function(v){var l=lbArg(v[1]),m=mat(v[0]).v;if(!l){return er(E_VAL);}return new Mt([m[0].map(function(x,j){return esc(chamaLb(l,[new Mt(m.map(function(ln){return [ln[j]];}))]));})]);});"+Chr(10)
