	cRet	+= "if(isE(a)){return a;}if(isE(b)){return b;}if(isE(u)){return u;}"+Chr(10)
	cRet	+= "if(b<a){return er(E_NUM);}"+Chr(10)
	cRet	+= "var d1_=serDt(a),d2=serDt(b),m=(d2.getUTCFullYear()-d1_.getUTCFullYear())*12+d2.getUTCMonth()-d1_.getUTCMonth();"+Chr(10)
	cRet	+= "if(d2.getUTCDate()<d1_.getUTCDate()){m--;}"+Chr(10)
	cRet	+= "switch(u.toUpperCase()){"+Chr(10)
	cRet	+= "case 'D':return Math.floor(b)-Math.floor(a);"+Chr(10)
	cRet	+= "case 'M':return m;"+Chr(10)
	cRet	+= "case 'Y':return Math.floor(m/12);"+Chr(10)
	cRet	+= "case 'YM':return m%12;"+Chr(10)
	cRet	+= "case 'MD':var x=new Date(Date.UTC(d2.getUTCFullYear(),d2.getUTCMonth()-(d2.getUTCDate()<d1_.getUTCDate()?1:0),d1_.getUTCDate()));return Math.round((d2-x)/864e5);"+Chr(10)
	cRet	+= "case 'YD':var y=new Date(Date.UTC(d2.getUTCFullYear()-((d2.getUTCMonth()<d1_.getUTCMonth()||(d2.getUTCMonth()===d1_.getUTCMonth()&&d2.getUTCDate()<d1_.getUTCDate()))?1:0),d1_.getUTCMonth(),d1_.getUTCDate()));return Math.round((d2-y)/864e5);"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "return er(E_NUM);"+Chr(10)
	cRet	+= "},fl:''};"+Chr(10)
	cRet	+= "/* ---------- pesquisa e referencia ---------- */"+Chr(10)
	cRet	+= "function igualBusca(x,v,cur){"+Chr(10)
	cRet	+= "if(isE(x)){return false;}"+Chr(10)
	cRet	+= "if(typeof v==='string'&&typeof x==='string'){return cur&&/[*?~]/.test(v)?curinga(v).test(x):x.toLowerCase()===v.toLowerCase();}"+Chr(10)
	cRet	+= "return compara(x,v)===0&&tipoRank(x)===tipoRank(v);"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "/* posicao (0 based) em uma lista: modo 0 exato, 1 maior <= v (ordenado), -1 menor >= v (decrescente) */"+Chr(10)
	cRet	+= "function posicao(a,v,modo,cur){"+Chr(10)
	cRet	+= "var i,p=-1;"+Chr(10)
	cRet	+= "if(modo===0){for(i=0;i<a.length;i++){if(igualBusca(a[i],v,cur)){return i;}}return -1;}"+Chr(10)
	cRet	+= "for(i=0;i<a.length;i++){"+Chr(10)
	cRet	+= "var x=a[i];"+Chr(10)
	cRet	+= "if(x===null||isE(x)||tipoRank(x)!==tipoRank(v)){continue;}"+Chr(10)
	cRet	+= "var c=compara(x,v);"+Chr(10)
	cRet	+= "if(modo>0){if(c<=0){p=i;}else{break;}}else{if(c>=0){p=i;}else{break;}}"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "return p;"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "def('MATCH',function(v){"+Chr(10)
	cRet	+= "var x=esc(v[0]),m=v[2]===undefined?1:num1(v[2]),a=lista(v[1]);"+Chr(10)
	cRet	+= "if(isE(x)){return x;}if(isE(m)){return m;}"+Chr(10)
	cRet	+= "if(multi(v[1])&&mat(v[1]).v.length>1&&mat(v[1]).v[0].length>1){return er(E_NA);}"+Chr(10)
	cRet	+= "var p=posicao(a,x,m>0?1:m<0?-1:0,true);"+Chr(10)
	cRet	+= "return p<0?er(E_NA):p+1;"+Chr(10)
	cRet	+= "});"+Chr(10)
	cRet	+= "function procV(v,horiz){"+Chr(10)
	cRet	+= "var x=esc(v[0]),m=mat(v[1]).v,k=num1(v[2]),aprox=v[3]===undefined?true:bool1(v[3]),col,p;"+Chr(10)
	cRet	+= "if(isE(x)){return x;}if(isE(k)){return k;}if(isE(aprox)){return aprox;}"+Chr(10)
	cRet	+= "if(horiz){col=m[0];}else{col=m.map(function(l){return l[0];});}"+Chr(10)
	cRet	+= "k=Math.floor(k);"+Chr(10)
	cRet	+= "if(k<1){return er(E_VAL);}"+Chr(10)
	cRet	+= "if(horiz?k>m.length:k>m[0].length){return er(E_REF);}"+Chr(10)
	cRet	+= "p=posicao(col,x,aprox?1:0,true);"+Chr(10)
	cRet	+= "if(p<0){return er(E_NA);}"+Chr(10)
	cRet	+= "return horiz?m[k-1][p]:m[p][k-1];"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "def('VLOOKUP',function(v){return procV(v,false);});"+Chr(10)
	cRet	+= "def('HLOOKUP',function(v){return procV(v,true);});"+Chr(10)
	cRet	+= "def('LOOKUP',function(v){"+Chr(10)
	cRet	+= "var x=esc(v[0]),m=mat(v[1]).v,b,r,p;"+Chr(10)
	cRet	+= "if(isE(x)){return x;}"+Chr(10)
	cRet	+= "if(v[2]===undefined){"+Chr(10)
	cRet	+= "if(m[0].length>m.length){b=m[0];r=m[m.length-1];}else{b=m.map(function(l){return l[0];});r=m.map(function(l){return l[l.length-1];});}"+Chr(10)
	cRet	+= "}else{b=lista(v[1]);r=lista(v[2]);}"+Chr(10)
	cRet	+= "p=posicao(b,x,1);"+Chr(10)
	cRet	+= "return p<0?er(E_NA):(r[p]===undefined?er(E_NA):r[p]);"+Chr(10)
	cRet	+= "});"+Chr(10)
	cRet	+= "def('INDEX',function(v){"+Chr(10)
	cRet	+= "var a=v[0],l=v[1]===undefined?0:num1(v[1]),c=v[2]===undefined?0:num1(v[2]),nl,nc;"+Chr(10)
	cRet	+= "if(isE(a)){return a;}if(isE(l)){return l;}if(isE(c)){return c;}"+Chr(10)
	cRet	+= "l=Math.floor(l);c=Math.floor(c);"+Chr(10)
	cRet	+= "if(a instanceof Rf){"+Chr(10)
	cRet	+= "nl=a.r2-a.r1+1;nc=a.c2-a.c1+1;"+Chr(10)
	cRet	+= "if(v[2]===undefined&&nl===1&&nc>1){c=l;l=1;}"+Chr(10)
	cRet	+= "if(l<0||c<0||l>nl||c>nc){return er(E_REF);}"+Chr(10)
	cRet	+= "return new Rf(a.sec,l?a.r1+l-1:a.r1,c?a.c1+c-1:a.c1,l?a.r1+l-1:a.r2,c?a.c1+c-1:a.c2);"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "var m=mat(a).v;"+Chr(10)
