	cRet	+= "t1('REPLACE',function(s,i,n,novo){i=num1(i);n=num1(n);if(isE(i)){return i;}if(isE(n)){return n;}s=tx(s);return s.substring(0,i-1)+tx(novo)+s.substring(i-1+n);});"+Chr(10)
	cRet	+= "t1('FIND',function(f,s,i){i=nn(i,1);if(isE(i)){return i;}var p=tx(s).indexOf(tx(f),i-1);return p<0||i<1?er(E_VAL):p+1;});"+Chr(10)
