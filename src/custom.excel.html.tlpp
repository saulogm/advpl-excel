	cRet	+= "if(v[2]===undefined&&m[0].length===1){c=1;}"+Chr(10)
	cRet	+= "if(l<0||c<0||l>m.length||c>m[0].length){return er(E_REF);}"+Chr(10)
	cRet	+= "if(!l){return new Mt(m.map(function(x){return [x[c-1]];}));}"+Chr(10)
	cRet	+= "if(!c){return new Mt([m[l-1]]);}"+Chr(10)
	cRet	+= "return m[l-1][c-1];"+Chr(10)
	cRet	+= "});"+Chr(10)
	cRet	+= "def('XLOOKUP',function(v){"+Chr(10)
	cRet	+= "var x=esc(v[0]),b=lista(v[1]),mr=mat(v[2]).v,nf=v[3],mo=v[4]===undefined?0:num1(v[4]),bu=v[5]===undefined?1:num1(v[5]),i,p=-1,vert,best=null;"+Chr(10)
	cRet	+= "if(isE(x)){return x;}"+Chr(10)
	cRet	+= "var mb=mat(v[1]).v;vert=mb.length>1||mb[0].length===1;"+Chr(10)
	cRet	+= "var ord=bu<0?b.map(function(z,k){return k;}).reverse():b.map(function(z,k){return k;});"+Chr(10)
