	cRet	+= "i=ord[t];var y=b[i];"+Chr(10)
	cRet	+= "if(mo===2?(typeof y==='string'&&typeof x==='string'&&curinga(x).test(y)):igualBusca(y,x,false)){p=i;break;}"+Chr(10)
	cRet	+= "if((mo===-1||mo===1)&&y!==null&&!isE(y)&&tipoRank(y)===tipoRank(x)){"+Chr(10)
	cRet	+= "var c=compara(y,x);"+Chr(10)
	cRet	+= "if(mo===-1&&c<0&&(best===null||compara(y,b[best])>0)){best=i;}"+Chr(10)
	cRet	+= "if(mo===1&&c>0&&(best===null||compara(y,b[best])<0)){best=i;}"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "if(p<0){p=best===null?-1:best;}"+Chr(10)
	cRet	+= "if(p<0){return nf===undefined?er(E_NA):nf;}"+Chr(10)
	cRet	+= "if(vert){return mr[p]?(mr[p].length===1?mr[p][0]:new Mt([mr[p]])):er(E_VAL);}"+Chr(10)
	cRet	+= "return mr.length===1?mr[0][p]:new Mt(mr.map(function(l){return [l[p]];}));"+Chr(10)
	cRet	+= "});"+Chr(10)
	cRet	+= "def('XMATCH',function(v){"+Chr(10)
	cRet	+= "var x=esc(v[0]),b=lista(v[1]),mo=v[2]===undefined?0:num1(v[2]),bu=v[3]===undefined?1:num1(v[3]),i,best=null;"+Chr(10)
	cRet	+= "if(isE(x)){return x;}"+Chr(10)
	cRet	+= "var ord=b.map(function(z,k){return k;});if(bu<0){ord.reverse();}"+Chr(10)
	cRet	+= "for(var t=0;t<ord.length;t++){"+Chr(10)
	cRet	+= "i=ord[t];var y=b[i];"+Chr(10)
	cRet	+= "if(mo===2?(typeof y==='string'&&typeof x==='string'&&curinga(x).test(y)):igualBusca(y,x,false)){return i+1;}"+Chr(10)
	cRet	+= "if((mo===-1||mo===1)&&y!==null&&!isE(y)&&tipoRank(y)===tipoRank(x)){"+Chr(10)
	cRet	+= "var c=compara(y,x);"+Chr(10)
	cRet	+= "if(mo===-1&&c<0&&(best===null||compara(y,b[best])>0)){best=i;}"+Chr(10)
	cRet	+= "if(mo===1&&c>0&&(best===null||compara(y,b[best])<0)){best=i;}"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "}"+Chr(10)
	cRet	+= "return best===null?er(E_NA):best+1;"+Chr(10)
	cRet	+= "});"+Chr(10)
	cRet	+= "def('ROW',function(v,cx){if(v[0]===undefined){return cx.td?cx.td._r:er(E_VAL);}return v[0] instanceof Rf?v[0].r1:er(E_VAL);});"+Chr(10)
	cRet	+= "def('COLUMN',function(v,cx){if(v[0]===undefined){return cx.td?cx.td._c:er(E_VAL);}return v[0] instanceof Rf?v[0].c1:er(E_VAL);});"+Chr(10)
	cRet	+= "def('ROWS',function(v){var x=v[0];return x instanceof Rf?x.r2-x.r1+1:mat(x).v.length;});"+Chr(10)
	cRet	+= "def('COLUMNS',function(v){var x=v[0];return x instanceof Rf?x.c2-x.c1+1:mat(x).v[0].length;});"+Chr(10)
	cRet	+= "def('OFFSET',function(v){"+Chr(10)
	cRet	+= "var a=v[0],l=num1(v[1]),c=num1(v[2]),h,w;"+Chr(10)
	cRet	+= "if(!(a instanceof Rf)){return er(E_VAL);}"+Chr(10)
	cRet	+= "if(isE(l)){return l;}if(isE(c)){return c;}"+Chr(10)
	cRet	+= "h=v[3]===undefined?a.r2-a.r1+1:num1(v[3]);w=v[4]===undefined?a.c2-a.c1+1:num1(v[4]);"+Chr(10)
	cRet	+= "if(isE(h)){return h;}if(isE(w)){return w;}"+Chr(10)
