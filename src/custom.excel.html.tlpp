	cRet	+= "t1('VALUE,NUMBERVALUE',function(s){if(typeof s==='number'){return s;}var n=txtNum(tx(s));if(n===null){n=dataTxt(s);}return n===null?er(E_VAL):n;});"+Chr(10)
