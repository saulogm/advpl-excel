	AADD(aRet,{"LOG(100)",2})
	AADD(aRet,{"EVEN(1.5)",2})
	AADD(aRet,{"ODD(-2)",-3})
	//Planilhas, nomes e tabelas
	AADD(aRet,{"Dados!A1+Dados!A2",300})
	AADD(aRet,{"SUM('Dados'!A1:A2)",300})
	AADD(aRet,{"Taxa*10",20})
	AADD(aRet,{"SUM(Tab1[Valor])",60})
	AADD(aRet,{"Tab1[[#Totals],[Valor]]",60})
	AADD(aRet,{'SUMIF(Tab1[Nome],"x",Tab1[Valor])',40})
	AADD(aRet,{"Tab1[@Valor]*2",40,9,8})
	AADD(aRet,{"[@Valor]+1",21,9,7})
	AADD(aRet,{"COUNTA(Tab1[#Headers])",2})
	//Matemática e trigonometria (1b)
	AADD(aRet,{"SIN(PI()/2)",1})
