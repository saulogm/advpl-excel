Return aRet

/*/{Protheus.doc} XCALCINT
Teste de integração: gera xlsx nos modos arquivo (A), memória (M) e banco (B) com fórmulas sem valor,
reabre o arquivo e confere os valores calculados. Resultado em \xcalc_int.log
@type user function
@author Saulo Gomes Martins
@since 25/10/2026
/*/
User Function XCALCINT()
	Local aModos := {"A","M","B"} As Array
	Local nModo As Numeric
	Local cLog := "" As Character
	Local cArq As Character
	Local oErr As Object
	FWMakeDir("\xcalc\",.F.)
	If Type("__TTSInUse")=="U"	//Sem ambiente preparado: modo banco (B) usa SQLite local
		Public __TTSInUse := .F.
		Public __cLogSiga := ""
	EndIf
	For nModo:=1 to Len(aModos)
		Try
			FErase("\xcalc\xcalc_"+aModos[nModo]+".xlsx")	//O Save não sobrescreve arquivo existente
			cArq	:= GeraInt(aModos[nModo])
			cLog	+= "Modo "+aModos[nModo]+": "+cArq+Chr(13)+Chr(10)
			cLog	+= ConfInt(cArq)
		Catch oErr
			cLog	+= "Modo "+aModos[nModo]+" EXCEPTION: "+oErr:Description+Chr(13)+Chr(10)+oErr:ErrorStack+Chr(13)+Chr(10)
		EndTry
	Next
	MemoWrite("\xcalc_int.log",cLog)
	ConOut(cLog)
	FwFreeArray(aModos)
Return 0

Static Function GeraInt(cTipo As Character)
	Local oExcel := custom.excel.Xlsx():New("xcalc_"+cTipo,,cTipo) As Object
	Local aCampos := {} As Array
	Local oTab As Object
	Local nCont As Numeric
	Local cArq As Character
	oExcel:ADDPlan("Dados")
	oExcel:Cell(1,1,"Item")
	oExcel:Cell(1,2,"Qtd")
	oExcel:Cell(1,3,"Preco")
	oExcel:Cell(1,4,"Total")
	oExcel:Cell(1,5,"Maior")
	For nCont:=2 to 4
		oExcel:Cell(nCont,1,Chr(118+nCont))
		oExcel:Cell(nCont,2,nCont)
		oExcel:Cell(nCont,3,(nCont-1)*10)
		oExcel:Cell(nCont,4,nil,"B"+cValToChar(nCont)+"*C"+cValToChar(nCont))
		If nCont==2
			oExcel:Cell(nCont,5,nil,"D2>30")
		EndIf
	Next
	oExcel:Cell(5,1,nil,'IF(D5>100,"alto","baixo")')
	oExcel:Cell(5,2,nil,"AVERAGE(B2:B4)")
	oExcel:Cell(5,3,nil,"1/0")
	oExcel:Cell(5,4,nil,"SUM(D2:D4)")
	oExcel:Cell(5,5,nil,"FUNCAOXYZ(1)")
	oExcel:AddNome("Total",5,4)
	//Bulk com fórmula por linha
	AADD(aCampos,oExcel:BulkNewField(nColuna = 1, cTipo = "N"))
	AADD(aCampos,oExcel:BulkNewField(nColuna = 2, cTipo = "N", lFormula = .T.))
	oExcel:DefBulkLine(aCampos)
	oExcel:nLinha	:= 10
	For nCont:=1 to 3
		oExcel:SetValueBulk(nCont)
		oExcel:SetValueBulk(nil,"A"+cValToChar(oExcel:nLinha)+"*10")
		oExcel:SetBulkLine()
	Next
	oExcel:FlushBulk()
	oExcel:ADDPlan("Resumo")
	oExcel:Cell(1,1,nil,"Dados!D5*2")
	oExcel:Cell(2,1,nil,"SUM(Dados!B2:B4)")
	oExcel:Cell(3,1,nil,"Total+1")
	oExcel:Cell(4,1,nil,"SUM(Dados!B10:B12)")
	oExcel:ADDPlan("Tab")
	oTab	:= oExcel:AddTabela("TabV",1,1)
	oTab:AddColumn("Nome")
	oTab:AddColumn("Valor")
	For nCont:=1 to 3
		oTab:AddLine()
		oTab:Cell("Nome","n"+cValToChar(nCont))
		oTab:Cell("Valor",nCont*10)
	Next
	oTab:AddTotal("Valor",nil,"SUM")
	oTab:AddTotais()
	oTab:Finish()
	cArq	:= oExcel:Save("\xcalc")
	oExcel:Close()
	FreeObj(oExcel)
	FwFreeArray(aCampos)
Return cArq

Static Function ConfInt(cArq As Character)
	Local oLer := custom.excel.Xlsx():New(,cArq) As Object
	Local aEsp := {} As Array
	Local nCont As Numeric
	Local xVal As Variant
	Local cRet := "" As Character
	Local nOk := 0 As Numeric
	AADD(aEsp,{1,2,4,20})
	AADD(aEsp,{1,3,4,60})
	AADD(aEsp,{1,4,4,120})
	AADD(aEsp,{1,5,4,200})
	AADD(aEsp,{1,5,2,3})
	AADD(aEsp,{1,5,1,"alto"})
	AADD(aEsp,{1,5,3,"#DIV/0!"})
	AADD(aEsp,{1,2,5,.F.})
	AADD(aEsp,{1,10,2,10})
	AADD(aEsp,{1,12,2,30})
	AADD(aEsp,{2,1,1,400})
	AADD(aEsp,{2,2,1,9})
	AADD(aEsp,{2,3,1,201})
	AADD(aEsp,{2,4,1,60})
	AADD(aEsp,{3,5,2,60})
	For nCont:=1 to Len(aEsp)
		oLer:SetPlanAt(aEsp[nCont][1])
		xVal	:= oLer:GetValue(aEsp[nCont][2],aEsp[nCont][3])
		If ValType(xVal)==ValType(aEsp[nCont][4]) .AND. xVal==aEsp[nCont][4]
			nOk++
		Else
			cRet	+= "  FALHA plan "+cValToChar(aEsp[nCont][1])+" "+oLer:Ref(aEsp[nCont][2],aEsp[nCont][3])+" esperado="+cValToChar(aEsp[nCont][4])+" obtido="+cValToChar(xVal)+" ("+ValType(xVal)+")"+Chr(13)+Chr(10)
		EndIf
	Next
	cRet	:= "  "+cValToChar(nOk)+"/"+cValToChar(Len(aEsp))+" ok"+Chr(13)+Chr(10)+cRet
	oLer:Close()
	FreeObj(oLer)
	FwFreeArray(aEsp)
Return cRet

/*/{Protheus.doc} CasosPtBr
Casos executados com a localidade pt-BR
/*/
Static Function CasosPtBr()
	Local aRet := {} As Array
	AADD(aRet,{'"v="&0.5',"v=0,5"})
	AADD(aRet,{'TEXT(1234.567,"#.##0,00")',"1.234,57"})
	AADD(aRet,{'TEXT(45000,"dddd")',"quarta-feira"})
	AADD(aRet,{'TEXT(45000,"dd/mmm/aaaa")',"15/mar/2023"})
	AADD(aRet,{'TEXT(45000,"dd \d\e mmmm \d\e yyyy")',"15 de março de 2023"})
	AADD(aRet,{'VALUE("1.234,5")',1234.5})
	AADD(aRet,{'VALUE("31/12/2024")',45657})
	AADD(aRet,{'VALUE("31/12/2024 18:00")',45657.75})
	AADD(aRet,{'FIXED(1234.5,2)',"1.234,50"})
	AADD(aRet,{'DOLLAR(1234.5)',"R$ 1.234,50"})
	AADD(aRet,{'DOLLAR(-2)',"-R$ 2,00"})
	AADD(aRet,{'"1,5"*2',3})
	AADD(aRet,{'COUNTIF({1.5,2.5},">2")',1})
	AADD(aRet,{'TEXT(0.5,"0,0%")',"50,0%"})
Return aRet
