// Testes do motor de fórmulas (custom.excel.calc) com provedor de células em memória
// Execução sem interface: appserver.exe -run=U_XCALCTST -env=<ambiente>
// Resultado gravado em \xcalc_teste.log (RootPath)
#include "tlpp-core.th"
#include "totvs.ch"

/*/{Protheus.doc} XCalcProv
Provedor de células em memória para testes do motor
@type class
@author Saulo Gomes Martins
@since 25/10/2026
/*/
Class XCalcProv
	Public Data oCel		As Object
	Public Data aCel		As Array
	Public Data aPlan		As Array
	Public Data aOcultas	As Array
	Public Data oNomes		As Object
	Public Data aTabelas	As Array
	Public Method New()		As Object
	Public Method Set()
	Public Method CalcCel()
	Public Method CalcFaixa()
	Public Method CalcPlan()
	Public Method CalcNomePlan()
	Public Method CalcQtdPlan()
	Public Method CalcDim()
	Public Method CalcNome()
	Public Method CalcTabela()
	Public Method CalcTabCel()
	Public Method CalcOculta()
EndClass

Method New() As Object Class XCalcProv
	::oCel		:= tHashMap():New()
	::aCel		:= {}
	::aPlan		:= {"Plan1","Dados"}
	::aOcultas	:= {}
	::oNomes	:= tHashMap():New()
	::aTabelas	:= {}
Return self

//Grava célula: valor ou fórmula pendente
Method Set(nPla As Numeric, nLin As Numeric, nCol As Numeric, xValor As Variant, cFormula As Character) Class XCalcProv
	Default cFormula	:= ""
	::oCel:Set(cValToChar(nPla)+"|"+cValToChar(nLin)+"|"+cValToChar(nCol),{xValor,cFormula,!Empty(cFormula)})
	AADD(::aCel,{nPla,nLin,nCol})
Return

Method CalcCel(nPla As Numeric, nLin As Numeric, nCol As Numeric) Class XCalcProv
	Local aRet As Array
	If ::oCel:Get(cValToChar(nPla)+"|"+cValToChar(nLin)+"|"+cValToChar(nCol),@aRet)
		Return aRet
	EndIf
Return nil

Method CalcFaixa(nPla As Numeric, nL1 As Numeric, nC1 As Numeric, nL2 As Numeric, nC2 As Numeric) Class XCalcProv
	Local aRet := {} As Array
	Local nCont As Numeric
	Local aCel As Array
	Local aPos As Array
	For nCont:=1 to Len(::aCel)
		aPos	:= ::aCel[nCont]
		If aPos[1]==nPla .AND. aPos[2]>=nL1 .AND. aPos[2]<=nL2 .AND. aPos[3]>=nC1 .AND. aPos[3]<=nC2
			aCel	:= ::CalcCel(aPos[1],aPos[2],aPos[3])
			AADD(aRet,{aPos[2],aPos[3],aCel[1],aCel[2],aCel[3]})
		EndIf
	Next
	aSort(aRet,,,{|x,y| x[1]<y[1] .OR. (x[1]==y[1] .AND. x[2]<y[2]) })
Return aRet

Method CalcPlan(cNome As Character) Class XCalcProv
Return aScan(::aPlan,{|x| Upper(x)==Upper(cNome) })

Method CalcNomePlan(nPla As Numeric) Class XCalcProv
Return ::aPlan[nPla]

Method CalcQtdPlan() Class XCalcProv
Return Len(::aPlan)

Method CalcDim(nPla As Numeric) Class XCalcProv
	Local nL := 0 As Numeric
	Local nC := 0 As Numeric
	aEval(::aCel,{|x| If(x[1]==nPla,(nL:=Max(nL,x[2]),nC:=Max(nC,x[3])),nil) })
Return {nL,nC}

Method CalcNome(cNome As Character, nPla As Numeric) Class XCalcProv
	Local cRet := "" As Character
	::oNomes:Get(Upper(cNome),@cRet)
Return cRet

Method CalcTabela(cNome As Character) Class XCalcProv
	Local nPos := aScan(::aTabelas,{|x| Upper(x[1])==Upper(cNome) }) As Numeric
	If nPos==0
		Return nil
	EndIf
Return ::aTabelas[nPos][2]

Method CalcTabCel(nPla As Numeric, nLin As Numeric, nCol As Numeric) Class XCalcProv
	Local nCont As Numeric
	Local aTab As Array
	For nCont:=1 to Len(::aTabelas)
		aTab	:= ::aTabelas[nCont][2]
		If aTab[1]==nPla .AND. nLin>=aTab[2] .AND. nLin<=Max(aTab[4],aTab[5]) .AND. nCol>=aTab[6] .AND. nCol<aTab[6]+Len(aTab[7])
			Return ::aTabelas[nCont][1]
		EndIf
	Next
Return ""

Method CalcOculta(nPla As Numeric, nLin As Numeric) Class XCalcProv
Return aScan(::aOcultas,{|x| x[1]==nPla .AND. x[2]==nLin })>0

/*/{Protheus.doc} XCALCTST
Executa os casos de teste do motor e grava o relatório
@type user function
@author Saulo Gomes Martins
@since 25/10/2026
/*/
User Function XCALCTST()
	Local oProv := XCalcProv():New() As Object
	Local oMotor As Object
	Local aCasos As Array
	Local nCont As Numeric
	Local cLog := "" As Character
	Local nOk := 0 As Numeric
	Local nFalha := 0 As Numeric
	Local nSeg := Seconds() As Numeric
	Local cFiltro := "" As Character
	If File("\xcalc_filtro.txt")	//Filtro opcional de casos (trecho da fórmula)
		cFiltro	:= AllTrim(MemoRead("\xcalc_filtro.txt"))
	EndIf
	//Plan1 A1:A5 = 1..5 / B1:B5 = a..e
	For nCont:=1 to 5
		oProv:Set(1,nCont,1,nCont)
		oProv:Set(1,nCont,2,Chr(96+nCont))
	Next
	oProv:Set(1,1,3,.T.)
	oProv:Set(1,2,3,"")
	oProv:Set(1,3,3,"10")
	oProv:Set(1,1,4,nil,"A1*2")
	oProv:Set(1,2,4,nil,"D1+A2")
	oProv:Set(1,3,4,nil,"SUBTOTAL(9,A1:A5)")
	oProv:Set(1,1,5,nil,"SUM(D1:D3)")
	AADD(oProv:aOcultas,{1,3})
	//Dados A1:A2
	oProv:Set(2,1,1,100)
	oProv:Set(2,2,1,200)
	//Tabela Tab1 em F7:G11 (cabeçalho 7, dados 8-10, totais 11)
	oProv:Set(1,7,6,"Nome")
	oProv:Set(1,7,7,"Valor")
	oProv:Set(1,8,6,"x")
	oProv:Set(1,8,7,10)
	oProv:Set(1,9,6,"y")
	oProv:Set(1,9,7,20)
	oProv:Set(1,10,6,"x")
	oProv:Set(1,10,7,30)
	oProv:Set(1,11,7,nil,"SUBTOTAL(109,Tab1[Valor])")
	AADD(oProv:aTabelas,{"Tab1",{1,7,8,10,11,6,{"Nome","Valor"}}})
	oProv:oNomes:Set("TAXA","Plan1!$A$2")
	oProv:oNomes:Set("DOBRO","LAMBDA(x,x*2)")

	oMotor	:= custom.excel.calc.Motor():New(oProv)
	oMotor:SetLocal("en-US")
	aCasos	:= CasosTeste()
	RodaCasos(oMotor,aCasos,cFiltro,@nOk,@nFalha,@cLog)
	FwFreeArray(aCasos)
	oMotor:SetLocal("pt-BR")
	aCasos	:= CasosPtBr()
	RodaCasos(oMotor,aCasos,cFiltro,@nOk,@nFalha,@cLog)
	cLog	:= "XCALCTST: "+cValToChar(nOk)+" ok, "+cValToChar(nFalha)+" falhas, "+cValToChar(Seconds()-nSeg)+"s"+Chr(13)+Chr(10)+cLog
	MemoWrite("\xcalc_teste.log",cLog)
	ConOut(cLog)
	oMotor:Limpar()
	FreeObj(oMotor)
	FreeObj(oProv)
	FwFreeArray(aCasos)
Return 0

//Executa os casos e acumula o relatório
Static Function RodaCasos(oMotor As Object, aCasos As Array, cFiltro As Character, nOk As Numeric, nFalha As Numeric, cLog As Character)
	Local nCont As Numeric
	Local xRes As Variant
	Local lInc As Logical
	Local lPassou As Logical
	Local nLin As Numeric
	Local nCol As Numeric
	Local oErr As Object
	For nCont:=1 to Len(aCasos)
		If !Empty(cFiltro) .AND. !(Upper(cFiltro) $ Upper(aCasos[nCont][1]))
			Loop
		EndIf
		nLin	:= If(Len(aCasos[nCont])>=3,aCasos[nCont][3],1)
		nCol	:= If(Len(aCasos[nCont])>=4,aCasos[nCont][4],8)
		lInc	:= .F.
		Try
			xRes	:= oMotor:Calcular(aCasos[nCont][1],1,nLin,nCol,@lInc)
		Catch oErr
			xRes	:= "EXCEPTION: "+oErr:Description
		EndTry
		lPassou	:= Confere(xRes,aCasos[nCont][2])
		If lPassou
			nOk++
		Else
			nFalha++
			cLog	+= "FALHA ["+oMotor:cLocal+"] ["+aCasos[nCont][1]+"] esperado="+Mostra(aCasos[nCont][2])+" obtido="+Mostra(xRes)+If(lInc," (incompleto)","")+If(!Empty(oMotor:cUltErro)," erro="+oMotor:cUltErro,"")+Chr(13)+Chr(10)
		EndIf
		oMotor:cUltErro	:= ""
	Next
Return

//Compara resultado com o esperado (números com tolerância, erros pelo código)
Static Function Confere(xRes As Variant, xEsp As Variant)
	If ValType(xEsp)=="C" .AND. Left(xEsp,1)=="#" .AND. ValType(xRes)=="O"
		Return xRes:cCod==xEsp
	EndIf
	If ValType(xRes)!=ValType(xEsp)
		Return .F.
	EndIf
	If ValType(xEsp)=="N"
		Return Abs(xRes-xEsp)<=Max(Abs(xEsp),1)*0.0000000001
	EndIf
Return xRes==xEsp

Static Function Mostra(xVal As Variant)
	If ValType(xVal)=="O"
		Return "Erro("+xVal:cCod+")"
	EndIf
	If ValType(xVal)=="C"
		Return '"'+xVal+'"'
	EndIf
	If ValType(xVal)=="N"
		Return AllTrim(Transform(xVal,"999999999999999.999999999999"))
	EndIf
Return cValToChar(xVal)

/*/{Protheus.doc} CasosTeste
Casos {fórmula, esperado, [linha], [coluna]} - célula padrão Plan1!H1
/*/
Static Function CasosTeste()
	Local aRet := {} As Array
	//Operadores e precedência
	AADD(aRet,{"1+2*3",7})
	AADD(aRet,{"(1+2)*3",9})
	AADD(aRet,{"-2^2",4})
	AADD(aRet,{"2^3^2",64})
	AADD(aRet,{"10%",0.1})
	AADD(aRet,{'"a"&"b"&1',"ab1"})
	AADD(aRet,{"1/0","#DIV/0!"})
	AADD(aRet,{"1E3+1",1001})
	AADD(aRet,{"0.1+0.2",0.3})
	AADD(aRet,{'"Total: "&0.1+0.2',"Total: 0.3"})
	AADD(aRet,{'"abc"="ABC"',.T.})
	AADD(aRet,{'1<"a"',.T.})
	AADD(aRet,{"TRUE>1",.T.})
	AADD(aRet,{"=C3+1",11})
	//Agregação
	AADD(aRet,{"SUM(A1:A5)",15})
	AADD(aRet,{"SUM(A1:A5,10)",25})
	AADD(aRet,{"SUM(B1:B5)",0})
	AADD(aRet,{'SUM("3",2)',5})
	AADD(aRet,{"AVERAGE(A1:A5)",3})
	AADD(aRet,{"MAX(A1:A5)-MIN(A1:A5)",4})
	AADD(aRet,{"COUNT(A1:C5)",5})
	AADD(aRet,{"COUNTA(A1:C5)",13})
	AADD(aRet,{"COUNTBLANK(C1:C5)",3})
	AADD(aRet,{'COUNTIF(A1:A5,">2")',3})
	AADD(aRet,{'COUNTIF(B1:B5,"b*")',1})
	AADD(aRet,{'SUMIF(A1:A5,">=3")',12})
	AADD(aRet,{'SUMIF(B1:B5,"a",A1:A1)',1})
	AADD(aRet,{'SUMIFS(A1:A5,A1:A5,">1",A1:A5,"<5")',9})
	AADD(aRet,{'MAXIFS(A1:A5,B1:B5,"<>c")',5})
	AADD(aRet,{'AVERAGEIF(A1:A5,">3")',4.5})
	AADD(aRet,{"PRODUCT(A1:A4)",24})
	AADD(aRet,{"SUMPRODUCT(A1:A3,A1:A3)",14})
	AADD(aRet,{"SUM(A1:A3*2)",12})
	AADD(aRet,{"SUM({1,2;3,4})",10})
	AADD(aRet,{"SUM(1:1)",24})
	AADD(aRet,{"SUM(A:A)",15})
	AADD(aRet,{"SUM(A1:B2 A2:B3)",2})
	AADD(aRet,{"SUM((A1:A2,A4:A5))",12})
	//Dependências e SUBTOTAL
	AADD(aRet,{"D2",4})
	AADD(aRet,{"E1",21})
	AADD(aRet,{"SUBTOTAL(109,A1:A5)",12})
	AADD(aRet,{"SUBTOTAL(9,A1:A5)",15})
	AADD(aRet,{"SUBTOTAL(9,D1:D3)",6})
	AADD(aRet,{"AGGREGATE(9,5,A1:A5)",12})
	AADD(aRet,{"AGGREGATE(14,6,A1:A5,2)",4})
	//Estatística
	AADD(aRet,{"STDEV(A1:A5)",1.58113883008419})
	AADD(aRet,{"VAR.P(A1:A5)",2})
	AADD(aRet,{"MEDIAN(A1:A4)",2.5})
	AADD(aRet,{"LARGE(A1:A5,2)",4})
	AADD(aRet,{"PERCENTILE(A1:A5,0.3)",2.2})
	AADD(aRet,{"QUARTILE(A1:A5,1)",2})
	AADD(aRet,{"MODE({1,2,2,3})",2})
	//Lógicas e informação
	AADD(aRet,{'IF(A1>0,"pos","neg")',"pos"})
	AADD(aRet,{"IF(A1>5,1)",.F.})
	AADD(aRet,{'IFERROR(1/0,"x")',"x"})
	AADD(aRet,{"IFNA(NA(),5)",5})
	AADD(aRet,{"AND(TRUE,A1>0)",.T.})
	AADD(aRet,{"OR(FALSE,A1>10)",.F.})
	AADD(aRet,{"XOR(TRUE,TRUE)",.F.})
	AADD(aRet,{'SWITCH(2,1,"um",2,"dois","outro")',"dois"})
	AADD(aRet,{"IFS(A1>5,1,A1>0,2)",2})
	AADD(aRet,{"ISBLANK(C5)",.T.})
	AADD(aRet,{"ISNUMBER(C3)",.F.})
	AADD(aRet,{"ISERROR(A1/0)",.T.})
	AADD(aRet,{"T(B1)","a"})
	AADD(aRet,{"N(C1)",1})
	AADD(aRet,{'IF({1,0},"s","n")',"s"})
	AADD(aRet,{"LET(x,2,y,3,x*y)",6})
	AADD(aRet,{"LAMBDA(x,x+1)(5)",6})
	AADD(aRet,{"Dobro(4)",8})
	//Matemática
	AADD(aRet,{"ROUND(2.675,2)",2.68})
	AADD(aRet,{"ROUND(-1.5,0)",-2})
	AADD(aRet,{"ROUND(1234.5,-2)",1200})
	AADD(aRet,{"ROUNDDOWN(-1.59,1)",-1.5})
	AADD(aRet,{"ROUNDUP(1.21,1)",1.3})
	AADD(aRet,{"MOD(-3,2)",1})
	AADD(aRet,{"INT(-1.5)",-2})
	AADD(aRet,{"SQRT(-1)","#NUM!"})
	AADD(aRet,{"ROUND(A1:A3/3,1)",0.3})
