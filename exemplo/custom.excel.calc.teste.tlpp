	AADD(aRet,{'SEARCH("c?e","abcdef")',3})
	AADD(aRet,{'CHAR(65)',"A"})
	AADD(aRet,{'CODE("A")',65})
	AADD(aRet,{'UNICODE("€")',8364})
	AADD(aRet,{'UNICHAR(8364)',"€"})
	AADD(aRet,{'VALUE("1,234.5")',1234.5})
	AADD(aRet,{'VALUE("12%")',0.12})
	AADD(aRet,{'VALUE("($5)")',-5})
	AADD(aRet,{'VALUE("12/31/2024")',45657})
	AADD(aRet,{'NUMBERVALUE("1.234,5",",",".")',1234.5})
